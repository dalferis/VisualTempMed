<EVENT eid="e75" class="OCCURRENCE" comment="e3c:permanence=FINITE">Zefuroxima</EVENT> 1,5g <EVENT eid="e76" class="OCCURRENCE" comment="e3c:permanence=FINITE">interbentzioaren</EVENT> aurretik eta <TIMEX3 tid="t3" type="TIME" value="XXXX-XX-XX" temporalFunction="true">handik</TIMEX3> <TIMEX3 tid="t4" type="DURATION" value="PT3H" temporalFunction="false">3 ordura</TIMEX3>, <EVENT eid="e77" class="OCCURRENCE" comment="e3c:permanence=FINITE">ebakuntzan</EVENT> zehar&#13;
