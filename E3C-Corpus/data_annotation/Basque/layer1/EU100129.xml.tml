<?xml version="1.0" encoding="UTF-8"?>
<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2014-01-27T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2014-01-27</TIMEX3>
  <TEXT><EVENT eid="e1" class="OCCURRENCE">KONTSULTARAKO</EVENT> ARRAZOIA&#13;
48 urteko gizonezkoa, <EVENT eid="e2" class="OCCURRENCE">disnea</EVENT> basala <EVENT eid="e3" class="OCCURRENCE">areagotu</EVENT> zaiolako <EVENT eid="e4" class="OCCURRENCE">bertaratu</EVENT> dena.&#13;
&#13;
&#13;
<EVENT eid="e5" class="OCCURRENCE">AURREKARI</EVENT> PERTSONALAK&#13;
- Medikamentuekiko <EVENT eid="e6" class="OCCURRENCE">alergia</EVENT> ezagunik ez.&#13;
- <EVENT eid="e7" class="OCCURRENCE">Erretzailea</EVENT>: <TIMEX3 tid="t1" type="DURATION" value="P1Y" temporalFunction="false">urtean</TIMEX3>, 30 <EVENT eid="e8" class="OCCURRENCE">pakete</EVENT> eta <EVENT eid="e9" class="OCCURRENCE">porruren</EVENT> bat. &#13;
<EVENT eid="e10" class="OCCURRENCE">ADVP</EVENT> ohia.&#13;
- <EVENT eid="e11" class="OCCURRENCE">GIB</EVENT> C3&#13;
- <EVENT eid="e12" class="STATE">Hepatopatia</EVENT> kronikoa C hepatitisaren birusagatik <EVENT eid="e13" class="OCCURRENCE">deskonpentsaziorik</EVENT> gabe.&#13;
- <EVENT eid="e14" class="OCCURRENCE">Pneumonia-diagnostikoa</EVENT> <TIMEX3 tid="t2" type="DATE" value="1992" temporalFunction="false">1992an</TIMEX3> eta <TIMEX3 tid="t3" type="DATE" value="1998" temporalFunction="false">1998an</TIMEX3>.&#13;
- <EVENT eid="e15" class="OCCURRENCE">Miositis</EVENT> polimikrobianoa eta, ondorioz, <EVENT eid="e16" class="OCCURRENCE">drainatze</EVENT> kirurgikoak (<TIMEX3 tid="t4" type="DATE" value="2002" temporalFunction="false">2002</TIMEX3>).&#13;
- <EVENT eid="e17" class="OCCURRENCE">TBK</EVENT> barreiatua, ondoren etxeko <EVENT eid="e18" class="OCCURRENCE">ospitalizazioaren</EVENT> bidez <EVENT eid="e19" class="OCCURRENCE">kontrolatua</EVENT> (<TIMEX3 tid="t5" type="DATE" value="2006" temporalFunction="false">2006</TIMEX3>).&#13;
- Azken <EVENT eid="e20" class="OCCURRENCE">ingresua</EVENT>, infekziosoen zerbitzuan, <TIMEX3 tid="t6" type="DATE" value="2012-05" temporalFunction="false">2012ko maiatzean</TIMEX3> <EVENT eid="e21" class="OCCURRENCE">alta</EVENT> emanda; <EVENT eid="e22" class="OCCURRENCE">diagnostikoa</EVENT>: beheko arnas traktuaren <EVENT eid="e23" class="OCCURRENCE">infekzioa</EVENT> + <EVENT eid="e24" class="OCCURRENCE">bronkiektasiak</EVENT> <EVENT eid="e25" class="OCCURRENCE">gain-infekzioarekin</EVENT>.&#13;
- <EVENT eid="e26" class="OCCURRENCE">Azken</EVENT> analitika <TIMEX3 tid="t7" type="DATE" value="2013-09" temporalFunction="false">2013ko irailean</TIMEX3>: <EVENT eid="e27" class="OCCURRENCE">CD4</EVENT> 490, <EVENT eid="e28" class="OCCURRENCE">CD8</EVENT> 3887, <EVENT eid="e29" class="OCCURRENCE">T4</EVENT>/T8 0.1, <EVENT eid="e30" class="OCCURRENCE">GIB</EVENT> detektatezina, <EVENT eid="e31" class="OCCURRENCE">GIB</EVENT> 33 kopia/ml&#13;
- Ohiko <EVENT eid="e32" class="OCCURRENCE">tratamendua</EVENT>: <EVENT eid="e33" class="OCCURRENCE">Omeprazol</EVENT> 20 mg 1-0-1, <EVENT eid="e34" class="OCCURRENCE">Tranxilium</EVENT> 50 mg 1-1-1, <EVENT eid="e35" class="OCCURRENCE">Prezista</EVENT> 400 mg 0-0-2, <EVENT eid="e36" class="OCCURRENCE">Norvir</EVENT> 0-0-1, <EVENT eid="e37" class="OCCURRENCE">Truvada</EVENT> 0-0-1, <EVENT eid="e38" class="OCCURRENCE">Septrin</EVENT> 0-0-1, <EVENT eid="e39" class="OCCURRENCE">Rexer</EVENT> 30 mg 0-0-1.&#13;
&#13;
&#13;
<TIMEX3 tid="t8" type="DATE" value="PRESENT_REF" temporalFunction="true">GAUR EGUNEKO</TIMEX3> <EVENT eid="e40" class="OCCURRENCE">GAIXOTASUNA</EVENT>&#13;
Pazientea <EVENT eid="e41" class="OCCURRENCE">bertaratzeko</EVENT> arrazoiak: <TIMEX3 tid="t9" type="DURATION" value="P2W" temporalFunction="false">2 asteko</TIMEX3> eboluzioko <EVENT eid="e42" class="OCCURRENCE">eztula</EVENT> eta <EVENT eid="e43" class="OCCURRENCE">espektorazio</EVENT> zornetsua; eta, <TIMEX3 tid="t10" type="DURATION" value="P4D" temporalFunction="false">duela 4 egunetatik</TIMEX3>, <EVENT eid="e44" class="OCCURRENCE">disnea</EVENT> basala <EVENT eid="e45" class="OCCURRENCE">areagotu</EVENT> eta <EVENT eid="e46" class="OCCURRENCE">ahalegin</EVENT> minimoengatik ere gertatzen zaio. <EVENT eid="e47" class="OCCURRENCE">Sukarrik</EVENT> ez. &#13;
<EVENT eid="e48" class="OCCURRENCE">Pisu-galerarik</EVENT> ez. &#13;
<EVENT eid="e49" class="OCCURRENCE">Asteniarik</EVENT> ez. &#13;
Toraxeko <EVENT eid="e50" class="OCCURRENCE">minik</EVENT> ez (ez <EVENT eid="e51" class="OCCURRENCE">pleuristikoa</EVENT> ez <EVENT eid="e52" class="OCCURRENCE">opresiboa</EVENT>).&#13;
Horrez gain, gerriondoko eskuineko <EVENT eid="e53" class="OCCURRENCE">mina</EVENT> <EVENT eid="e54" class="REPORTING">aipatzen</EVENT> du, <TIMEX3 tid="t11" type="DURATION" value="P3W" temporalFunction="false">3 asteko</TIMEX3> eboluzioko <EVENT eid="e55" class="OCCURRENCE">ziatalgiarekin</EVENT>, jarritako <EVENT eid="e56" class="OCCURRENCE">analgesiaz</EVENT> <EVENT eid="e57" class="OCCURRENCE">hobera</EVENT> egiten ez duena.&#13;
&#13;
&#13;
<EVENT eid="e58" class="OCCURRENCE">MIAKETA</EVENT> FISIKOA&#13;
<EVENT eid="e59" class="OCCURRENCE">TA</EVENT>: 96/55 <EVENT eid="e60" class="OCCURRENCE">BM</EVENT>: 92lpm <EVENT eid="e61" class="OCCURRENCE">Tª</EVENT>: 36,4ºC <EVENT eid="e62" class="OCCURRENCE">SatO2</EVENT> basala %88&#13;
<EVENT eid="e63" class="OCCURRENCE">Kontziente</EVENT> eta <EVENT eid="e64" class="OCCURRENCE">orientatuta</EVENT> hiru esferetan. &#13;
<EVENT eid="e65" class="OCCURRENCE">Normokoloratuta</EVENT> eta <EVENT eid="e66" class="OCCURRENCE">normohidratatuta</EVENT>. &#13;
<EVENT eid="e67" class="OCCURRENCE">Takipneikoa</EVENT>, 20 rpm.&#13;
<EVENT eid="e68" class="OCCURRENCE">BetaS</EVENT>: <EVENT eid="e69" class="OCCURRENCE">Ingurgitazio</EVENT> jugularrik ez. &#13;
<EVENT eid="e70" class="OCCURRENCE">Adenopatia</EVENT> ukigarririk ez. &#13;
Ez <EVENT eid="e71" class="OCCURRENCE">garondo-zurruntasunik</EVENT> ez bestelako <EVENT eid="e72" class="OCCURRENCE">zeinu</EVENT> meningeorik.&#13;
&#13;
Toraxa: <EVENT eid="e73" class="OCCURRENCE">BJ</EVENT>: <EVENT eid="e74" class="OCCURRENCE">erritmikoa</EVENT>, <EVENT eid="e75" class="OCCURRENCE">murmurio</EVENT> eta <EVENT eid="e76" class="OCCURRENCE">estratonu</EVENT> entzungarririk gabe. &#13;
<EVENT eid="e77" class="OCCURRENCE">AP</EVENT>: <EVENT eid="e78" class="OCCURRENCE">Auskultatzean</EVENT>, <EVENT eid="e79" class="OCCURRENCE">roncus</EVENT> barreiatuak, AM <EVENT eid="e80" class="OCCURRENCE">apaltzea</EVENT> eta <EVENT eid="e81" class="OCCURRENCE">bibrazioak</EVENT> ezkerreko oinarrian. &#13;
<EVENT eid="e82" class="OCCURRENCE">Haztatzean</EVENT> eta <EVENT eid="e83" class="OCCURRENCE">kolpekatzean</EVENT>, <EVENT eid="e84" class="OCCURRENCE">matetasuna</EVENT> eta <EVENT eid="e85" class="OCCURRENCE">bibrazio-murrizketa</EVENT> ezkerreko oinarrian.&#13;
Abdomena: <EVENT eid="e86" class="OCCURRENCE">Biguna</EVENT> eta <EVENT eid="e87" class="OCCURRENCE">deprimigarria</EVENT>. &#13;
<EVENT eid="e88" class="OCCURRENCE">Haztatzean</EVENT>, ez <EVENT eid="e89" class="OCCURRENCE">minik</EVENT> ez peritoneoko <EVENT eid="e90" class="OCCURRENCE">narritaduraren</EVENT> <EVENT eid="e91" class="REPORTING">zeinurik</EVENT>. &#13;
Ez <EVENT eid="e92" class="OCCURRENCE">masarik</EVENT> ez <EVENT eid="e93" class="OCCURRENCE">erraimegaliarik</EVENT>. &#13;
<EVENT eid="e94" class="OCCURRENCE">Hotsak</EVENT>. &#13;
<EVENT eid="e95" class="OCCURRENCE">PPRB</EVENT> (Giltzurrunaren alde bietako <EVENT eid="e96" class="OCCURRENCE">ukabil-perkusioa</EVENT>): <EVENT eid="e97" class="OCCURRENCE">minik</EVENT> ez.&#13;
EEII (beheko gorputzadarrak): ez <EVENT eid="e98" class="OCCURRENCE">edemarik</EVENT> ez <EVENT eid="e99" class="OCCURRENCE">TBSik</EVENT>. &#13;
<EVENT eid="e100" class="OCCURRENCE">Minik</EVENT> ez gerri-apofisi zorrotzak <EVENT eid="e101" class="OCCURRENCE">haztatzean</EVENT>. &#13;
<EVENT eid="e102" class="OCCURRENCE">Mina</EVENT> eskuineko pala iliakoa eta eskuineko ipurmasaila <EVENT eid="e103" class="OCCURRENCE">haztatzean</EVENT>. &#13;
Aldakaren <EVENT eid="e104" class="OCCURRENCE">mugikortasun</EVENT> normala. &#13;
<EVENT eid="e105" class="OCCURRENCE">Lassegue</EVENT> +30ºC. &#13;
Mantentzen du <EVENT eid="e106" class="OCCURRENCE">indarra</EVENT> eta <EVENT eid="e107" class="OCCURRENCE">sentsibilitatea</EVENT>. &#13;
<EVENT eid="e108" class="OCCURRENCE">Hiperreflexia</EVENT> rotulianoa eta akileoaren <EVENT eid="e109" class="OCCURRENCE">abolizioa</EVENT>.&#13;
&#13;
<EVENT eid="e110" class="OCCURRENCE">MIAKETA</EVENT> OSAGARRIA&#13;
- <EVENT eid="e111" class="OCCURRENCE">Analitika</EVENT>:&#13;
&#13;
<EVENT eid="e112" class="OCCURRENCE">Gasometria</EVENT> arteriala: <EVENT eid="e113" class="OCCURRENCE">pH</EVENT> 7,43; <EVENT eid="e114" class="OCCURRENCE">PCO2</EVENT> 31mmHg; <EVENT eid="e115" class="OCCURRENCE">PO2</EVENT> 52 mmHgHCO2 20,6mmHg; <EVENT eid="e116" class="OCCURRENCE">SatO2</EVENT> %87; <EVENT eid="e117" class="OCCURRENCE">FiO2</EVENT> ezezaguna.&#13;
<EVENT eid="e118" class="OCCURRENCE">Biokimika</EVENT>: <EVENT eid="e119" class="OCCURRENCE">Urea</EVENT> 105 mg/dL; <EVENT eid="e120" class="OCCURRENCE">kreatinina</EVENT> 1,74 mg/dL; <EVENT eid="e121" class="OCCURRENCE">CK</EVENT> 214 U/L; <EVENT eid="e122" class="OCCURRENCE">LDH</EVENT> 484 U/L; <EVENT eid="e123" class="OCCURRENCE">PCR</EVENT> 6,69 mg/dL. &#13;
<EVENT eid="e124" class="OCCURRENCE">Ioiak</EVENT> eta <EVENT eid="e125" class="OCCURRENCE">perfil</EVENT> hepatikoa balio normalen barruan.&#13;
<EVENT eid="e126" class="OCCURRENCE">Hemograma</EVENT>: <EVENT eid="e127" class="OCCURRENCE">Hb</EVENT> 13,7g/dL; <EVENT eid="e128" class="OCCURRENCE">leukozitoak</EVENT> 8500 <EVENT eid="e129" class="OCCURRENCE">formula</EVENT> leukozitarioa balio normalen barruan; <EVENT eid="e130" class="OCCURRENCE">plaketak</EVENT> 189.000.&#13;
<EVENT eid="e131" class="OCCURRENCE">Koagulazioa</EVENT>: <EVENT eid="e132" class="OCCURRENCE">INR</EVENT> 1,01; <EVENT eid="e133" class="OCCURRENCE">IP</EVENT> %98; <EVENT eid="e134" class="OCCURRENCE">TTPA</EVENT> 31seg; <EVENT eid="e135" class="OCCURRENCE">Fibrinogeno</EVENT> funtzionala 755mg/dL.&#13;
&#13;
- Toraxeko X <EVENT eid="e136" class="OCCURRENCE">Izpiak</EVENT>: <EVENT eid="e137" class="OCCURRENCE">Opakotasun</EVENT> trinkoa ezkerreko oinarrian, dagokion hemidiafragma eta saihets-hezurren <EVENT eid="e138" class="OCCURRENCE">ezabatzearekin</EVENT>, ezkerreko <EVENT eid="e139" class="OCCURRENCE">pleura-isuriarekin</EVENT> bat etor daitekeena.&#13;
&#13;
<EVENT eid="e140" class="OCCURRENCE">IRITZI</EVENT> DIAGNOSTIKOA&#13;
<EVENT eid="e141" class="OCCURRENCE">AZTERTU</EVENT> BEHARREKO EZKERRALDEKO <EVENT eid="e142" class="OCCURRENCE">PLEURA-ISURIA</EVENT>&#13;
</TEXT>
