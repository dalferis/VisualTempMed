<?xml version="1.0" encoding="UTF-8"?>
<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2008-10-03T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2008-10-03</TIMEX3>
  <TEXT>65 urteko gizonezkoa <TIMEX3 tid="t1" type="DATE" value="2008-02-27" temporalFunction="false">2008ko otsailaren 27an</TIMEX3> kirurgia orokorreko zerbitzuan <EVENT eid="e1" class="OCCURRENCE">ingresatu</EVENT> da <EVENT eid="e2" class="OCCURRENCE">oinarri</EVENT> zefalikoa duen <EVENT eid="e3" class="OCCURRENCE">pankreatitis</EVENT> akutu edematosoa diagnosiarekin. Bere <EVENT eid="e4" class="OCCURRENCE">aurrekari</EVENT> pertsonal bakarra <EVENT eid="e5" class="OCCURRENCE">HTA</EVENT> da. <TIMEX3 tid="t2" type="DATE" value="2008-02-29" temporalFunction="false">Otsailaren 29an</TIMEX3>, <EVENT eid="e6" class="OCCURRENCE">nutrizio</EVENT> parenteralarekin <EVENT eid="e7" class="ASPECTUAL">hasteko</EVENT> eskuineko besoan Drum motako bide zentrala <EVENT eid="e8" class="OCCURRENCE">kanalizatzen</EVENT> da. Toraxeko <EVENT eid="e9" class="OCCURRENCE">erradiografia</EVENT> egin ostean, <EVENT eid="e10" class="OCCURRENCE">nutrizioarekin</EVENT> <EVENT eid="e11" class="ASPECTUAL">hasten</EVENT> da. <TIMEX3 tid="t3" type="DATE" value="2008-03-03" temporalFunction="false">Martxoaren 3an</TIMEX3>, <EVENT eid="e12" class="OCCURRENCE">txertatutako</EVENT> gunean <EVENT eid="e13" class="OCCURRENCE">flebitisa</EVENT> duela <EVENT eid="e14" class="REPORTING">ohartzen</EVENT> da erizaina. Berehala kateterra <EVENT eid="e15" class="OCCURRENCE">kendu</EVENT> eta punta <EVENT eid="e16" class="OCCURRENCE">kultibatzera</EVENT> <EVENT eid="e17" class="OCCURRENCE">bidaltzen</EVENT> da. <TIMEX3 tid="t4" type="DURATION" value="PTXH" temporalFunction="true">Hurrengo orduetan</TIMEX3> besoak <EVENT eid="e18" class="OCCURRENCE">okerrera</EVENT> egiten du, <EVENT eid="e19" class="OCCURRENCE">flebitisa</EVENT> <EVENT eid="e20" class="OCCURRENCE">zelulitis</EVENT> <EVENT eid="e21" class="OCCURRENCE">bilakatuz</EVENT>. <TIMEX3 tid="t5" type="DATE" value="2008-03-07" temporalFunction="false">Martxoaren 7an</TIMEX3> bere <EVENT eid="e22" class="OCCURRENCE">egoera</EVENT> orokorra <EVENT eid="e23" class="OCCURRENCE">okerrera</EVENT> doa eta kontzientzia <EVENT eid="e24" class="OCCURRENCE">mailaren</EVENT> <EVENT eid="e25" class="OCCURRENCE">depresioa</EVENT> du. Sabeleko <EVENT eid="e26" class="OCCURRENCE">OTA</EVENT> eta besoko <EVENT eid="e27" class="OCCURRENCE">ekografia</EVENT> egin eta ebakuntza gelara <EVENT eid="e28" class="OCCURRENCE">eramaten</EVENT> dute eskuin besoko <EVENT eid="e29" class="OCCURRENCE">zelulitisa</EVENT> <EVENT eid="e30" class="OCCURRENCE">drainatzeko</EVENT>. Ondoren, ZIUra <EVENT eid="e31" class="OCCURRENCE">bideratzen</EVENT> da <EVENT eid="e32" class="OCCURRENCE">sepsia</EVENT> duelako, <EVENT eid="e33" class="OCCURRENCE">intubazio</EVENT> orotrakeala, <EVENT eid="e34" class="OCCURRENCE">sedazioa</EVENT>, <EVENT eid="e35" class="OCCURRENCE">inotropo</EVENT> eta <EVENT eid="e36" class="OCCURRENCE">antibiotikoekin</EVENT>. Bertan, egindako <EVENT eid="e37" class="OCCURRENCE">kultiboen</EVENT> emaitzak positiboak dira S. aureus-arentzat. <EVENT eid="e38" class="OCCURRENCE">Eboluzioa</EVENT> <EVENT eid="e39" class="OCCURRENCE">ona</EVENT> da eta <TIMEX3 tid="t6" type="DATE" value="2008-03-14" temporalFunction="false">martxoaren 14an</TIMEX3> infekziosoen unitatera <EVENT eid="e40" class="OCCURRENCE">lekualdatzen</EVENT> da. <TIMEX3 tid="t7" type="DATE" value="2008-04-02" temporalFunction="false">Apirilaren 2an</TIMEX3>, berriz ere ebakuntza gelara <EVENT eid="e41" class="OCCURRENCE">itzultzen</EVENT> da, ertzen <EVENT eid="e42" class="OCCURRENCE">garbiketa</EVENT> eta granulazio ehunen <EVENT eid="e43" class="OCCURRENCE">erauzketa</EVENT> egitera. <TIMEX3 tid="t8" type="DURATION" value="PXD" temporalFunction="true">Ondorengo egunetan</TIMEX3> <EVENT eid="e44" class="OCCURRENCE">konplikazio</EVENT> batzuk izaten ditu, hala nola, <EVENT eid="e45" class="OCCURRENCE">odoljarioa</EVENT>. <TIMEX3 tid="t9" type="DATE" value="2008-04-25" temporalFunction="false">Apirilaren 25ean</TIMEX3> ospitaleko <EVENT eid="e46" class="OCCURRENCE">alta</EVENT> jasotzen du eta ondorengo <EVENT eid="e47" class="OCCURRENCE">sendaketak</EVENT> osasun-zentrora <EVENT eid="e48" class="OCCURRENCE">bideratzen</EVENT> dira.</TEXT>
