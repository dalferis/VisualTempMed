<?xml version="1.0" encoding="UTF-8"?>
<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2019-05-31T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2019-05-31</TIMEX3>
  <TEXT><EVENT eid="e1" class="OCCURRENCE" comment="e3c:permanence=FINITE">AURREKARI</EVENT> PERTSONALAK:&#13;
-<EVENT eid="e2" class="OCCURRENCE" comment="e3c:permanence=FINITE">Alergia</EVENT> ezagunik ez.&#13;
-<EVENT eid="e3" class="OCCURRENCE" comment="e3c:permanence=FINITE">Erretzailea</EVENT> (10 zigarro/egun)&#13;
-<EVENT eid="e4" class="OCCURRENCE" comment="e3c:permanence=FINITE">Hiperkolesterolemia</EVENT>&#13;
-Behçet <EVENT eid="e5" class="STATE" comment="e3c:permanence=PERMANENT">sindromea</EVENT> (<TIMEX3 tid="t1" type="DATE" value="2001" temporalFunction="false">2001</TIMEX3>). &#13;
<EVENT eid="e6" class="STATE" comment="e3c:permanence=PERMANENT">Neurobehçet</EVENT> (<TIMEX3 tid="t2" type="DATE" value="2002" temporalFunction="false">2002</TIMEX3>) eta <EVENT eid="e7" class="OCCURRENCE" comment="e3c:permanence=FINITE">ubeitisa</EVENT> ere baditu. &#13;
<EVENT eid="e8" class="OCCURRENCE" comment="e3c:permanence=FINITE">Neurobehçet-a</EVENT> irudi bidez <EVENT eid="e9" class="OCCURRENCE" comment="e3c:permanence=FINITE">diagnostikatu</EVENT> zen eta <TIMEX3 tid="t3" type="DATE" value="PRESENT_REF" temporalFunction="true">egunerarte</TIMEX3> ez du inolako <EVENT eid="e10" class="OCCURRENCE" comment="e3c:permanence=FINITE">sintomatologiarik</EVENT> azaldu.&#13;
-Ohiko <EVENT eid="e11" class="OCCURRENCE" comment="e3c:permanence=FINITE">tratamendua</EVENT>: <EVENT eid="e12" class="OCCURRENCE" comment="e3c:permanence=FINITE">errosubastatina</EVENT> 20 mg, adiro 100mg, <EVENT eid="e13" class="OCCURRENCE" comment="e3c:permanence=FINITE">azatioprina</EVENT> 50 mg, <EVENT eid="e14" class="OCCURRENCE" comment="e3c:permanence=FINITE">golimumab</EVENT> 50 mg/hilean.&#13;
&#13;
<TIMEX3 tid="t4" type="DATE" value="PRESENT_REF" temporalFunction="true">EGUNGO</TIMEX3> <EVENT eid="e15" class="OCCURRENCE" comment="e3c:permanence=FINITE">GAIXOTASUNA</EVENT>&#13;
54 urteko emakumezkoa. &#13;
<TIMEX3 tid="t5" type="DURATION" value="P3D" temporalFunction="false">Azken 3 egunetan</TIMEX3> amnesia <EVENT eid="e16" class="OCCURRENCE" comment="e3c:permanence=FINITE">gertaera</EVENT> gorabeheratsuak izan ditu eta bere senarrak <EVENT eid="e17" class="OCCURRENCE" comment="e3c:permanence=FINITE">esaldi</EVENT> desberdinak behin eta berriz <EVENT eid="e18" class="OCCURRENCE" comment="e3c:permanence=FINITE">errepikatzen</EVENT> dituela <EVENT eid="e19" class="OCCURRENCE" comment="e3c:permanence=FINITE">dio</EVENT>. &#13;
Ez du beste <EVENT eid="e20" class="OCCURRENCE" comment="e3c:permanence=FINITE">klinika</EVENT> neurologikorik azaltzen. &#13;
Ez du <EVENT eid="e21" class="OCCURRENCE" comment="e3c:permanence=FINITE">klinika</EVENT> infekziosorik eztabeste <EVENT eid="e22" class="OCCURRENCE" comment="e3c:permanence=FINITE">klinika</EVENT> garrantzitsurik ere.&#13;
&#13;
<EVENT eid="e23" class="OCCURRENCE" comment="e3c:permanence=FINITE">ARAKETA</EVENT> FISIKOA&#13;
<EVENT eid="e24" class="OCCURRENCE" comment="e3c:permanence=FINITE">TA</EVENT> 180/100 mmHg; <EVENT eid="e25" class="OCCURRENCE" comment="e3c:permanence=FINITE">BM</EVENT> 92; <EVENT eid="e26" class="OCCURRENCE" comment="e3c:permanence=FINITE">Tª</EVENT> 36.8ºC&#13;
* <EVENT eid="e27" class="OCCURRENCE" comment="e3c:permanence=FINITE">Miaketa</EVENT> orokorra: normala&#13;
*<EVENT eid="e28" class="OCCURRENCE" comment="e3c:permanence=FINITE">Miaketa</EVENT> neurologikoa: <EVENT eid="e29" class="OCCURRENCE" comment="e3c:permanence=FINITE">kontziente</EVENT> eta <EVENT eid="e30" class="OCCURRENCE" comment="e3c:permanence=FINITE">orientatuta</EVENT>. &#13;
<EVENT eid="e31" class="OCCURRENCE" comment="e3c:permanence=FINITE">Atentzioa</EVENT> mantentzen du. Ondo <EVENT eid="e32" class="OCCURRENCE" comment="e3c:permanence=FINITE">errepikatzen</EVENT> eta <EVENT eid="e33" class="OCCURRENCE" comment="e3c:permanence=FINITE">izendatzen</EVENT> du eta <EVENT eid="e34" class="OCCURRENCE" comment="e3c:permanence=FINITE">agindu</EVENT> konplexuak ondo <EVENT eid="e35" class="OCCURRENCE" comment="e3c:permanence=FINITE">betetzen</EVENT> ditu. &#13;
Hitz <EVENT eid="e36" class="OCCURRENCE" comment="e3c:permanence=FINITE">fluentzia</EVENT> kaltetuta (10 <EVENT eid="e37" class="OCCURRENCE" comment="e3c:permanence=FINITE">hitz</EVENT> <TIMEX3 tid="t6" type="DURATION" value="PT1M" temporalFunction="false">minutu batean</TIMEX3>). &#13;
<EVENT eid="e38" class="OCCURRENCE" comment="e3c:permanence=FINITE">Anamnesiaren</EVENT> <TIMEX3 tid="t7" type="TIME" value="2019-05-31" temporalFunction="false">momenturen batean</TIMEX3> <EVENT eid="e39" class="OCCURRENCE" comment="e3c:permanence=FINITE">hizketaren</EVENT> haria <EVENT eid="e40" class="OCCURRENCE" comment="e3c:permanence=FINITE">galtzen</EVENT> du. &#13;
<EVENT eid="e41" class="OCCURRENCE" comment="e3c:permanence=FINITE">Amnesia</EVENT> anterogradoa ondo <EVENT eid="e42" class="ASPECTUAL" comment="e3c:permanence=FINITE">mantentzen</EVENT> du. &#13;
<EVENT eid="e43" class="OCCURRENCE" comment="e3c:permanence=FINITE">Pentagonoa</EVENT> ondo. &#13;
<EVENT eid="e44" class="OCCURRENCE" comment="e3c:permanence=FINITE">Erlojua</EVENT> 7/10. &#13;
<EVENT eid="e45" class="OCCURRENCE" comment="e3c:permanence=FINITE">Afektu</EVENT> desegokia (<EVENT eid="e46" class="OCCURRENCE" comment="e3c:permanence=FINITE">arrazoi</EVENT> gabeko <EVENT eid="e47" class="OCCURRENCE" comment="e3c:permanence=FINITE">irribarrea</EVENT>). &#13;
Ez du <EVENT eid="e48" class="OCCURRENCE" comment="e3c:permanence=FINITE">nahaste</EVENT> konduktual edo esfera psikotikoko <EVENT eid="e49" class="OCCURRENCE" comment="e3c:permanence=FINITE">aldaketarik</EVENT> azaltzen. &#13;
Pupila egokiak. &#13;
<EVENT eid="e50" class="OCCURRENCE" comment="e3c:permanence=FINITE">Kanpimetria</EVENT> egokia. &#13;
<EVENT eid="e51" class="OCCURRENCE" comment="e3c:permanence=FINITE">Pare</EVENT> kranealak ondo. &#13;
<EVENT eid="e52" class="OCCURRENCE" comment="e3c:permanence=FINITE">Asimetriarik</EVENT> ez. &#13;
Indar eta sentsibilitate <EVENT eid="e53" class="OCCURRENCE" comment="e3c:permanence=FINITE">aldaketarik</EVENT> ez. &#13;
Azal-oin zolako flexiozko <EVENT eid="e54" class="OCCURRENCE" comment="e3c:permanence=FINITE">erreflexua</EVENT>. &#13;
<EVENT eid="e55" class="OCCURRENCE" comment="e3c:permanence=FINITE">Erreflexu</EVENT> muskularrak ondo. &#13;
Koordinazio <EVENT eid="e56" class="OCCURRENCE" comment="e3c:permanence=FINITE">arazorik</EVENT> ez. &#13;
<EVENT eid="e57" class="OCCURRENCE" comment="e3c:permanence=FINITE">Martxa</EVENT> egokia.&#13;
&#13;
<EVENT eid="e58" class="OCCURRENCE" comment="e3c:permanence=FINITE">PROBA</EVENT> OSAGARRIAK&#13;
*Odol <EVENT eid="e59" class="OCCURRENCE" comment="e3c:permanence=FINITE">analitika</EVENT>: <EVENT eid="e60" class="OCCURRENCE" comment="e3c:permanence=FINITE">aldaketa</EVENT> nabarmenik ez.&#13;
*Likido zefalorrakideoaren <EVENT eid="e61" class="OCCURRENCE" comment="e3c:permanence=FINITE">azterketa</EVENT>: <EVENT eid="e62" class="OCCURRENCE" comment="e3c:permanence=FINITE">itxura</EVENT> argikoa, <EVENT eid="e63" class="OCCURRENCE" comment="e3c:permanence=FINITE">hematie</EVENT> 0/μL, <EVENT eid="e64" class="OCCURRENCE" comment="e3c:permanence=FINITE">leukozito</EVENT> 1/μL, <EVENT eid="e65" class="OCCURRENCE" comment="e3c:permanence=FINITE">glukosa</EVENT> 95 mg/dl (50-80 mg/dl), <EVENT eid="e66" class="OCCURRENCE" comment="e3c:permanence=FINITE">proteinak</EVENT> 28 mg/dl (15-40mg/dl) eta <EVENT eid="e67" class="OCCURRENCE" comment="e3c:permanence=FINITE">ADA</EVENT> 1.8 U/L(&lt;10 U/L).&#13;
*<EVENT eid="e68" class="OCCURRENCE" comment="e3c:permanence=FINITE">Gernu-azterketa</EVENT>: <EVENT eid="e69" class="OCCURRENCE" comment="e3c:permanence=FINITE">aldaketa</EVENT> nabarmenik ez.&#13;
*Garuneko <EVENT eid="e70" class="OCCURRENCE" comment="e3c:permanence=FINITE">eskanerra</EVENT>: <EVENT eid="e71" class="OCCURRENCE" comment="e3c:permanence=FINITE">leukopatia</EVENT> <EVENT eid="e72" class="REPORTING" comment="e3c:permanence=FINITE">zeinuak</EVENT> (aldez aurretik <EVENT eid="e73" class="REPORTING" comment="e3c:permanence=FINITE">ezagunak</EVENT>). &#13;
<EVENT eid="e74" class="OCCURRENCE" comment="e3c:permanence=FINITE">Lesio</EVENT> hipodentso berri bat eskuineko barruko kapsulako aurreko besoan.&#13;
</TEXT>
