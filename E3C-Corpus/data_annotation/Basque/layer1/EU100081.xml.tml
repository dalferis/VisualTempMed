<?xml version="1.0" encoding="UTF-8"?>
<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2008-10-03T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2008-10-03</TIMEX3>
  <TEXT>25 urteko mutil bat, Larrialdietara <EVENT eid="e1" class="OCCURRENCE" comment="e3c:permanence=FINITE">etorri</EVENT> zen sabeleko <EVENT eid="e2" class="OCCURRENCE" comment="e3c:permanence=FINITE">minez</EVENT>, <EVENT eid="e3" class="OCCURRENCE" comment="e3c:permanence=FINITE">botaka</EVENT> eta 39ºC-ko <EVENT eid="e4" class="OCCURRENCE" comment="e3c:permanence=FINITE">sukarrarekin</EVENT>. Giltzurrunetako <EVENT eid="e5" class="OCCURRENCE" comment="e3c:permanence=FINITE">mina</EVENT> zela <EVENT eid="e6" class="OCCURRENCE" comment="e3c:permanence=FINITE">pentsatuz</EVENT>, <EVENT eid="e7" class="OCCURRENCE" comment="e3c:permanence=FINITE">alta</EVENT> eman zitzaion. Hala ere, <TIMEX3 tid="t1" type="DURATION" value="PTXH" temporalFunction="true">ordu gutxitan</TIMEX3> berriro <EVENT eid="e8" class="OCCURRENCE" comment="e3c:permanence=FINITE">bueltatu</EVENT> zen larrialdietara, sabeleko <EVENT eid="e9" class="OCCURRENCE" comment="e3c:permanence=FINITE">min</EVENT> berdinarekin, batez ere eskumako hobi iliakoan. <EVENT eid="e10" class="OCCURRENCE" comment="e3c:permanence=FINITE">Analitika</EVENT>, <EVENT eid="e11" class="OCCURRENCE" comment="e3c:permanence=FINITE">ikusketa</EVENT> eta <EVENT eid="e12" class="OCCURRENCE" comment="e3c:permanence=FINITE">erradiologiak</EVENT> lagunduta, <EVENT eid="e13" class="OCCURRENCE" comment="e3c:permanence=FINITE">laparoskopia</EVENT> bidez zer zeukan <EVENT eid="e14" class="REPORTING" comment="e3c:permanence=FINITE">ikustea</EVENT> <EVENT eid="e15" class="OCCURRENCE" comment="e3c:permanence=FINITE">erabaki</EVENT> zen eta <EVENT eid="e16" class="OCCURRENCE" comment="e3c:permanence=FINITE">apendizitis</EVENT> akutua (<EVENT eid="e17" class="OCCURRENCE" comment="e3c:permanence=FINITE">AP</EVENT>) zela <EVENT eid="e18" class="REPORTING" comment="e3c:permanence=FINITE">baieztatu</EVENT> zen. Nahiz eta <TIMEX3 tid="t2" type="DURATION" value="PXD" temporalFunction="true">aurrenengo egunetan</TIMEX3> gaixoa ondo <EVENT eid="e19" class="OCCURRENCE" comment="e3c:permanence=FINITE">aurkitu</EVENT>, <TIMEX3 tid="t3" type="DATE" value="XXXX-XX-XX" temporalFunction="true">laugarren egunean</TIMEX3> <EVENT eid="e20" class="OCCURRENCE" comment="e3c:permanence=FINITE">sukarra</EVENT> agertu zen, sabeleko <EVENT eid="e21" class="OCCURRENCE" comment="e3c:permanence=FINITE">minez</EVENT> batera. Horregatik, laparotomia <EVENT eid="e22" class="OCCURRENCE" comment="e3c:permanence=FINITE">ikusketa</EVENT> burutu zitzaion, Douglas eta eskuineko parietokolikoan <EVENT eid="e23" class="OCCURRENCE" comment="e3c:permanence=FINITE">abszesu</EVENT> bat agertuz. <TIMEX3 tid="t4" type="DATE" value="XXXX-XX-XX" temporalFunction="true">Zazpigarren egunean</TIMEX3>, ebakuntza <EVENT eid="e24" class="OCCURRENCE" comment="e3c:permanence=FINITE">zauria</EVENT> <EVENT eid="e25" class="OCCURRENCE" comment="e3c:permanence=FINITE">zoldu</EVENT> egin zen eta <EVENT eid="e26" class="OCCURRENCE" comment="e3c:permanence=FINITE">sukarra</EVENT> agertu zen. <EVENT eid="e27" class="OCCURRENCE" comment="e3c:permanence=FINITE">OTAn</EVENT> giltzurrun aurreko gunean <EVENT eid="e28" class="OCCURRENCE" comment="e3c:permanence=FINITE">abszesu</EVENT> bat eta erraiak abdomenetik at <EVENT eid="e29" class="REPORTING" comment="e3c:permanence=FINITE">ikusi</EVENT> ziren. <TIMEX3 tid="t5" type="SET" value="X" temporalFunction="true" comment="e3c:timex3Class=QUANTIFIER; e3c:value=NO_VALUE">Hirugarren aldiz</TIMEX3> <EVENT eid="e30" class="OCCURRENCE" comment="e3c:permanence=FINITE">ebakuntza</EVENT> burutu zen, <EVENT eid="e31" class="OCCURRENCE" comment="e3c:permanence=FINITE">garbiketa</EVENT> eta <EVENT eid="e32" class="OCCURRENCE" comment="e3c:permanence=FINITE">Friedrich-a</EVENT> egin zirelarik. Hala eta guztiz ere, gaixoak hemodinamikoki <EVENT eid="e33" class="OCCURRENCE" comment="e3c:permanence=FINITE">desegonkor</EVENT> <EVENT eid="e34" class="ASPECTUAL" comment="e3c:permanence=FINITE">jarraitu</EVENT> zuen, hematokritoa <EVENT eid="e35" class="OCCURRENCE" comment="e3c:permanence=FINITE">jaitsiz</EVENT> eta <EVENT eid="e36" class="OCCURRENCE" comment="e3c:permanence=FINITE">leukozitoziarekin</EVENT>. Laugarren <EVENT eid="e37" class="OCCURRENCE" comment="e3c:permanence=FINITE">ebakuntzan</EVENT> <EVENT eid="e38" class="OCCURRENCE" comment="e3c:permanence=FINITE">hematoma</EVENT> haundia <EVENT eid="e39" class="REPORTING" comment="e3c:permanence=FINITE">ikusi</EVENT> zen Douglasen, odol <EVENT eid="e40" class="OCCURRENCE" comment="e3c:permanence=FINITE">jarioa</EVENT> nondik <EVENT eid="e41" class="OCCURRENCE" comment="e3c:permanence=FINITE">zetorren</EVENT> ezin <EVENT eid="e42" class="OCCURRENCE" comment="e3c:permanence=FINITE">bilaturik</EVENT>. <EVENT eid="e43" class="OCCURRENCE" comment="e3c:permanence=FINITE">Garbitu</EVENT> eta saratoga tipoko <EVENT eid="e44" class="OCCURRENCE" comment="e3c:permanence=FINITE">drenajea</EVENT> kokatu ziren. <TIMEX3 tid="t6" type="DATE" value="XXXX-XX-XX" temporalFunction="true">Seigarren egunean</TIMEX3>, gaixoak klinikoki <EVENT eid="e45" class="OCCURRENCE" comment="e3c:permanence=FINITE">gaizki</EVENT> <EVENT eid="e46" class="ASPECTUAL" comment="e3c:permanence=FINITE">jarraitzen</EVENT> zuen, beraz, <EVENT eid="e47" class="OCCURRENCE" comment="e3c:permanence=FINITE">OTA</EVENT> bat egin zitzaion. Hemen Douglas-en <EVENT eid="e48" class="OCCURRENCE" comment="e3c:permanence=FINITE">likidoa</EVENT> zegoela <EVENT eid="e49" class="REPORTING" comment="e3c:permanence=FINITE">ikusi</EVENT> zen eta <TIMEX3 tid="t7" type="SET" value="X" temporalFunction="true" comment="e3c:timex3Class=QUANTIFIER; e3c:value=NO_VALUE">bostgarren aldiz</TIMEX3> garbiketa <EVENT eid="e50" class="OCCURRENCE" comment="e3c:permanence=FINITE">ebakuntza</EVENT> bat burutu zitzaion. Azkeneko <EVENT eid="e51" class="OCCURRENCE" comment="e3c:permanence=FINITE">ebakuntza</EVENT> honen <TIMEX3 tid="t8" type="DATE" value="XXXX-XX-XX" temporalFunction="true">biharamunean</TIMEX3>, transaminasa eta bilirrubinak <EVENT eid="e52" class="OCCURRENCE" comment="e3c:permanence=FINITE">gora</EVENT> egin zuten. Sabeleko <EVENT eid="e53" class="OCCURRENCE" comment="e3c:permanence=FINITE">ekografia</EVENT> batek berriz, ez zuen inolako <EVENT eid="e54" class="OCCURRENCE" comment="e3c:permanence=FINITE">aldaketarik</EVENT> <EVENT eid="e55" class="REPORTING" comment="e3c:permanence=FINITE">ikusi</EVENT>. <EVENT eid="e56" class="OCCURRENCE" comment="e3c:permanence=FINITE">Ekografiaren</EVENT> emaitza <EVENT eid="e57" class="REPORTING" comment="e3c:permanence=FINITE">ikusita</EVENT> nutrizio parenterala <EVENT eid="e58" class="OCCURRENCE" comment="e3c:permanence=FINITE">kendu</EVENT> zitzaion eta gaixoa golpera <EVENT eid="e59" class="OCCURRENCE" comment="e3c:permanence=FINITE">hobetu</EVENT> zen. Horrela, <EVENT eid="e60" class="OCCURRENCE" comment="e3c:permanence=FINITE">ingresatu</EVENT> zenetik <TIMEX3 tid="t9" type="DATE" value="XXXX-XX-XX" temporalFunction="true">hogeitaemeretzigarren egunean</TIMEX3> ospitaletik <EVENT eid="e61" class="OCCURRENCE" comment="e3c:permanence=FINITE">alta</EVENT> eman zitzaion. <TIMEX3 tid="t10" type="DURATION" value="P1W" temporalFunction="false">Astebetera</TIMEX3>, gaixoa <EVENT eid="e62" class="OCCURRENCE" comment="e3c:permanence=FINITE">sukarragatik</EVENT> Larraldietara <EVENT eid="e63" class="OCCURRENCE" comment="e3c:permanence=FINITE">bueltatu</EVENT> zen. <EVENT eid="e64" class="OCCURRENCE" comment="e3c:permanence=FINITE">OTA</EVENT> burutu ondoren, eskuineko mokorrean dentsitate haundiko <EVENT eid="e65" class="OCCURRENCE" comment="e3c:permanence=FINITE">bilduma</EVENT> bat <EVENT eid="e66" class="REPORTING" comment="e3c:permanence=FINITE">ikusi</EVENT> zen, <EVENT eid="e67" class="OCCURRENCE" comment="e3c:permanence=FINITE">kirurgia</EVENT> osteko <EVENT eid="e68" class="OCCURRENCE" comment="e3c:permanence=FINITE">hematoma</EVENT> bat ematen zuelarik. <TIMEX3 tid="t11" type="DURATION" value="P9D" temporalFunction="false">Bederatzi egun</TIMEX3> ospitalean <EVENT eid="e69" class="OCCURRENCE" comment="e3c:permanence=FINITE">antibiotikoekin</EVENT> <EVENT eid="e70" class="OCCURRENCE" comment="e3c:permanence=FINITE">igaro</EVENT> ondoren <EVENT eid="e71" class="OCCURRENCE" comment="e3c:permanence=FINITE">alta</EVENT> eman zitzaion.</TEXT>
