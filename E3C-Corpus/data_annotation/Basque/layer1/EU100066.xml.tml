<?xml version="1.0" encoding="UTF-8"?>
<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2008-10-03T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2008-10-03</TIMEX3>
  <TEXT>8 hilabete. 
<EVENT eid="e1" class="OCCURRENCE">Barizela</EVENT> <TIMEX3 tid="t1" type="DATE" value="XXXX-XX-XX" temporalFunction="true">3. eguna</TIMEX3> eta <TIMEX3 tid="t2" type="DURATION" value="PT24H" temporalFunction="false">24 orduko</TIMEX3> <EVENT eid="e2" class="OCCURRENCE">sukarra</EVENT>. 
Amak eta 12 urteko anaiak ere <EVENT eid="e3" class="OCCURRENCE">barizela</EVENT> zuten. 
<EVENT eid="e4" class="OCCURRENCE">Azterketa</EVENT> fisikoa: <EVENT eid="e5" class="OCCURRENCE">ondoeza</EVENT>. 
Arnas <EVENT eid="e6" class="OCCURRENCE">zailtasuna</EVENT>. 
<EVENT eid="e7" class="OCCURRENCE">Polipnea</EVENT>. 
Eskuin birikan <EVENT eid="e8" class="OCCURRENCE">hipobentilazioa</EVENT>. 
<EVENT eid="e9" class="OCCURRENCE">Azterketa</EVENT> osagarriak: <EVENT eid="e10" class="OCCURRENCE">hemograma</EVENT>: <EVENT eid="e11" class="OCCURRENCE">leukozitoak</EVENT> 25300/mm3 (<EVENT eid="e12" class="OCCURRENCE">N</EVENT> %46, <EVENT eid="e13" class="OCCURRENCE">L</EVENT> %6, <EVENT eid="e14" class="OCCURRENCE">M</EVENT> %2, <EVENT eid="e15" class="OCCURRENCE">C</EVENT> %46). 
<EVENT eid="e16" class="OCCURRENCE">Biokimika</EVENT>: <EVENT eid="e17" class="OCCURRENCE">Na</EVENT> 128 mEq/l., <EVENT eid="e18" class="OCCURRENCE">PCR</EVENT> 265 mg/l. 
<EVENT eid="e19" class="OCCURRENCE">Likido</EVENT> Pleurala: <EVENT eid="e20" class="OCCURRENCE">pH</EVENT> 6,24, <EVENT eid="e21" class="OCCURRENCE">Glukosa</EVENT> 0 mg/dl, <EVENT eid="e22" class="OCCURRENCE">LDH</EVENT> 11781 UL, <EVENT eid="e23" class="OCCURRENCE">Proteinak</EVENT> 5 g/dl, <EVENT eid="e24" class="OCCURRENCE">Zelulak</EVENT> 91200/mm3 (<EVENT eid="e25" class="OCCURRENCE">N</EVENT> 100%). 
<EVENT eid="e26" class="OCCURRENCE">Hemokultiboa</EVENT>: negatiboa. 
Likido pleuraleko <EVENT eid="e27" class="OCCURRENCE">kultiboa</EVENT>: SBA. 
Kateter <EVENT eid="e28" class="OCCURRENCE">kultiboa</EVENT>: SBA, Bularraldeko <EVENT eid="e29" class="OCCURRENCE">erradiografia</EVENT>: Erdi-gingilean <EVENT eid="e30" class="OCCURRENCE">pneumonia</EVENT> eta <EVENT eid="e31" class="OCCURRENCE">isuri</EVENT> pleurala. 
Bularraldeko <EVENT eid="e32" class="OCCURRENCE">ekografia</EVENT>: 4 cm-ko <EVENT eid="e33" class="OCCURRENCE">isuri</EVENT> pleurala. 
<EVENT eid="e34" class="OCCURRENCE">Eboluzioa</EVENT>: Bularraldean <EVENT eid="e35" class="OCCURRENCE">drainadura-hodiak</EVENT> jarri genizkion Pleur-evac <EVENT eid="e36" class="OCCURRENCE">sistemarekin</EVENT>, urokinasaren <EVENT eid="e37" class="OCCURRENCE">laguntzaz</EVENT>. 
<EVENT eid="e38" class="OCCURRENCE">Tratamendu</EVENT> antibiotikoa <EVENT eid="e39" class="OCCURRENCE">Penicilina</EVENT> G sodikoa eta <EVENT eid="e40" class="OCCURRENCE">Clindamicinarekin</EVENT> egin genuen. 
<TIMEX3 tid="t3" type="DURATION" value="PXD" temporalFunction="true">Lehen egunetan</TIMEX3> <EVENT eid="e41" class="OCCURRENCE">SIADHa</EVENT> egin zuen, baina likido <EVENT eid="e42" class="OCCURRENCE">mugaketekin</EVENT> <EVENT eid="e43" class="OCCURRENCE">zuzendu</EVENT> genuen. 
<EVENT eid="e44" class="OCCURRENCE">Pneumonia</EVENT> <TIMEX3 tid="t4" type="SET" value="X" temporalFunction="true">bi aldiz</TIMEX3> <EVENT eid="e45" class="OCCURRENCE">pneumotoraxarekin</EVENT> <EVENT eid="e46" class="OCCURRENCE">konplikatu</EVENT> zen. 
<EVENT eid="e47" class="OCCURRENCE">Eboluzioa</EVENT> <EVENT eid="e48" class="REPORTING">ikusita</EVENT>, <EVENT eid="e49" class="OCCURRENCE">fistula</EVENT> bronkopleurala izan zezakeenaren <EVENT eid="e50" class="OCCURRENCE">susmopean</EVENT>, Gurutzetako Ospitaleko pediatria kirurgia zerbitzuarekin <EVENT eid="e51" class="OCCURRENCE">harremanetan</EVENT> jarri eta bertara <EVENT eid="e52" class="OCCURRENCE">bidali</EVENT> genuen <EVENT eid="e53" class="OCCURRENCE">tratamendua</EVENT> <EVENT eid="e54" class="OCCURRENCE">osatzeko</EVENT>. 
Estreptokoko pyogenes <EVENT eid="e55" class="OCCURRENCE">gaixotasun</EVENT> inbasiboaren diagnostikoa Osasun sailari eta Aurre Medikuntza zerbitzuei <EVENT eid="e56" class="OCCURRENCE">jakinarazi</EVENT> genien.
</TEXT>
