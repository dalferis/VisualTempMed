<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2011-06-06T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2011-06-06</TIMEX3>
  <TEXT><EVENT eid="e1" class="OCCURRENCE" comment="e3c:permanence=FINITE">Arnasestuz</EVENT> <EVENT eid="e2" class="OCCURRENCE" comment="e3c:permanence=FINITE">datorren</EVENT> biriketako butxadura kronikoaren <EVENT eid="e3" class="OCCURRENCE" comment="e3c:permanence=FINITE">gaixotasuna</EVENT> duen 87 urteko gizonezkoa. &#13;
<TIMEX3 tid="t1" type="DURATION" value="P4D" temporalFunction="false">Duela 4 egun</TIMEX3> <EVENT eid="e4" class="OCCURRENCE" comment="e3c:permanence=FINITE">eztula</EVENT>, eztarriko <EVENT eid="e5" class="OCCURRENCE" comment="e3c:permanence=FINITE">mina</EVENT> eta <EVENT eid="e6" class="OCCURRENCE" comment="e3c:permanence=FINITE">sukarraz</EVENT> <EVENT eid="e7" class="ASPECTUAL" comment="e3c:permanence=FINITE">hasi</EVENT> da. &#13;
Bere anbulatorioko medikuak <EVENT eid="e8" class="OCCURRENCE" comment="e3c:permanence=FINITE">parazetamola</EVENT>, <EVENT eid="e9" class="OCCURRENCE" comment="e3c:permanence=FINITE">kodeina</EVENT> eta <EVENT eid="e10" class="OCCURRENCE" comment="e3c:permanence=FINITE">terbutalina</EVENT> jarri zizkion, <EVENT eid="e11" class="OCCURRENCE" comment="e3c:permanence=FINITE">hobekuntza</EVENT> eskasiarekin. &#13;
<TIMEX3 tid="t2" type="DURATION" value="P2D" temporalFunction="false">Duela bi egunetik</TIMEX3> <EVENT eid="e12" class="OCCURRENCE" comment="e3c:permanence=FINITE">zorabioa</EVENT> dauka ohetik <EVENT eid="e13" class="OCCURRENCE" comment="e3c:permanence=FINITE">altxatzean</EVENT>. &#13;
<EVENT eid="e14" class="OCCURRENCE" comment="e3c:permanence=FINITE">Goitikatu</EVENT> egin du <EVENT eid="e15" class="OCCURRENCE" comment="e3c:permanence=FINITE">gosaldu</EVENT> ostean eta sabeleko <EVENT eid="e16" class="OCCURRENCE" comment="e3c:permanence=FINITE">mina</EVENT> dauka. &#13;
Ez du diuresi <EVENT eid="e17" class="OCCURRENCE" comment="e3c:permanence=FINITE">gutximenik</EVENT>, <EVENT eid="e18" class="OCCURRENCE" comment="e3c:permanence=FINITE">ortopnearik</EVENT>, ezta gaueko <EVENT eid="e19" class="OCCURRENCE" comment="e3c:permanence=FINITE">arnasestu</EVENT> paroxistikorik. &#13;
Ez zaizkio hankak <EVENT eid="e20" class="OCCURRENCE" comment="e3c:permanence=FINITE">puztu</EVENT>. Ez du bularraldeko <EVENT eid="e21" class="OCCURRENCE" comment="e3c:permanence=FINITE">minik</EVENT>. &#13;
Ez du <EVENT eid="e22" class="OCCURRENCE" comment="e3c:permanence=FINITE">txiza</EVENT> egitean <EVENT eid="e23" class="OCCURRENCE" comment="e3c:permanence=FINITE">klinikarik</EVENT>. &#13;
Bere <EVENT eid="e24" class="OCCURRENCE" comment="e3c:permanence=FINITE">aurrekari</EVENT> pertsonalak: ez du botiken <EVENT eid="e25" class="OCCURRENCE" comment="e3c:permanence=FINITE">alergia</EVENT> ezagunik, <EVENT eid="e26" class="OCCURRENCE" comment="e3c:permanence=FINITE">tentsio</EVENT> altua dauka, ez du <EVENT eid="e27" class="STATE" comment="e3c:permanence=PERMANENT">diabetesik</EVENT>, ez <EVENT eid="e28" class="OCCURRENCE" comment="e3c:permanence=FINITE">hiperlipemiarik</EVENT>. &#13;
<EVENT eid="e29" class="OCCURRENCE" comment="e3c:permanence=FINITE">Erretzaile</EVENT> ohia da, biriketako butxadura kronikoaren <EVENT eid="e30" class="OCCURRENCE" comment="e3c:permanence=FINITE">gaixotasuna</EVENT> dauka (<EVENT eid="e31" class="OCCURRENCE" comment="e3c:permanence=FINITE">EPOC</EVENT>), giltzurruneko <EVENT eid="e32" class="OCCURRENCE" comment="e3c:permanence=FINITE">kolikoen</EVENT> errepikapena du. &#13;
Gorputzaren <EVENT eid="e33" class="OCCURRENCE" comment="e3c:permanence=FINITE">miaketa</EVENT>: <EVENT eid="e34" class="OCCURRENCE" comment="e3c:permanence=FINITE">TA</EVENT>: 104/39, O2 <EVENT eid="e35" class="OCCURRENCE" comment="e3c:permanence=FINITE">Sat</EVENT>: % 89, 103 bihotz taupada minutuko, 20 arnasketa minutuko, 36,7ºC. &#13;
Ez du <EVENT eid="e36" class="OCCURRENCE" comment="e3c:permanence=FINITE">jugular</EVENT> ingurgitaziorik, bihotzeko <EVENT eid="e37" class="OCCURRENCE" comment="e3c:permanence=FINITE">auskultazioan</EVENT> <EVENT eid="e38" class="OCCURRENCE" comment="e3c:permanence=FINITE">takikardia</EVENT> sinusala dauka, biriketako aireztapen <EVENT eid="e39" class="OCCURRENCE" comment="e3c:permanence=FINITE">eskasia</EVENT>, sabel, giltzurrunen <EVENT eid="e40" class="OCCURRENCE" comment="e3c:permanence=FINITE">perkusio</EVENT> eta hanken <EVENT eid="e41" class="OCCURRENCE" comment="e3c:permanence=FINITE">esplorazioa</EVENT> normala da. &#13;
<EVENT eid="e42" class="OCCURRENCE" comment="e3c:permanence=FINITE">Gasometria</EVENT> arteriala: <EVENT eid="e43" class="OCCURRENCE" comment="e3c:permanence=FINITE">pO2</EVENT> 53, <EVENT eid="e44" class="OCCURRENCE" comment="e3c:permanence=FINITE">pCo2</EVENT> 33, <EVENT eid="e45" class="OCCURRENCE" comment="e3c:permanence=FINITE">pH</EVENT> 7,36, 18 <EVENT eid="e46" class="OCCURRENCE" comment="e3c:permanence=FINITE">bikarbonatoa</EVENT> &#13;
Odol <EVENT eid="e47" class="OCCURRENCE" comment="e3c:permanence=FINITE">analisia</EVENT>: 5,66 <EVENT eid="e48" class="OCCURRENCE" comment="e3c:permanence=FINITE">kreatinina</EVENT>, 155 <EVENT eid="e49" class="OCCURRENCE" comment="e3c:permanence=FINITE">urea</EVENT>, 141 <EVENT eid="e50" class="OCCURRENCE" comment="e3c:permanence=FINITE">sodio</EVENT>, <EVENT eid="e51" class="OCCURRENCE" comment="e3c:permanence=FINITE">potasio</EVENT> 4, 0,15 <EVENT eid="e52" class="OCCURRENCE" comment="e3c:permanence=FINITE">troponina</EVENT> T, 682 <EVENT eid="e53" class="OCCURRENCE" comment="e3c:permanence=FINITE">Pro-BNP</EVENT>, 511 <EVENT eid="e54" class="OCCURRENCE" comment="e3c:permanence=FINITE">kreatinkinasa</EVENT>, 10,1 <EVENT eid="e55" class="OCCURRENCE" comment="e3c:permanence=FINITE">hemoglobina</EVENT>, 87 <EVENT eid="e56" class="OCCURRENCE" comment="e3c:permanence=FINITE">vcm</EVENT>, 29 <EVENT eid="e57" class="OCCURRENCE" comment="e3c:permanence=FINITE">hcm</EVENT>, 10900 <EVENT eid="e58" class="OCCURRENCE" comment="e3c:permanence=FINITE">leukozitoak</EVENT> (%86 <EVENT eid="e59" class="OCCURRENCE" comment="e3c:permanence=FINITE">neutrofiloak</EVENT>, %7 <EVENT eid="e60" class="OCCURRENCE" comment="e3c:permanence=FINITE">linfozitoak</EVENT>) &#13;
<EVENT eid="e61" class="OCCURRENCE" comment="e3c:permanence=FINITE">Txiza</EVENT> (<EVENT eid="e62" class="OCCURRENCE" comment="e3c:permanence=FINITE">zundaketa</EVENT> ostean 200 ml): 150/uL <EVENT eid="e63" class="OCCURRENCE" comment="e3c:permanence=FINITE">hematiak</EVENT>, 27 <EVENT eid="e64" class="OCCURRENCE" comment="e3c:permanence=FINITE">sodioko</EVENT> mek/L, 58 <EVENT eid="e65" class="OCCURRENCE" comment="e3c:permanence=FINITE">potasioko</EVENT> mEk/L &#13;
Sabel eta pelbiseko <EVENT eid="e66" class="OCCURRENCE" comment="e3c:permanence=FINITE">eskanerra</EVENT>: eskuineko birikako beheko lobuluan <EVENT eid="e67" class="OCCURRENCE" comment="e3c:permanence=FINITE">kondentsazio</EVENT> txiki bat, perikardioko <EVENT eid="e68" class="OCCURRENCE" comment="e3c:permanence=FINITE">isuri</EVENT> eskasia, <EVENT eid="e69" class="OCCURRENCE" comment="e3c:permanence=FINITE">giltzurrun</EVENT> kistikoak ditu. &#13;
Toraxeko <EVENT eid="e70" class="OCCURRENCE" comment="e3c:permanence=FINITE">erradiografia</EVENT>: <EVENT eid="e71" class="OCCURRENCE" comment="e3c:permanence=FINITE">kardiomegalia</EVENT>, ez dago kondentsazio <EVENT eid="e72" class="OCCURRENCE" comment="e3c:permanence=FINITE">irudirik</EVENT>, <EVENT eid="e73" class="OCCURRENCE" comment="e3c:permanence=FINITE">Hemokultiboak</EVENT> jaso genizkion.&#13;
&#13;
<EVENT eid="e74" class="OCCURRENCE" comment="e3c:permanence=FINITE">Tratamendua</EVENT>: <EVENT eid="e75" class="OCCURRENCE" comment="e3c:permanence=FINITE">VMSK</EVENT> %28 O2, 500 ml-ko 3 <EVENT eid="e76" class="OCCURRENCE" comment="e3c:permanence=FINITE">suero</EVENT> fisiologiko, <EVENT eid="e77" class="OCCURRENCE" comment="e3c:permanence=FINITE">salbutamol</EVENT> eta ipratropioko bromurozko <EVENT eid="e78" class="OCCURRENCE" comment="e3c:permanence=FINITE">lainoztapena</EVENT> (<EVENT eid="e79" class="OCCURRENCE" comment="e3c:permanence=FINITE">nebulizazioa</EVENT>), gernuko <EVENT eid="e80" class="OCCURRENCE" comment="e3c:permanence=FINITE">zundaketa</EVENT>, <EVENT eid="e81" class="OCCURRENCE" comment="e3c:permanence=FINITE">zefotaxima</EVENT> eta <EVENT eid="e82" class="OCCURRENCE" comment="e3c:permanence=FINITE">lebofloxazino</EVENT>. &#13;
<EVENT eid="e83" class="OCCURRENCE" comment="e3c:permanence=FINITE">Behaketan</EVENT> dagoelarik <EVENT eid="e84" class="OCCURRENCE" comment="e3c:permanence=FINITE">tentsio</EVENT> arteriala <EVENT eid="e85" class="OCCURRENCE" comment="e3c:permanence=FINITE">jaisten</EVENT> zaio, 80/30, 69/40, bihotz <EVENT eid="e86" class="OCCURRENCE" comment="e3c:permanence=FINITE">taupadak</EVENT> 117 ditu eta <EVENT eid="e87" class="OCCURRENCE" comment="e3c:permanence=FINITE">Hb</EVENT> 9,8 eta dopaminako <EVENT eid="e88" class="OCCURRENCE" comment="e3c:permanence=FINITE">perfusioa</EVENT> jartzen zaio eta <EVENT eid="e89" class="OCCURRENCE" comment="e3c:permanence=FINITE">zainketa</EVENT> berezietara <EVENT eid="e90" class="OCCURRENCE" comment="e3c:permanence=FINITE">daramagu</EVENT>. &#13;
Bertan, zainetako <EVENT eid="e91" class="OCCURRENCE" comment="e3c:permanence=FINITE">presio</EVENT> zentrala <EVENT eid="e92" class="OCCURRENCE" comment="e3c:permanence=FINITE">neurtzeko</EVENT> <EVENT eid="e93" class="OCCURRENCE" comment="e3c:permanence=FINITE">bidea</EVENT> hartzen zaio. &#13;
<EVENT eid="e94" class="OCCURRENCE" comment="e3c:permanence=FINITE">Dopaminarekin</EVENT> <EVENT eid="e95" class="OCCURRENCE" comment="e3c:permanence=FINITE">tentsioak</EVENT> <EVENT eid="e96" class="ASPECTUAL" comment="e3c:permanence=FINITE">mantentzen</EVENT> zaizkio eta giltzurrunetako <EVENT eid="e97" class="OCCURRENCE" comment="e3c:permanence=FINITE">funtzioa</EVENT> <EVENT eid="e98" class="OCCURRENCE" comment="e3c:permanence=FINITE">hobetzen</EVENT> <EVENT eid="e99" class="ASPECTUAL" comment="e3c:permanence=FINITE">hasten</EVENT> zaio kreatininaren nibela <EVENT eid="e100" class="OCCURRENCE" comment="e3c:permanence=FINITE">jaisten</EVENT> zaiolarik. &#13;
Pazientea plantara <EVENT eid="e101" class="OCCURRENCE" comment="e3c:permanence=FINITE">pasatzen</EVENT> da <EVENT eid="e102" class="OCCURRENCE" comment="e3c:permanence=FINITE">sueroak</EVENT> eta <EVENT eid="e103" class="OCCURRENCE" comment="e3c:permanence=FINITE">antibiotikoak</EVENT> hartuz.&#13;
&#13;
EMAITZAK <EVENT eid="e104" class="OCCURRENCE" comment="e3c:permanence=FINITE">Hemokultiboa</EVENT> negatiboa, <EVENT eid="e105" class="OCCURRENCE" comment="e3c:permanence=FINITE">karkaixa</EVENT> negatiboa.&#13;
&#13;
ONDORIOAK <EVENT eid="e106" class="OCCURRENCE" comment="e3c:permanence=FINITE">Shock</EVENT> septikoa eta horren ondoriozko giltzurrunetako funtzio <EVENT eid="e107" class="OCCURRENCE" comment="e3c:permanence=FINITE">eskasia</EVENT> eta eskuineko birikako beheko lobuluan <EVENT eid="e108" class="OCCURRENCE" comment="e3c:permanence=FINITE">pneumonia</EVENT>. &#13;
<TIMEX3 tid="t3" type="DURATION" value="P23D" temporalFunction="false">23 egun</TIMEX3> <EVENT eid="e109" class="OCCURRENCE" comment="e3c:permanence=FINITE">pasata</EVENT> pazientea <EVENT eid="e110" class="OCCURRENCE" comment="e3c:permanence=FINITE">osaturik</EVENT> bere etxera <EVENT eid="e111" class="OCCURRENCE" comment="e3c:permanence=FINITE">doa</EVENT>.&#13;
</TEXT>
