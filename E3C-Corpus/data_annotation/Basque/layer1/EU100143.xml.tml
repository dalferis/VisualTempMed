<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2015-01-23T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2015-01-23</TIMEX3>
  <TEXT><EVENT eid="e1" class="OCCURRENCE">KONTSULTARAKO</EVENT> ARRAZOIA&#13;
38 urteko gizonezkoa; abdomeneko <EVENT eid="e2" class="OCCURRENCE">mina</EVENT> du, <TIMEX3 tid="t1" type="DURATION" value="P3D" temporalFunction="false">3 eguneko</TIMEX3> <EVENT eid="e3" class="OCCURRENCE">eboluzioarekin</EVENT>.&#13;
<EVENT eid="e4" class="OCCURRENCE">AURREKARI</EVENT> PERTSONALAK&#13;
-<EVENT eid="e5" class="OCCURRENCE">Alergia</EVENT> die AINEei (hantura kontrako ez-esteroideoei) eta Anisakisari.&#13;
-<EVENT eid="e6" class="OCCURRENCE">Erretzailea</EVENT>: 8 <EVENT eid="e7" class="OCCURRENCE">zigarro</EVENT> <TIMEX3 tid="t2" type="SET" value="P1D" temporalFunction="true">egunean</TIMEX3>.&#13;
-Erreakziozko <EVENT eid="e8" class="OCCURRENCE">depresioa</EVENT> <TIMEX3 tid="t3" type="DATE" value="2012" temporalFunction="false">2012an</TIMEX3>, <EVENT eid="e9" class="OCCURRENCE">Paroxetinaz</EVENT> tratatutakoa.&#13;
-Aurretik, <EVENT eid="e10" class="OCCURRENCE">interbentzio</EVENT> kirurgikorik ez.&#13;
-Ohiko <EVENT eid="e11" class="OCCURRENCE">tratamendurik</EVENT> ez.&#13;
FAMILIAKO <EVENT eid="e12" class="OCCURRENCE">AURREKARIAK</EVENT>&#13;
-Aitak <EVENT eid="e13" class="OCCURRENCE">BGBK</EVENT> (<EVENT eid="e14" class="OCCURRENCE">EPOC</EVENT>) izan zuen.&#13;
<TIMEX3 tid="t4" type="DATE" value="PRESENT_REF" temporalFunction="true">EGUNGO</TIMEX3> <EVENT eid="e15" class="OCCURRENCE">GAIXOTASUNA</EVENT>&#13;
<TIMEX3 tid="t5" type="DATE" value="PAST_REF" temporalFunction="true">Aurretik</TIMEX3> ondo <EVENT eid="e16" class="OCCURRENCE">zegoela</EVENT>, bat-bateko <EVENT eid="e17" class="OCCURRENCE">mina</EVENT> izan zuela <EVENT eid="e18" class="REPORTING">dio</EVENT>, ezkerreko zokogune iliakoan, <EVENT eid="e19" class="OCCURRENCE">koliko</EVENT> motakoa, <EVENT eid="e20" class="OCCURRENCE">hedatzen</EVENT> ez zena. &#13;
<TIMEX3 tid="t6" type="TIME" value="XXXX-XX-XX" temporalFunction="true">Beste une batzuetan</TIMEX3>, <EVENT eid="e21" class="OCCURRENCE">sintomarik</EVENT> gabe eta ohiko <EVENT eid="e22" class="OCCURRENCE">bizimodua</EVENT> eginez.&#13;
<TIMEX3 tid="t7" type="DURATION" value="PT24H" temporalFunction="false">24 ordu</TIMEX3> <EVENT eid="e23" class="OCCURRENCE">igarota</EVENT>, <EVENT eid="e24" class="OCCURRENCE">ondoez</EVENT> orokorraren <EVENT eid="e25" class="REPORTING">sentsazioa</EVENT> azaltzen du, <EVENT eid="e26" class="OCCURRENCE">mialgiekin</EVENT>; <EVENT eid="e27" class="OCCURRENCE">sukarrik</EVENT> ez. &#13;
Abdomeneko <EVENT eid="e28" class="OCCURRENCE">min</EVENT> berarekin <EVENT eid="e29" class="ASPECTUAL">jarraitzen</EVENT> du, baina <TIMEX3 tid="t8" type="DATE" value="PRESENT_REF" temporalFunction="true">orain</TIMEX3> eskuineko zokogune iliakora <EVENT eid="e30" class="OCCURRENCE">hedatzen</EVENT> da eta maizago <EVENT eid="e31" class="OCCURRENCE">gertatzen</EVENT> zaio. &#13;
<EVENT eid="e32" class="OCCURRENCE">Mina</EVENT> <EVENT eid="e33" class="OCCURRENCE">areagotu</EVENT> egiten da <EVENT eid="e34" class="OCCURRENCE">mugimenduekin</EVENT>. &#13;
Ez du ez <EVENT eid="e35" class="OCCURRENCE">gorakorik</EVENT> ez heste-ohituraren <EVENT eid="e36" class="OCCURRENCE">alteraziorik</EVENT> ere. &#13;
<EVENT eid="e37" class="OCCURRENCE">Gernu-klinikarik</EVENT> ez, ezta lotutako bestelako <EVENT eid="e38" class="OCCURRENCE">sintomatologiarik</EVENT> ere.&#13;
<EVENT eid="e39" class="OCCURRENCE">MIAKETA</EVENT> OROKORRA&#13;
<EVENT eid="e40" class="OCCURRENCE">TA</EVENT> 114/64, <EVENT eid="e41" class="OCCURRENCE">BM</EVENT> 55, Tª36.8º&#13;
<EVENT eid="e42" class="OCCURRENCE">CKontziente</EVENT> eta <EVENT eid="e43" class="OCCURRENCE">orientatuta</EVENT>. &#13;
Ondo <EVENT eid="e44" class="OCCURRENCE">hidratatuta</EVENT> eta <EVENT eid="e45" class="OCCURRENCE">prefundituta</EVENT>. &#13;
<EVENT eid="e46" class="OCCURRENCE">Eupneikoa</EVENT> <EVENT eid="e47" class="OCCURRENCE">atsedenean</EVENT>. &#13;
Larruazalaren eta mukosen <EVENT eid="e48" class="OCCURRENCE">kolorazio</EVENT> egokia. &#13;
<EVENT eid="e49" class="OCCURRENCE">Minak</EVENT> ez dio <EVENT eid="e50" class="OCCURRENCE">erasaten</EVENT>, <EVENT eid="e51" class="OCCURRENCE">larritasunak</EVENT> ez du <EVENT eid="e52" class="OCCURRENCE">hunkitzen</EVENT>.&#13;
Burua eta lepoa: Ez da <EVENT eid="e53" class="REPORTING">haztatzen</EVENT> ez <EVENT eid="e54" class="OCCURRENCE">adenopatiarik</EVENT> ez <EVENT eid="e55" class="OCCURRENCE">golorik</EVENT>. &#13;
<EVENT eid="e56" class="OCCURRENCE">Ingurgitazio</EVENT> jugularrik ez. &#13;
<EVENT eid="e57" class="OCCURRENCE">Zeinu</EVENT> meningeorik ez.&#13;
TORAXA: <EVENT eid="e58" class="OCCURRENCE">Bihotz-auskultazioa</EVENT>: <EVENT eid="e59" class="OCCURRENCE">erritmikoa</EVENT>, <EVENT eid="e60" class="OCCURRENCE">tonu</EVENT> motelak. &#13;
<EVENT eid="e61" class="OCCURRENCE">Murmuriorik</EVENT> ez.&#13;
<EVENT eid="e62" class="OCCURRENCE">Birika-auskultazioa</EVENT>: arnas <EVENT eid="e63" class="OCCURRENCE">murmurio</EVENT> kontserbatua, beste <EVENT eid="e64" class="OCCURRENCE">hotsik</EVENT> gabe.&#13;
ABDOMENA, <EVENT eid="e65" class="OCCURRENCE">biguna</EVENT> eta <EVENT eid="e66" class="OCCURRENCE">deprimigarria</EVENT>, <EVENT eid="e67" class="OCCURRENCE">distentsiorik</EVENT> ez, ez <EVENT eid="e68" class="OCCURRENCE">tinpanikoa</EVENT>. &#13;
<EVENT eid="e69" class="OCCURRENCE">Mina</EVENT> bi zokogune iliakoak <EVENT eid="e70" class="REPORTING">haztatzean</EVENT>, <EVENT eid="e71" class="OCCURRENCE">defentsarik</EVENT> gabe. &#13;
<EVENT eid="e72" class="OCCURRENCE">Molestia</EVENT> epigastrioan.&#13;
EEII (BEHEKO GORPUTZADARRAK): Ez <EVENT eid="e73" class="OCCURRENCE">edemarik</EVENT> ez <EVENT eid="e74" class="OCCURRENCE">TBPrik</EVENT>.&#13;
<EVENT eid="e75" class="OCCURRENCE">MIAKETA</EVENT> OSAGARRIAK&#13;
<EVENT eid="e76" class="OCCURRENCE">ANALITIKA</EVENT>:&#13;
<EVENT eid="e77" class="OCCURRENCE">BQ</EVENT>: CPK262 U/l, <EVENT eid="e78" class="OCCURRENCE">PCR</EVENT> 5.19 mg/dl. &#13;
<EVENT eid="e79" class="OCCURRENCE">Gainerakoa</EVENT>, normala.&#13;
<EVENT eid="e80" class="OCCURRENCE">HEMATIMETRIA</EVENT>: <EVENT eid="e81" class="OCCURRENCE">Hb</EVENT> eta <EVENT eid="e82" class="OCCURRENCE">VCM</EVENT> normalak. &#13;
<EVENT eid="e83" class="OCCURRENCE">Plaketak</EVENT>, <EVENT eid="e84" class="OCCURRENCE">leukozitoak</EVENT> eta <EVENT eid="e85" class="OCCURRENCE">formula</EVENT> leukozitarioa normalak.&#13;
<EVENT eid="e86" class="OCCURRENCE">KOAGULAZIOA</EVENT>: normala&#13;
TORAXEKO X <EVENT eid="e87" class="OCCURRENCE">IZPIAK</EVENT>: Sinu kostofrenikoak <EVENT eid="e88" class="OCCURRENCE">libre</EVENT>. &#13;
<EVENT eid="e89" class="OCCURRENCE">Kardiomegaliarik</EVENT> ez. &#13;
Ez da <EVENT eid="e90" class="OCCURRENCE">kondentsaziorik</EVENT> <EVENT eid="e91" class="REPORTING">ikusten</EVENT>.&#13;
ABDOMENEKO X <EVENT eid="e92" class="OCCURRENCE">IZPIAK</EVENT>: <EVENT eid="e93" class="OCCURRENCE">airea</EVENT> eta <EVENT eid="e94" class="OCCURRENCE">gorozkiak</EVENT> marko kolikoan ondesteko anpoilaraino.&#13;
</TEXT>
