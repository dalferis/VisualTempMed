<?xml version="1.0" encoding="UTF-8"?>
<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2016-06-24T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2016-06-24</TIMEX3>
  <TEXT><EVENT eid="e1" class="OCCURRENCE">AURREKARI</EVENT> PERTSONALAK:&#13;
-Akaroei <EVENT eid="e2" class="OCCURRENCE">alergia</EVENT>. Elikagai edo medikazioeieta <EVENT eid="e3" class="OCCURRENCE">alergiarik</EVENT> ez.&#13;
-Ariketagatiko <EVENT eid="e4" class="OCCURRENCE">asma</EVENT>, azpiko <EVENT eid="e5" class="OCCURRENCE">tratamendurik</EVENT> ez&#13;
-Antsietate <EVENT eid="e6" class="OCCURRENCE">krisia</EVENT> <TIMEX3 tid="t1" type="DATE" value="2011" temporalFunction="false">2011</TIMEX3>&#13;
-<EVENT eid="e7" class="OCCURRENCE">Idorreria</EVENT>, <EVENT eid="e8" class="OCCURRENCE">tratamendurik</EVENT> gabe&#13;
-Txertaketa egutegiaren arabera egoki <EVENT eid="e9" class="OCCURRENCE">txertatua</EVENT>&#13;
FAMILIA <EVENT eid="e10" class="OCCURRENCE">AURREKARIAK</EVENT>:&#13;
-Aitak <EVENT eid="e11" class="OCCURRENCE">HTA</EVENT> <EVENT eid="e12" class="OCCURRENCE">tratamenduarekin</EVENT>. &#13;
<EVENT eid="e13" class="OCCURRENCE">Psoriasia</EVENT>&#13;
-Ama eta ahizpa <EVENT eid="e14" class="OCCURRENCE">osasuntsuak</EVENT>&#13;
&#13;
<EVENT eid="e15" class="OCCURRENCE">KONTSULTAREN</EVENT> ARRAZOIA:&#13;
Haur eta gazteentzako psikiatriako unitatetik <EVENT eid="e16" class="OCCURRENCE">abisatu</EVENT> digute elikadura jokabidearen <EVENT eid="e17" class="OCCURRENCE">asalduragatik</EVENT> <EVENT eid="e18" class="OCCURRENCE">ingresatuta</EVENT> dagoen 14 urteko neska gazte bat <EVENT eid="e19" class="OCCURRENCE">baloratzeko</EVENT>. &#13;
<TIMEX3 tid="t2" type="DURATION" value="P5D" temporalFunction="false">5 egun</TIMEX3> daramatza bertan <EVENT eid="e20" class="OCCURRENCE">ingresatua</EVENT>. &#13;
Klinika <TIMEX3 tid="t3" type="DURATION" value="P6M" temporalFunction="false">orain dela 6 hilabete</TIMEX3> <EVENT eid="e21" class="ASPECTUAL">hasi</EVENT> zen pisu <EVENT eid="e22" class="OCCURRENCE">galera</EVENT> boluntariorekin. &#13;
<TIMEX3 tid="t4" type="DATE" value="2016-01" temporalFunction="false">Garai horretan</TIMEX3> <EVENT eid="e23" class="ASPECTUAL">hasita</EVENT> gutxi gora behera sabeleko <EVENT eid="e24" class="OCCURRENCE">mina</EVENT> duela <EVENT eid="e25" class="REPORTING">dio</EVENT>, epigastrioan <EVENT eid="e26" class="OCCURRENCE">kokatua</EVENT>, <EVENT eid="e27" class="OCCURRENCE">min</EVENT> kolikoa da, <EVENT eid="e28" class="OCCURRENCE">analgesiari</EVENT> ondo <EVENT eid="e29" class="OCCURRENCE">erantzuten</EVENT> ez diona, <TIMEX3 tid="t5" type="DURATION" value="PXM" temporalFunction="true">azken hilabeteotan</TIMEX3> gutxiago <EVENT eid="e30" class="OCCURRENCE">jatea</EVENT> eragin duena. &#13;
Ez du <EVENT eid="e31" class="OCCURRENCE">pirosirik</EVENT> ezta <EVENT eid="e32" class="OCCURRENCE">azidotasunik</EVENT> ere. &#13;
<EVENT eid="e33" class="OCCURRENCE">Mina</EVENT> eta pisu <EVENT eid="e34" class="OCCURRENCE">galera</EVENT> dela eta, Digestio aparatuko kontsultetan <EVENT eid="e35" class="OCCURRENCE">baloratu</EVENT> dute, non odol <EVENT eid="e36" class="OCCURRENCE">analisi</EVENT> bat, sabeleko <EVENT eid="e37" class="OCCURRENCE">ekografia</EVENT> eta <EVENT eid="e38" class="OCCURRENCE">erradiografia</EVENT> eta <EVENT eid="e39" class="OCCURRENCE">gastroskopia</EVENT> egin dizkioten, denak <EVENT eid="e40" class="OCCURRENCE">emaitza</EVENT> normalarekin.&#13;
<TIMEX3 tid="t6" type="DURATION" value="P1M" temporalFunction="false">Azken hilabetean</TIMEX3> <EVENT eid="e41" class="OCCURRENCE">gorakoak</EVENT> izan ditu du. &#13;
Azken <EVENT eid="e42" class="OCCURRENCE">hilerokoa</EVENT> <TIMEX3 tid="t7" type="DURATION" value="P3M" temporalFunction="false">duela 3 hilabete</TIMEX3> izan zuen. &#13;
Psikiatrian <EVENT eid="e43" class="OCCURRENCE">ingresatuta</EVENT> egon den bitartean sabeleko <EVENT eid="e44" class="OCCURRENCE">mina</EVENT> gero eta <EVENT eid="e45" class="OCCURRENCE">handiagoa</EVENT> da, goragale <EVENT eid="e46" class="OCCURRENCE">sentsazioa</EVENT> du eta <EVENT eid="e47" class="OCCURRENCE">gorakoak</EVENT> ditu ia <EVENT eid="e48" class="OCCURRENCE">jatordu</EVENT> guztien ondoren. &#13;
<TIMEX3 tid="t8" type="DURATION" value="PT48H" temporalFunction="false">Azken 48 orduetan</TIMEX3> <EVENT eid="e49" class="OCCURRENCE">egoera</EVENT> orokorra <EVENT eid="e50" class="OCCURRENCE">okerragoa</EVENT> du.&#13;
<EVENT eid="e51" class="OCCURRENCE">Pisua</EVENT> <TIMEX3 tid="t9" type="DURATION" value="P6M" temporalFunction="false">duela 6 hilabete</TIMEX3>: 51 kg.&#13;
<EVENT eid="e52" class="OCCURRENCE">Pisua</EVENT> psikiatriako <EVENT eid="e53" class="OCCURRENCE">ingresoaren</EVENT> <TIMEX3 tid="t10" type="DATE" value="XXXX-XX-XX" temporalFunction="true">egunean</TIMEX3>: 36,3 kg (-35%). &#13;
<EVENT eid="e54" class="OCCURRENCE">Altuera</EVENT> 160 cm. &#13;
<EVENT eid="e55" class="OCCURRENCE">IMC</EVENT>: 14,17.&#13;
&#13;
<EVENT eid="e56" class="OCCURRENCE">AZTERKETA</EVENT> FISIKOA:&#13;
<EVENT eid="e57" class="OCCURRENCE">Tº</EVENT> 36.2ºC Ax. &#13;
<EVENT eid="e58" class="OCCURRENCE">BM</EVENT> 80 lpm. &#13;
<EVENT eid="e59" class="OCCURRENCE">TA</EVENT> 90/60 mmHg. &#13;
<EVENT eid="e60" class="OCCURRENCE">Egoera</EVENT> orokor eskasa. &#13;
Mukosa lehorrak. &#13;
<EVENT eid="e61" class="OCCURRENCE">Zurbiltasuna</EVENT>. &#13;
<EVENT eid="e62" class="OCCURRENCE">Desnutrizioa</EVENT>. &#13;
Gorputz adar hotzak. &#13;
<EVENT eid="e63" class="OCCURRENCE">Exantema</EVENT> edo bestelako azaleko <EVENT eid="e64" class="OCCURRENCE">lesiorik</EVENT> ez. &#13;
<EVENT eid="e65" class="OCCURRENCE">Betetze</EVENT> kapilarra &lt; 2 seg. &#13;
<EVENT eid="e66" class="OCCURRENCE">Pultsuak</EVENT> ++/++.&#13;
Bihotz eta birika <EVENT eid="e67" class="OCCURRENCE">auskultazioa</EVENT>: normala&#13;
<EVENT eid="e68" class="OCCURRENCE">ORL</EVENT>: normala&#13;
Abdomena: <EVENT eid="e69" class="OCCURRENCE">handituta</EVENT>, apur bat <EVENT eid="e70" class="OCCURRENCE">gogorra</EVENT>, ez da <EVENT eid="e71" class="OCCURRENCE">mingarria</EVENT> <EVENT eid="e72" class="OCCURRENCE">ukitzean</EVENT>. &#13;
Heste <EVENT eid="e73" class="OCCURRENCE">zaratak</EVENT> <EVENT eid="e74" class="REPORTING">entzuten</EVENT> dira. &#13;
Ez du <EVENT eid="e75" class="OCCURRENCE">masa</EVENT> edo <EVENT eid="e76" class="OCCURRENCE">megaliarik</EVENT>. &#13;
<EVENT eid="e77" class="OCCURRENCE">Blumberg</EVENT> negatiboa.&#13;
<EVENT eid="e78" class="OCCURRENCE">NSZ</EVENT>: normala. &#13;
<EVENT eid="e79" class="OCCURRENCE">Zeinu</EVENT> meningeoak negatiboak. &#13;
<EVENT eid="e80" class="OCCURRENCE">Kontziente</EVENT> eta espazio eta denboran ondo <EVENT eid="e81" class="OCCURRENCE">orientatuta</EVENT>.&#13;
</TEXT>
