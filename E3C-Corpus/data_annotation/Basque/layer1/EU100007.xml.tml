<?xml version="1.0" encoding="UTF-8"?>
<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2014-12-31T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2014-12-31</TIMEX3>
  <TEXT>DERMATOLOGIA&#13;
<EVENT eid="e1" class="OCCURRENCE">OSPITALERATZEKO</EVENT> ARRAZOIA&#13;
Larruazaleko <EVENT eid="e2" class="OCCURRENCE">lesioak</EVENT> dituen 58 urteko emakumea.&#13;
AURREKARIAK&#13;
Ez die farmakoei <EVENT eid="e3" class="OCCURRENCE">alergiarik</EVENT>.&#13;
<EVENT eid="e4" class="OCCURRENCE">HTA</EVENT> eta <EVENT eid="e5" class="OCCURRENCE">hiperkolesterolemia</EVENT>.&#13;
<EVENT eid="e6" class="OCCURRENCE">Tratamendua</EVENT>: <EVENT eid="e7" class="OCCURRENCE">sinbastatina</EVENT>, <EVENT eid="e8" class="OCCURRENCE">enalapril</EVENT>/hidroklorotiazida.&#13;
<TIMEX3 tid="t1" type="DATE" value="PRESENT_REF" temporalFunction="true">EGUNGO</TIMEX3> HISTORIA&#13;
<TIMEX3 tid="t2" type="DURATION" value="P10D" temporalFunction="false">Duela 10 egun</TIMEX3> gorputz-enborrean larruazaleko <EVENT eid="e9" class="OCCURRENCE">lesioak</EVENT> <EVENT eid="e10" class="OCCURRENCE">agertu</EVENT> zitzaizkion.&#13;
Gorputz-adarretara <EVENT eid="e11" class="OCCURRENCE">zabaldu</EVENT> zaizkio eta <EVENT eid="e12" class="OCCURRENCE">azkura</EVENT> du.&#13;
<TIMEX3 tid="t3" type="DURATION" value="PXD" temporalFunction="true">Egun batzuk</TIMEX3> lehenago, haginetako <EVENT eid="e13" class="OCCURRENCE">infekzio</EVENT> bat <EVENT eid="e14" class="OCCURRENCE">tratatzeko</EVENT>, <EVENT eid="e15" class="OCCURRENCE">amoxizilina</EVENT> hartu zuen.&#13;
<EVENT eid="e16" class="OCCURRENCE">AZTERKETA</EVENT> FISIKOA&#13;
<EVENT eid="e17" class="OCCURRENCE">Tenperatura</EVENT>: 36,5 °C.&#13;
<EVENT eid="e18" class="OCCURRENCE">Egoera</EVENT> orokor ona du.&#13;
Azaleko <EVENT eid="e19" class="OCCURRENCE" comment="e3c:permanence=FINITE">lesioak</EVENT>.&#13;
Lesioen <EVENT eid="e20" class="OCCURRENCE" comment="e3c:permanence=FINITE">tankera</EVENT>, <EVENT eid="e21" class="OCCURRENCE" comment="e3c:permanence=FINITE">kokapena</EVENT> eta <EVENT eid="e22" class="OCCURRENCE" comment="e3c:permanence=FINITE">banaketa</EVENT>: simetrikoki enbor eta gorputz-adarretan <EVENT eid="e23" class="OCCURRENCE" comment="e3c:permanence=FINITE">exantema</EVENT> makulopapulosorako joera <EVENT eid="e24" class="REPORTING" comment="e3c:permanence=FINITE">ikusten</EVENT> zaien <EVENT eid="e25" class="OCCURRENCE" comment="e3c:permanence=FINITE">lesioak</EVENT>.&#13;
Ez dago <EVENT eid="e26" class="OCCURRENCE" comment="e3c:permanence=FINITE">lesiorik</EVENT> ahoko mukosan, esku-ahurretan eta oinetan.&#13;
<EVENT eid="e27" class="OCCURRENCE" comment="e3c:permanence=FINITE">DIAGNOSTIKO</EVENT> NAGUSIA&#13;
<EVENT eid="e28" class="OCCURRENCE" comment="e3c:permanence=FINITE">Toxikodermia</EVENT> morbiliformea.&#13;
<EVENT eid="e29" class="OCCURRENCE" comment="e3c:permanence=FINITE">TRATAMENDUA</EVENT>&#13;
Medikamentu susmagarria <EVENT eid="e30" class="OCCURRENCE" comment="e3c:permanence=FINITE">hartzeari</EVENT> <EVENT eid="e31" class="ASPECTUAL" comment="e3c:permanence=FINITE">utzi</EVENT>.&#13;
<EVENT eid="e32" class="OCCURRENCE" comment="e3c:permanence=FINITE">Loratadina</EVENT> hartu <TIMEX3 tid="t4" type="SET" value="P1D" temporalFunction="true">goizean</TIMEX3> eta <TIMEX3 tid="t5" type="SET" value="P1D" temporalFunction="true">eguerdian</TIMEX3>.&#13;
Atarax ® <EVENT eid="e33" class="OCCURRENCE" comment="e3c:permanence=FINITE">konprimituak</EVENT> hartu <TIMEX3 tid="t6" type="SET" value="P1D" temporalFunction="true">gauean</TIMEX3>.&#13;
Elocom ® (mometasona furoatoa) <EVENT eid="e34" class="OCCURRENCE" comment="e3c:permanence=FINITE">krema</EVENT>, <EVENT eid="e35" class="OCCURRENCE" comment="e3c:permanence=FINITE">geruza</EVENT> fin bat eman, ondo <EVENT eid="e36" class="OCCURRENCE" comment="e3c:permanence=FINITE">zabaldu</EVENT>, eta utzi <EVENT eid="e37" class="OCCURRENCE" comment="e3c:permanence=FINITE">desagertzen</EVENT> pixkanaka.&#13;
BESTE <EVENT eid="e38" class="OCCURRENCE" comment="e3c:permanence=FINITE">GOMENDIO</EVENT> BATZUK&#13;
Ez hartu <EVENT eid="e39" class="OCCURRENCE" comment="e3c:permanence=FINITE">amoxizilina</EVENT> gehiagorik.</TEXT>
