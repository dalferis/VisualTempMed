<?xml version="1.0" encoding="UTF-8"?>
<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2008-10-03T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2008-10-03</TIMEX3>
  <TEXT>25 hilabete. <TIMEX3 tid="t1" type="DURATION" value="P2DT12H" temporalFunction="false">2-3 eguneko</TIMEX3> <EVENT eid="e1" class="OCCURRENCE" comment="e3c:permanence=FINITE">sukarra</EVENT>, <EVENT eid="e2" class="OCCURRENCE" comment="e3c:permanence=FINITE">katarroa</EVENT> eta <EVENT eid="e3" class="OCCURRENCE" comment="e3c:permanence=FINITE">ondoeza</EVENT>. <EVENT eid="e4" class="OCCURRENCE" comment="e3c:permanence=FINITE">Barizela</EVENT> izan zuen <TIMEX3 tid="t2" type="DURATION" value="P1M" temporalFunction="false">hilabete</TIMEX3> lehenago, eta ondoren, <TIMEX3 tid="t3" type="DURATION" value="P7D" temporalFunction="false">zazpi egunez</TIMEX3> <EVENT eid="e5" class="OCCURRENCE" comment="e3c:permanence=FINITE">antibiotikoarekin</EVENT> tratatutako <EVENT eid="e6" class="OCCURRENCE" comment="e3c:permanence=FINITE">eskarlatina</EVENT>. <EVENT eid="e7" class="OCCURRENCE" comment="e3c:permanence=FINITE">Miaketa</EVENT> fisikoa: <EVENT eid="e8" class="OCCURRENCE" comment="e3c:permanence=FINITE">ondoeza</EVENT>, <EVENT eid="e9" class="OCCURRENCE" comment="e3c:permanence=FINITE">perfusio</EVENT> txarra. Arnas <EVENT eid="e10" class="OCCURRENCE" comment="e3c:permanence=FINITE">zailtasuna</EVENT>. <EVENT eid="e11" class="OCCURRENCE" comment="e3c:permanence=FINITE">Hipobentilazioa</EVENT> eskuin hemitoraxean. <EVENT eid="e12" class="OCCURRENCE" comment="e3c:permanence=FINITE">Azterketa</EVENT> osagarriak. <EVENT eid="e13" class="OCCURRENCE" comment="e3c:permanence=FINITE">Biokimika</EVENT>. <EVENT eid="e14" class="OCCURRENCE" comment="e3c:permanence=FINITE">Sodioa</EVENT> 129 mEq/L, <EVENT eid="e15" class="OCCURRENCE" comment="e3c:permanence=FINITE">PCR</EVENT> 279 mg/dL <EVENT eid="e16" class="OCCURRENCE" comment="e3c:permanence=FINITE">Osm</EVENT> 267 mmol/kg. <EVENT eid="e17" class="OCCURRENCE" comment="e3c:permanence=FINITE">Hemograma</EVENT>: <EVENT eid="e18" class="OCCURRENCE" comment="e3c:permanence=FINITE">leukozitoak</EVENT> 6000/mm3 (<EVENT eid="e19" class="OCCURRENCE" comment="e3c:permanence=FINITE">N</EVENT>%85, <EVENT eid="e20" class="OCCURRENCE" comment="e3c:permanence=FINITE">L</EVENT> %9, <EVENT eid="e21" class="OCCURRENCE" comment="e3c:permanence=FINITE">C</EVENT> %5). <EVENT eid="e22" class="OCCURRENCE" comment="e3c:permanence=FINITE">Hemokultiboa</EVENT>: negatiboa. <EVENT eid="e23" class="OCCURRENCE" comment="e3c:permanence=FINITE">Likido</EVENT> pleurala: <EVENT eid="e24" class="OCCURRENCE" comment="e3c:permanence=FINITE">pH</EVENT> 6,83, <EVENT eid="e25" class="OCCURRENCE" comment="e3c:permanence=FINITE">zelulak</EVENT> 56.000/mm3 (<EVENT eid="e26" class="OCCURRENCE" comment="e3c:permanence=FINITE">N</EVENT> %89, <EVENT eid="e27" class="OCCURRENCE" comment="e3c:permanence=FINITE">L</EVENT> %1). Likidoaren <EVENT eid="e28" class="OCCURRENCE" comment="e3c:permanence=FINITE">kultiboa</EVENT>: SBA. Eztarri <EVENT eid="e29" class="OCCURRENCE" comment="e3c:permanence=FINITE">exudatua</EVENT>: SBA. Bularraldeko <EVENT eid="e30" class="OCCURRENCE" comment="e3c:permanence=FINITE">erradiografia</EVENT>: eskuineko erdi eta behe-gingilean <EVENT eid="e31" class="OCCURRENCE" comment="e3c:permanence=FINITE">pneumonia</EVENT> eta <EVENT eid="e32" class="OCCURRENCE" comment="e3c:permanence=FINITE">isuri</EVENT> pleurala. Bularraldeko <EVENT eid="e33" class="OCCURRENCE" comment="e3c:permanence=FINITE">ekografia</EVENT>: &gt; 4 cm-tako <EVENT eid="e34" class="OCCURRENCE" comment="e3c:permanence=FINITE">derramea</EVENT> eskuinaldean. <EVENT eid="e35" class="OCCURRENCE" comment="e3c:permanence=FINITE">Eboluzioa</EVENT>: bularraldean <EVENT eid="e36" class="OCCURRENCE" comment="e3c:permanence=FINITE">hodiak</EVENT> jarri eta etengabeko <EVENT eid="e37" class="OCCURRENCE" comment="e3c:permanence=FINITE">drainadura</EVENT> aspiratiboaren bidez <EVENT eid="e38" class="OCCURRENCE" comment="e3c:permanence=FINITE">isuri</EVENT> pleurala <EVENT eid="e39" class="OCCURRENCE" comment="e3c:permanence=FINITE">atera</EVENT> genuen, urokinasaren <EVENT eid="e40" class="OCCURRENCE" comment="e3c:permanence=FINITE">laguntzaz</EVENT>. <EVENT eid="e41" class="OCCURRENCE" comment="e3c:permanence=FINITE">Tratamendu</EVENT> antibiotikoa <EVENT eid="e42" class="OCCURRENCE" comment="e3c:permanence=FINITE">Clindamicina</EVENT> eta <EVENT eid="e43" class="OCCURRENCE" comment="e3c:permanence=FINITE">penizilina</EVENT> G sodikoaz osatu genuen. <TIMEX3 tid="t4" type="DURATION" value="PXD" temporalFunction="true">Lehen egunetan</TIMEX3> <EVENT eid="e44" class="OCCURRENCE" comment="e3c:permanence=FINITE">SIADH-a</EVENT> egin zuen, baina likido <EVENT eid="e45" class="OCCURRENCE" comment="e3c:permanence=FINITE">mugaketekin</EVENT> <EVENT eid="e46" class="OCCURRENCE" comment="e3c:permanence=FINITE">zuzendu</EVENT> genuen. Era berean, koagulazio <EVENT eid="e47" class="OCCURRENCE" comment="e3c:permanence=FINITE">alterazioa</EVENT> zela eta, K bitamina <EVENT eid="e48" class="OCCURRENCE" comment="e3c:permanence=FINITE">dosi</EVENT> bat eman genion. <EVENT eid="e49" class="OCCURRENCE" comment="e3c:permanence=FINITE">Sukarra</EVENT> <EVENT eid="e50" class="OCCURRENCE" comment="e3c:permanence=FINITE">jaitsi</EVENT> <TIMEX3 tid="t5" type="DURATION" value="PT60H" temporalFunction="false">ondorengo 48-72 orduetan</TIMEX3>, <EVENT eid="e51" class="OCCURRENCE" comment="e3c:permanence=FINITE">antibiotikoak</EVENT> ahoz eman genizkion. Ez zuen gainontzeko <EVENT eid="e52" class="OCCURRENCE" comment="e3c:permanence=FINITE">konplikaziorik</EVENT> izan.</TEXT>
