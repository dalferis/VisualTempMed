<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2015-04-24T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2015-04-24</TIMEX3>
  <TEXT><EVENT eid="e1" class="OCCURRENCE" comment="e3c:permanence=FINITE">KONTSULTAREN</EVENT> ARRAZOIA&#13;
Larrialdietara <EVENT eid="e2" class="OCCURRENCE" comment="e3c:permanence=FINITE">datorren</EVENT> 80 urteko gizonezkoa; <TIMEX3 tid="t1" type="DURATION" value="P1W" temporalFunction="false">astebeteko</TIMEX3> iraupeneko <EVENT eid="e3" class="OCCURRENCE" comment="e3c:permanence=FINITE">astenia</EVENT> gogorreko koadroa, <EVENT eid="e4" class="OCCURRENCE" comment="e3c:permanence=FINITE">hematoma</EVENT> garrantzitsua beheko gorputz-adarrean eta odol gorriaren <EVENT eid="e5" class="OCCURRENCE" comment="e3c:permanence=FINITE">arrastoak</EVENT> eginkarietan dira ingresuko <EVENT eid="e6" class="OCCURRENCE" comment="e3c:permanence=FINITE">sintomarik</EVENT> aipagarrienak, <EVENT eid="e7" class="OCCURRENCE" comment="e3c:permanence=FINITE">INR</EVENT> maila altuekin batera.&#13;
<EVENT eid="e8" class="OCCURRENCE" comment="e3c:permanence=FINITE">AURREKARI</EVENT> PERTSONALAK&#13;
-Ez dauka farmakoekiko <EVENT eid="e9" class="OCCURRENCE" comment="e3c:permanence=FINITE">alergia</EVENT> ezagunik ezta <EVENT eid="e10" class="OCCURRENCE" comment="e3c:permanence=FINITE">aztura</EVENT> toxikorik ere.&#13;
-<EVENT eid="e11" class="OCCURRENCE" comment="e3c:permanence=FINITE">HTA</EVENT>, <EVENT eid="e12" class="OCCURRENCE" comment="e3c:permanence=FINITE">DM</EVENT> <EVENT eid="e13" class="OCCURRENCE" comment="e3c:permanence=FINITE">tratamendu</EVENT> dietetikoan, <EVENT eid="e14" class="OCCURRENCE" comment="e3c:permanence=FINITE">dislipemiarik</EVENT> ez.&#13;
-<EVENT eid="e15" class="OCCURRENCE" comment="e3c:permanence=FINITE">Fibrilazio</EVENT> aurikularrak eragindako erabateko <EVENT eid="e16" class="OCCURRENCE" comment="e3c:permanence=FINITE">arritmia</EVENT>. &#13;
<EVENT eid="e17" class="OCCURRENCE" comment="e3c:permanence=FINITE">Kardiopatia</EVENT> iskemiko kronikoa. &#13;
Miokardioko <EVENT eid="e18" class="OCCURRENCE" comment="e3c:permanence=FINITE">infartu</EVENT> akutua (<EVENT eid="e19" class="OCCURRENCE" comment="e3c:permanence=FINITE">MIA</EVENT>) <TIMEX3 tid="t2" type="DATE" value="2000" temporalFunction="false">2000. urtean</TIMEX3>, eta azalean zeharreko <EVENT eid="e20" class="OCCURRENCE" comment="e3c:permanence=FINITE">angioplastia</EVENT> koronario transluminalarekin (AAKTrekin) 2 <EVENT eid="e21" class="OCCURRENCE" comment="e3c:permanence=FINITE">stent</EVENT> ezarri zitzaizkion. &#13;
Bihotz-gutxiegitasuneko hainbat <EVENT eid="e22" class="OCCURRENCE" comment="e3c:permanence=FINITE">gertaera</EVENT>.&#13;
-<EVENT eid="e23" class="STATE" comment="e3c:permanence=PERMANENT">BGBK</EVENT> (biriketako <EVENT eid="e24" class="STATE" comment="e3c:permanence=PERMANENT">gaixotasun</EVENT> buxatzaile kronikoa).&#13;
-Giltzurruneko <EVENT eid="e25" class="STATE" comment="e3c:permanence=PERMANENT">gutxiegitasun</EVENT> kronikoa, 4. mailakoa. &#13;
<EVENT eid="e26" class="STATE" comment="e3c:permanence=PERMANENT">Hiperparatiroidismo</EVENT> sekundarioa. &#13;
<EVENT eid="e27" class="STATE" comment="e3c:permanence=PERMANENT">Osteoporosia</EVENT>.&#13;
-Prostatako <EVENT eid="e28" class="OCCURRENCE" comment="e3c:permanence=FINITE">hipertrofia</EVENT> onbera. &#13;
Prostatako <EVENT eid="e29" class="OCCURRENCE" comment="e3c:permanence=FINITE">adenoma</EVENT>.&#13;
-<TIMEX3 tid="t3" type="DATE" value="2011" temporalFunction="false">2011. urtean</TIMEX3> Hematologiako Zerbitzuan <EVENT eid="e30" class="OCCURRENCE" comment="e3c:permanence=FINITE">baloratua</EVENT>, <EVENT eid="e31" class="OCCURRENCE" comment="e3c:permanence=FINITE">tronbopenia</EVENT> arinagatik; geroztik ez du beste <EVENT eid="e32" class="OCCURRENCE" comment="e3c:permanence=FINITE">kontrolik</EVENT> izan.&#13;
-Oinarrizko <EVENT eid="e33" class="OCCURRENCE" comment="e3c:permanence=FINITE">egoera</EVENT> funtzionala (<EVENT eid="e34" class="OCCURRENCE" comment="e3c:permanence=FINITE">OEF</EVENT>): Ez dauka ezagutzako <EVENT eid="e35" class="OCCURRENCE" comment="e3c:permanence=FINITE">narriadurarik</EVENT>. &#13;
Bere kasa <EVENT eid="e36" class="OCCURRENCE" comment="e3c:permanence=FINITE">moldatzen</EVENT> da <TIMEX3 tid="t4" type="SET" value="P1D" temporalFunction="true">eguneroko</TIMEX3> bizitzako <EVENT eid="e37" class="OCCURRENCE" comment="e3c:permanence=FINITE">jardueretan</EVENT>, eta makila baten <EVENT eid="e38" class="OCCURRENCE" comment="e3c:permanence=FINITE">laguntza</EVENT> behar du <EVENT eid="e39" class="OCCURRENCE" comment="e3c:permanence=FINITE">ibiltzeko</EVENT>.&#13;
-Ohiko <EVENT eid="e40" class="OCCURRENCE" comment="e3c:permanence=FINITE">tratamendua</EVENT>: <EVENT eid="e41" class="OCCURRENCE" comment="e3c:permanence=FINITE">Omeprazola</EVENT>; <EVENT eid="e42" class="OCCURRENCE" comment="e3c:permanence=FINITE">Carbedilola</EVENT>; <EVENT eid="e43" class="OCCURRENCE" comment="e3c:permanence=FINITE">Rocaltrola</EVENT>; <EVENT eid="e44" class="OCCURRENCE" comment="e3c:permanence=FINITE">Furosemida</EVENT>; <EVENT eid="e45" class="OCCURRENCE" comment="e3c:permanence=FINITE">Atorbastatina</EVENT>; <EVENT eid="e46" class="OCCURRENCE" comment="e3c:permanence=FINITE">Dutasterida</EVENT>/Tamsulosina; <EVENT eid="e47" class="OCCURRENCE" comment="e3c:permanence=FINITE">Alopurinola</EVENT>; <EVENT eid="e48" class="OCCURRENCE" comment="e3c:permanence=FINITE">Spiriva</EVENT>; <EVENT eid="e49" class="OCCURRENCE" comment="e3c:permanence=FINITE">Simtrona</EVENT>.&#13;
<EVENT eid="e50" class="OCCURRENCE" comment="e3c:permanence=FINITE">MIAKETA</EVENT> FISIKOA&#13;
<EVENT eid="e51" class="OCCURRENCE" comment="e3c:permanence=FINITE">TA</EVENT>: 140/70; <EVENT eid="e52" class="OCCURRENCE" comment="e3c:permanence=FINITE">Bihotz-maiztasuna</EVENT>: 89 tau/min; <EVENT eid="e53" class="OCCURRENCE" comment="e3c:permanence=FINITE">Tª</EVENT> 36,5 ºC; <EVENT eid="e54" class="OCCURRENCE" comment="e3c:permanence=FINITE">O2Sat</EVENT>.: % 97&#13;
<EVENT eid="e55" class="OCCURRENCE" comment="e3c:permanence=FINITE">Kontziente</EVENT> eta <EVENT eid="e56" class="OCCURRENCE" comment="e3c:permanence=FINITE">orientatua</EVENT> dago, ondo <EVENT eid="e57" class="OCCURRENCE" comment="e3c:permanence=FINITE">hidratatua</EVENT> eta <EVENT eid="e58" class="OCCURRENCE" comment="e3c:permanence=FINITE">perfunditua</EVENT>, azal eta mukosetako <EVENT eid="e59" class="OCCURRENCE" comment="e3c:permanence=FINITE">zurbiltasunarekin</EVENT>.&#13;
<EVENT eid="e60" class="OCCURRENCE" comment="e3c:permanence=FINITE">Hematoma</EVENT> ugari <EVENT eid="e61" class="REPORTING" comment="e3c:permanence=FINITE">ikusten</EVENT> dira goiko gorputz-adarretan, ezkerreko hemitoraxean, barrabil-zorroan, eskuin-iztondoan eta eskuineko zangoan.&#13;
Burua eta lepoaldea: begietako <EVENT eid="e62" class="OCCURRENCE" comment="e3c:permanence=FINITE">ikterizia</EVENT>. &#13;
Ez <EVENT eid="e63" class="OCCURRENCE" comment="e3c:permanence=FINITE">adenopatiarik</EVENT>, ez <EVENT eid="e64" class="OCCURRENCE" comment="e3c:permanence=FINITE">boziorik</EVENT>.&#13;
BULARRALDEA: Bihotzaren <EVENT eid="e65" class="OCCURRENCE" comment="e3c:permanence=FINITE">auskultazioa</EVENT>: <EVENT eid="e66" class="OCCURRENCE" comment="e3c:permanence=FINITE">erritmikoa</EVENT>, <EVENT eid="e67" class="OCCURRENCE" comment="e3c:permanence=FINITE">murmuriorik</EVENT> gabe. &#13;
Biriken <EVENT eid="e68" class="OCCURRENCE" comment="e3c:permanence=FINITE">auskultazioa</EVENT>: <EVENT eid="e69" class="OCCURRENCE" comment="e3c:permanence=FINITE">krepitatzaileak</EVENT>, bi oinaldeetan.&#13;
SABELALDEA: <EVENT eid="e70" class="OCCURRENCE" comment="e3c:permanence=FINITE">biguna</EVENT>, <EVENT eid="e71" class="OCCURRENCE" comment="e3c:permanence=FINITE">zanpagarria</EVENT>. &#13;
<EVENT eid="e72" class="OCCURRENCE" comment="e3c:permanence=FINITE">Haztapenean</EVENT> ez du <EVENT eid="e73" class="OCCURRENCE" comment="e3c:permanence=FINITE">minik</EVENT> <EVENT eid="e74" class="REPORTING" comment="e3c:permanence=FINITE">sentitzen</EVENT>, ez da <EVENT eid="e75" class="OCCURRENCE" comment="e3c:permanence=FINITE">masarik</EVENT> ezta <EVENT eid="e76" class="OCCURRENCE" comment="e3c:permanence=FINITE">megaliarik</EVENT> ere <EVENT eid="e77" class="OCCURRENCE" comment="e3c:permanence=FINITE">antzematen</EVENT>, eta hesteetako <EVENT eid="e78" class="OCCURRENCE" comment="e3c:permanence=FINITE">hotsak</EVENT> <EVENT eid="e79" class="OCCURRENCE" comment="e3c:permanence=FINITE">presente</EVENT> daude. &#13;
Giltzurruneko <EVENT eid="e80" class="OCCURRENCE" comment="e3c:permanence=FINITE">ukabil-perkusioa</EVENT> negatiboa da alde bietan.&#13;
BEHEKO GORPUTZ-ADARRAK: eskuineko zangoan tibia aurreko <EVENT eid="e81" class="OCCURRENCE" comment="e3c:permanence=FINITE">edema</EVENT> arinak <EVENT eid="e82" class="OCCURRENCE" comment="e3c:permanence=FINITE">ikusten</EVENT> dira, <EVENT eid="e83" class="OCCURRENCE" comment="e3c:permanence=FINITE">fobearekin</EVENT>. &#13;
<EVENT eid="e84" class="OCCURRENCE" comment="e3c:permanence=FINITE">Pultsu</EVENT> femoralak eta <EVENT eid="e85" class="OCCURRENCE" comment="e3c:permanence=FINITE">pedioak</EVENT> <EVENT eid="e86" class="OCCURRENCE" comment="e3c:permanence=FINITE">presente</EVENT> daude eta <EVENT eid="e87" class="OCCURRENCE" comment="e3c:permanence=FINITE">simetrikoak</EVENT> dira.&#13;
<EVENT eid="e88" class="OCCURRENCE" comment="e3c:permanence=FINITE">ONDESTE-HAZTAPENA</EVENT>. &#13;
ez dago <EVENT eid="e89" class="OCCURRENCE" comment="e3c:permanence=FINITE">kanpo-hemorroiderik</EVENT>. &#13;
Hatz-punta kolore normaleko eginkariz <EVENT eid="e90" class="OCCURRENCE" comment="e3c:permanence=FINITE">zikindua</EVENT>, <EVENT eid="e91" class="OCCURRENCE" comment="e3c:permanence=FINITE">odol-arrastorik</EVENT> gabe.&#13;
<EVENT eid="e92" class="OCCURRENCE" comment="e3c:permanence=FINITE">PROBA</EVENT> OSAGARRIAK&#13;
-<EVENT eid="e93" class="OCCURRENCE" comment="e3c:permanence=FINITE">Biokimika</EVENT>: <EVENT eid="e94" class="OCCURRENCE" comment="e3c:permanence=FINITE">urea</EVENT>: 144 mg/dL; <EVENT eid="e95" class="OCCURRENCE" comment="e3c:permanence=FINITE">kreatinina</EVENT>: 3 mg/dL; <EVENT eid="e96" class="OCCURRENCE" comment="e3c:permanence=FINITE">bilirrubina</EVENT> totala: 2,3 mg/dL; <EVENT eid="e97" class="OCCURRENCE" comment="e3c:permanence=FINITE">GPT</EVENT>: 9 U/L; <EVENT eid="e98" class="OCCURRENCE" comment="e3c:permanence=FINITE">CK</EVENT>: 38 U/L; <EVENT eid="e99" class="OCCURRENCE" comment="e3c:permanence=FINITE">LDH</EVENT>: 150 U/L; <EVENT eid="e100" class="OCCURRENCE" comment="e3c:permanence=FINITE">PCR</EVENT>: 9,43 mg/dL.&#13;
-<EVENT eid="e101" class="OCCURRENCE" comment="e3c:permanence=FINITE">Hemograma</EVENT>: <EVENT eid="e102" class="OCCURRENCE" comment="e3c:permanence=FINITE">hemoglobina</EVENT>: 6,5 g/dL; <EVENT eid="e103" class="OCCURRENCE" comment="e3c:permanence=FINITE">BBK</EVENT> (batez besteko <EVENT eid="e104" class="OCCURRENCE" comment="e3c:permanence=FINITE">bolumen</EVENT> korpuskularra): 112, 9 fL; <EVENT eid="e105" class="OCCURRENCE" comment="e3c:permanence=FINITE">plaketak</EVENT>: 135.000; <EVENT eid="e106" class="OCCURRENCE" comment="e3c:permanence=FINITE">leukozitoak</EVENT>: 12.900 (<EVENT eid="e107" class="OCCURRENCE" comment="e3c:permanence=FINITE">neutrofiloak</EVENT>, <EVENT eid="e108" class="OCCURRENCE" comment="e3c:permanence=FINITE">N</EVENT>: % 76; <EVENT eid="e109" class="OCCURRENCE" comment="e3c:permanence=FINITE">linfozitoak</EVENT>, <EVENT eid="e110" class="OCCURRENCE" comment="e3c:permanence=FINITE">L</EVENT>: % 16; <EVENT eid="e111" class="OCCURRENCE" comment="e3c:permanence=FINITE">monozitoak</EVENT>, <EVENT eid="e112" class="OCCURRENCE" comment="e3c:permanence=FINITE">M</EVENT>: % 7,5; <EVENT eid="e113" class="OCCURRENCE" comment="e3c:permanence=FINITE">eosinofiloak</EVENT>, <EVENT eid="e114" class="OCCURRENCE" comment="e3c:permanence=FINITE">E</EVENT>: % 0,4; <EVENT eid="e115" class="OCCURRENCE" comment="e3c:permanence=FINITE">basofiloak</EVENT>, <EVENT eid="e116" class="OCCURRENCE" comment="e3c:permanence=FINITE">B</EVENT>: % 0,2).&#13;
-<EVENT eid="e117" class="OCCURRENCE" comment="e3c:permanence=FINITE">Koagulazioa</EVENT>: <EVENT eid="e118" class="OCCURRENCE" comment="e3c:permanence=FINITE">protronbina-indizea</EVENT>: % 16; nazioarteko <EVENT eid="e119" class="OCCURRENCE" comment="e3c:permanence=FINITE">ratio</EVENT> normalizatua (<EVENT eid="e120" class="OCCURRENCE" comment="e3c:permanence=FINITE">INR</EVENT>): 4,81; <EVENT eid="e121" class="OCCURRENCE" comment="e3c:permanence=FINITE">TTPA</EVENT> &gt; 180 s.&#13;
</TEXT>
