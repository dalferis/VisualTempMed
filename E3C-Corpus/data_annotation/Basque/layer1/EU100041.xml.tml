<?xml version="1.0" encoding="UTF-8"?>
<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2014-12-31T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2014-12-31</TIMEX3>
  <TEXT>LEHEN MAILAKO ARRETAKO ALTA TXOSTENA&#13;
<EVENT eid="e1" class="OCCURRENCE">AURREKARIAK</EVENT>&#13;
Farmakoekiko <EVENT eid="e2" class="OCCURRENCE">alergiarik</EVENT> ez; <EVENT eid="e3" class="OCCURRENCE">edale</EVENT> moderatua.&#13;
<EVENT eid="e4" class="OCCURRENCE">Gizentasuna</EVENT>, <EVENT eid="e5" class="OCCURRENCE">fibrilazio</EVENT> aurikular paroxistikoa (antikoagulatua); lipidoen metabolismoaren <EVENT eid="e6" class="OCCURRENCE">asaldura</EVENT>; <EVENT eid="e7" class="OCCURRENCE">hiperurizemia</EVENT>, transaminasen <EVENT eid="e8" class="OCCURRENCE">igoera</EVENT>; <EVENT eid="e9" class="STATE">artrosia</EVENT>.&#13;
ARTATURIKO <EVENT eid="e10" class="OCCURRENCE">GERTAKARIEN</EVENT> LABURPENA&#13;
<TIMEX3 tid="t1" type="DURATION" value="PXD" temporalFunction="true">Egunotan</TIMEX3> esfortzuetarako <EVENT eid="e11" class="OCCURRENCE">arnasestua</EVENT> du, eta <EVENT eid="e12" class="OCCURRENCE">ortopnea</EVENT> puntua (burko bi <EVENT eid="e13" class="OCCURRENCE">erabiltzen</EVENT> ditu); <EVENT eid="e14" class="OCCURRENCE">oliguria</EVENT> beharbada.&#13;
Bularraldeko <EVENT eid="e15" class="OCCURRENCE">minik</EVENT> ez, beheko adarretako <EVENT eid="e16" class="OCCURRENCE">edemarik</EVENT> ez, <EVENT eid="e17" class="OCCURRENCE">eztulik</EVENT> ez, <EVENT eid="e18" class="OCCURRENCE">sukarrik</EVENT> ez.&#13;
<EVENT eid="e19" class="OCCURRENCE">Egarri</EVENT> da.&#13;
<EVENT eid="e20" class="OCCURRENCE">Azterketan</EVENT>, <EVENT eid="e21" class="OCCURRENCE">itxura</EVENT> ona, <EVENT eid="e22" class="OCCURRENCE">eupneikoa</EVENT>.&#13;
<EVENT eid="e23" class="OCCURRENCE">Saturazioa</EVENT>,% 92-93.&#13;
Lepoan <EVENT eid="e24" class="OCCURRENCE">pletorarik</EVENT> ez.&#13;
Bihotzeko <EVENT eid="e25" class="OCCURRENCE">auskultazioa</EVENT>: <EVENT eid="e26" class="OCCURRENCE">takikardia</EVENT>, <EVENT eid="e27" class="OCCURRENCE">erritmo</EVENT> irregularra, <EVENT eid="e28" class="OCCURRENCE">murmuriorik</EVENT> ez.&#13;
Biriketako <EVENT eid="e29" class="OCCURRENCE">auskultazioa</EVENT>: <EVENT eid="e30" class="OCCURRENCE">aireztapen</EVENT> orokorra normala eta aldebiko oinaldeetan <EVENT eid="e31" class="OCCURRENCE">krepitatzaileak</EVENT>.&#13;
<EVENT eid="e32" class="OCCURRENCE">Iritzi</EVENT> diagnostikoa: BIHOTZ <EVENT eid="e33" class="OCCURRENCE">GUTXIEGITASUNA</EVENT>.&#13;
<EVENT eid="e34" class="OCCURRENCE">PROBA</EVENT> OSAGARRIEN LABURPENA&#13;
TORAXEKO <EVENT eid="e35" class="OCCURRENCE">ERRADIOGRAFIA</EVENT>.&#13;
<EVENT eid="e36" class="OCCURRENCE">Kardiomegalia</EVENT> eta eskuinaldeko pleurako <EVENT eid="e37" class="OCCURRENCE">isuria</EVENT>.&#13;
ODOL <EVENT eid="e38" class="OCCURRENCE">ANALISIETAN</EVENT>, <EVENT eid="e39" class="OCCURRENCE">hipergluzemia</EVENT> (<EVENT eid="e40" class="OCCURRENCE">glukosa</EVENT> 129 mg/dL), <EVENT eid="e41" class="OCCURRENCE">hipertransaminasemia</EVENT> (<TIMEX3 tid="t2" type="DATE" value="PAST_REF" temporalFunction="true">aspaldi</TIMEX3> <EVENT eid="e42" class="OCCURRENCE">ezaguna</EVENT>).&#13;
<EVENT eid="e43" class="OCCURRENCE">BNP</EVENT> 277 pg/mL.&#13;
<EVENT eid="e44" class="OCCURRENCE">ELEKTROKARDIOGRAMA</EVENT>. &#13;
<EVENT eid="e45" class="OCCURRENCE">fibrilazio</EVENT> aurikularra (aurrenekoan, eskuin-adarraren <EVENT eid="e46" class="OCCURRENCE">blokeo</EVENT> osoa).&#13;
<EVENT eid="e47" class="OCCURRENCE">EBOLUZIOA</EVENT> ETA <EVENT eid="e48" class="OCCURRENCE">IRUZKINAK</EVENT>&#13;
<EVENT eid="e49" class="OCCURRENCE">Furosemida</EVENT> (<EVENT eid="e50" class="OCCURRENCE">gosaldu</EVENT> ostean eta bazkalostean) hartuz geroztik, askoz <EVENT eid="e51" class="OCCURRENCE">hobeto</EVENT>.&#13;
<TIMEX3 tid="t3" type="DATE" value="PRESENT_REF" temporalFunction="true">Orain</TIMEX3> <EVENT eid="e52" class="OCCURRENCE">arnasesturik</EVENT> ez.&#13;
Biriketako <EVENT eid="e53" class="OCCURRENCE">auskultazioan</EVENT>, oinaldeetan <EVENT eid="e54" class="OCCURRENCE">krepitatzailerik</EVENT> ez.&#13;
Kardiologoarengana <EVENT eid="e55" class="OCCURRENCE">bideratu</EVENT> dut, <EVENT eid="e56" class="OCCURRENCE">ekokardiograma</EVENT> egiteko.&#13;
Bitartean, <EVENT eid="e57" class="OCCURRENCE">furosemida</EVENT> 40 mg 1 <TIMEX3 tid="t4" type="SET" value="P1D" temporalFunction="true">egunean</TIMEX3>, eta <EVENT eid="e58" class="OCCURRENCE">enalapril</EVENT> 5 mg 1 <TIMEX3 tid="t5" type="SET" value="P1D" temporalFunction="true">egunean</TIMEX3>.&#13;
<EVENT eid="e59" class="OCCURRENCE">TRATAMENDUA</EVENT>&#13;
<EVENT eid="e60" class="OCCURRENCE">Furosemida</EVENT> 40 mg 1 <TIMEX3 tid="t6" type="SET" value="P1D" temporalFunction="true">egunean</TIMEX3>&#13;
<EVENT eid="e61" class="OCCURRENCE">Enalapril</EVENT> 5mg 1 <TIMEX3 tid="t7" type="SET" value="P1D" temporalFunction="true">egunean</TIMEX3>&#13;
BESTELAKO <EVENT eid="e62" class="OCCURRENCE">GOMENDIOAK</EVENT>&#13;
Pisua <EVENT eid="e63" class="OCCURRENCE">galdu</EVENT>.&#13;
<EVENT eid="e64" class="OCCURRENCE">Alkoholik</EVENT> ez.&#13;
</TEXT>
