<?xml version="1.0" encoding="UTF-8"?>
<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2017-05-19T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2017-05-19</TIMEX3>
  <TEXT><EVENT eid="e1" class="OCCURRENCE">KONTSULTAZEKO</EVENT> ARRAZOIA:&#13;
49 urteko emakumea, <EVENT eid="e2" class="OCCURRENCE">sukarra</EVENT> eta eskuineko hipokondrioko <EVENT eid="e3" class="OCCURRENCE">minarengatik</EVENT> <EVENT eid="e4" class="OCCURRENCE">etorria</EVENT>.&#13;
<EVENT eid="e5" class="OCCURRENCE">AURREKARI</EVENT> PERTSONALAK:&#13;
•<EVENT eid="e6" class="STATE">Bangladeshkoa</EVENT>. &#13;
Azkeneko <EVENT eid="e7" class="OCCURRENCE">bidaia</EVENT> <TIMEX3 tid="t1" type="DATE" value="2016-02" temporalFunction="false">2016eko otsailean</TIMEX3>.&#13;
•Ez du medikamentuei aurreko <EVENT eid="e8" class="OCCURRENCE">alergiarik</EVENT>&#13;
•<EVENT eid="e9" class="OCCURRENCE">Hipertentsio</EVENT> arteriala.&#13;
•<TIMEX3 tid="t2" type="DATE" value="2003" temporalFunction="false">2003an</TIMEX3> Madrileko Jimenez Diaz ospitalean <EVENT eid="e10" class="OCCURRENCE">ingresua</EVENT> (Madril), <EVENT eid="e11" class="REPORTING">esaten</EVENT> duenez, Hepatitis C birusaren ondorioko <EVENT eid="e12" class="OCCURRENCE">hepatitis</EVENT> akutu batengatik, ez du <EVENT eid="e13" class="OCCURRENCE">informerik</EVENT>. &#13;
Azken odol <EVENT eid="e14" class="OCCURRENCE">analisiak</EVENT> <EVENT eid="e15" class="OCCURRENCE">berrikusiz</EVENT>, <TIMEX3 tid="t3" type="DATE" value="2012-01" temporalFunction="false">2012ko urtarrilean</TIMEX3> <EVENT eid="e16" class="OCCURRENCE">transaminasa</EVENT> altuei ondorioz, Digestibora <EVENT eid="e17" class="OCCURRENCE">bidali</EVENT> zuten, BHB eta CHB <EVENT eid="e18" class="OCCURRENCE">analisi</EVENT> negatiboak, eta <EVENT eid="e19" class="OCCURRENCE">aurkikuntzarik</EVENT> gabeko <EVENT eid="e20" class="OCCURRENCE">ekografia</EVENT> abdominala. &#13;
<TIMEX3 tid="t4" type="DATE" value="2012-02" temporalFunction="false">2012ko otsailean</TIMEX3> <EVENT eid="e21" class="OCCURRENCE">transaminasa</EVENT> normalak.&#13;
•<EVENT eid="e22" class="OCCURRENCE">Gastroskopia</EVENT> normala <TIMEX3 tid="t5" type="DATE" value="2014-02" temporalFunction="false">2014eko otsailean</TIMEX3> (<EVENT eid="e23" class="OCCURRENCE">eskatzeko</EVENT> arrazoia ez dago <EVENT eid="e24" class="OCCURRENCE">jasota</EVENT>).&#13;
•<EVENT eid="e25" class="OCCURRENCE">Aurrekari</EVENT> kirurgikoak: <EVENT eid="e26" class="OCCURRENCE">lipoma</EVENT> pretibiala.&#13;
•Ohiko <EVENT eid="e27" class="OCCURRENCE">tratamendua</EVENT>: <EVENT eid="e28" class="OCCURRENCE">Almax</EVENT>, <EVENT eid="e29" class="OCCURRENCE">Valsartan</EVENT> 80 mg (1-0-0), <EVENT eid="e30" class="OCCURRENCE">Metamizol</EVENT> (2 egun).&#13;
&#13;
<TIMEX3 tid="t6" type="DATE" value="PRESENT_REF" temporalFunction="true">EGUNGO</TIMEX3> <EVENT eid="e31" class="OCCURRENCE">GAIXOTASUNA</EVENT>:&#13;
<TIMEX3 tid="t7" type="DURATION" value="P3D" temporalFunction="false">Aurreko hiru egunetatik</TIMEX3> <TIMEX3 tid="t8" type="DATE" value="PRESENT_REF" temporalFunction="true">hona</TIMEX3> eskuinaldeko hobi iliakoko <EVENT eid="e32" class="OCCURRENCE">mina</EVENT>, eta <TIMEX3 tid="t9" type="DATE" value="2017-05-19" temporalFunction="false">gaurtik</TIMEX3> zilbor inguruko aldizkako <EVENT eid="e33" class="OCCURRENCE">mina</EVENT> <EVENT eid="e34" class="REPORTING">adierazten</EVENT> ditu. &#13;
Gainera, 38.5ºC arteko <EVENT eid="e35" class="OCCURRENCE">sukarra</EVENT>, <EVENT eid="e36" class="OCCURRENCE">daradak</EVENT> eta <EVENT eid="e37" class="OCCURRENCE">sentsazio</EVENT> distermikoa. &#13;
Elikagaiez osatutako <EVENT eid="e38" class="OCCURRENCE">botaka</EVENT>, beste <EVENT eid="e39" class="OCCURRENCE">produktu</EVENT> patologikorik gabekoa. &#13;
Bere alabak <EVENT eid="e40" class="REPORTING">dionez</EVENT>, begietako konjuntibak <EVENT eid="e41" class="OCCURRENCE">horitu</EVENT> egin zaizkio. &#13;
Perretxikoen edo bestelako jakien <EVENT eid="e42" class="OCCURRENCE">irenstea</EVENT> <EVENT eid="e43" class="REPORTING">ukatzen</EVENT> ditu. &#13;
Paracetamola eta Nolotilarekin <EVENT eid="e44" class="OCCURRENCE">tratamendua</EVENT> <EVENT eid="e45" class="ASPECTUAL">hasi</EVENT> du <TIMEX3 tid="t10" type="DURATION" value="PT48H" temporalFunction="false">orain dela 48 ordu</TIMEX3>, ez du bestelako <EVENT eid="e46" class="OCCURRENCE">tratamenduekin</EVENT> <EVENT eid="e47" class="OCCURRENCE">aldaketarik</EVENT> egin.&#13;
Ez du gorozkien erritmoan <EVENT eid="e48" class="OCCURRENCE">aldaketarik</EVENT> jasan, ezta <EVENT eid="e49" class="OCCURRENCE">produktu</EVENT> patologikorik <EVENT eid="e50" class="REPORTING">ikusi</EVENT>.&#13;
Ez arnas aparatuaren ezta urologia aparatuarekin erlazionaturiko <EVENT eid="e51" class="OCCURRENCE">klinikarik</EVENT>. &#13;
Bangladeshera azkeneko <EVENT eid="e52" class="OCCURRENCE">bidaia</EVENT> <TIMEX3 tid="t11" type="DURATION" value="P7M" temporalFunction="false">orain dela 7 hilabete</TIMEX3>.&#13;
&#13;
<EVENT eid="e53" class="OCCURRENCE">MIAKETA</EVENT> FISIKOAK:&#13;
<EVENT eid="e54" class="OCCURRENCE">TA</EVENT> 170/80 mmHg; <EVENT eid="e55" class="OCCURRENCE">BM</EVENT> 80 taupada/min; O2 <EVENT eid="e56" class="OCCURRENCE">asetasuna</EVENT> 99-100% (O2 2L); <EVENT eid="e57" class="OCCURRENCE">Tenp</EVENT> 36.5ºC&#13;
<EVENT eid="e58" class="OCCURRENCE">Kordean</EVENT>, lekuko eta denborako <EVENT eid="e59" class="OCCURRENCE">orientazio</EVENT> egokiak. &#13;
Ez du <EVENT eid="e60" class="OCCURRENCE">Flappingik</EVENT>. &#13;
Azal eta mukosetako <EVENT eid="e61" class="OCCURRENCE">ikterizia</EVENT>. &#13;
Mukosetako <EVENT eid="e62" class="OCCURRENCE">lehortasuna</EVENT>. Odol <EVENT eid="e63" class="OCCURRENCE">hondarrak</EVENT> ahoan,odol <EVENT eid="e64" class="OCCURRENCE">jariorik</EVENT> gabe.&#13;
&#13;
TORAX:&#13;
Bihotz <EVENT eid="e65" class="OCCURRENCE">auskultazio</EVENT> erritmikoa <EVENT eid="e66" class="OCCURRENCE">murmuriorik</EVENT> gabe. &#13;
Biriketako <EVENT eid="e67" class="OCCURRENCE">auskultazioa</EVENT> <EVENT eid="e68" class="OCCURRENCE">murmurio</EVENT> besikular normala.&#13;
SABELALDEA: <EVENT eid="e69" class="OCCURRENCE">Biguna</EVENT> eta <EVENT eid="e70" class="OCCURRENCE">deprimigarria</EVENT>, epigastrioan <EVENT eid="e71" class="OCCURRENCE">mingarria</EVENT>. &#13;
5 zentimetroko <EVENT eid="e72" class="OCCURRENCE">hepatomegalia</EVENT>.&#13;
Hanketan ez <EVENT eid="e73" class="OCCURRENCE">edemarik</EVENT> ezta zain sakonetako <EVENT eid="e74" class="OCCURRENCE">tronbosien</EVENT> <EVENT eid="e75" class="REPORTING">zeinurik</EVENT>.&#13;
&#13;
<EVENT eid="e76" class="OCCURRENCE">PROBA</EVENT> OSAGARRIAK:&#13;
Bularreko <EVENT eid="e77" class="OCCURRENCE">erradiografia</EVENT>: <EVENT eid="e78" class="OCCURRENCE">aurkipen</EVENT> patologikorik gabe. &#13;
Odol <EVENT eid="e79" class="OCCURRENCE">analisiak</EVENT>: <EVENT eid="e80" class="OCCURRENCE">Cr</EVENT> 1.36, <EVENT eid="e81" class="OCCURRENCE">Urea</EVENT> 44, <EVENT eid="e82" class="OCCURRENCE">Bilirrubina</EVENT> 4.06, <EVENT eid="e83" class="OCCURRENCE">GPT</EVENT> 1100, <EVENT eid="e84" class="OCCURRENCE">PCR</EVENT> 13, <EVENT eid="e85" class="OCCURRENCE">Prokalzitonina</EVENT> 1.13, <EVENT eid="e86" class="OCCURRENCE">Leukozitoak</EVENT> 6200, <EVENT eid="e87" class="OCCURRENCE">IP</EVENT> 55 %, <EVENT eid="e88" class="OCCURRENCE">INR</EVENT> 1.54&#13;
</TEXT>
