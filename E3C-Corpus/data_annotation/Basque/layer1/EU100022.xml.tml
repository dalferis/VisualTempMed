<?xml version="1.0" encoding="UTF-8"?>
<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2014-12-31T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2014-12-31</TIMEX3>
  <TEXT>OTORRINOLARINGOLOGIA (ORL)&#13;
<EVENT eid="e1" class="OCCURRENCE" comment="e3c:permanence=FINITE">OSPITALERATZEKO</EVENT>/<EVENT eid="e2" class="OCCURRENCE" comment="e3c:permanence=FINITE">KONTSULTARAKO</EVENT> ARRAZOIA.&#13;
<EVENT eid="e3" class="OCCURRENCE" comment="e3c:permanence=FINITE">Odinofagiagatik</EVENT> datorren 22 urteko gizonezkoa.&#13;
AURREKARI PERTSONALAK&#13;
Ez du <EVENT eid="e4" class="OCCURRENCE" comment="e3c:permanence=FINITE">alergia</EVENT> ezagunik.&#13;
Ez da <EVENT eid="e5" class="OCCURRENCE" comment="e3c:permanence=FINITE">erretzailea</EVENT>.&#13;
Ez du <EVENT eid="e6" class="OCCURRENCE" comment="e3c:permanence=FINITE">gaixotasun</EVENT> nabarmenik.&#13;
Ez du ohiko <EVENT eid="e7" class="OCCURRENCE" comment="e3c:permanence=FINITE">tratamendurik</EVENT> jarraitzen.&#13;
<TIMEX3 tid="t1" type="DATE" value="PRESENT_REF" temporalFunction="true">EGUNGO</TIMEX3> <EVENT eid="e8" class="OCCURRENCE" comment="e3c:permanence=FINITE">GAIXOTASUNA</EVENT>&#13;
<EVENT eid="e9" class="OCCURRENCE" comment="e3c:permanence=FINITE">Sukar</EVENT> eta <EVENT eid="e10" class="OCCURRENCE" comment="e3c:permanence=FINITE">ondoezarekin</EVENT> <EVENT eid="e11" class="ASPECTUAL" comment="e3c:permanence=FINITE">hasi</EVENT> zen <TIMEX3 tid="t2" type="DURATION" value="P4D" temporalFunction="false">orain dela lau egun</TIMEX3>; <TIMEX3 tid="t3" type="DURATION" value="PT24H" temporalFunction="false">24 orduko</TIMEX3> <EVENT eid="e12" class="OCCURRENCE" comment="e3c:permanence=FINITE">disfagia</EVENT> duelako <EVENT eid="e13" class="OCCURRENCE" comment="e3c:permanence=FINITE">etorri</EVENT> da, solidoekiko batez ere, likidoak ozta-ozta <EVENT eid="e14" class="OCCURRENCE" comment="e3c:permanence=FINITE">irensten</EVENT> dituela.&#13;
Bere medikuak <EVENT eid="e15" class="OCCURRENCE" comment="e3c:permanence=FINITE">azitromizina</EVENT> eman dio, baina <TIMEX3 tid="t4" type="DATE" value="2014-12-31" temporalFunction="false">gaur</TIMEX3> <EVENT eid="e16" class="OCCURRENCE" comment="e3c:permanence=FINITE">okerrago</EVENT> dago: <EVENT eid="e17" class="OCCURRENCE" comment="e3c:permanence=FINITE">mina</EVENT>, gehiegizko <EVENT eid="e18" class="OCCURRENCE" comment="e3c:permanence=FINITE">listu-jariatzea</EVENT> eta <EVENT eid="e19" class="OCCURRENCE" comment="e3c:permanence=FINITE">disfagia</EVENT> ditu.&#13;
<EVENT eid="e20" class="OCCURRENCE" comment="e3c:permanence=FINITE">AZTERKETA</EVENT> FISIKOA&#13;
<EVENT eid="e21" class="OCCURRENCE" comment="e3c:permanence=FINITE">Tentsio</EVENT> arteriala, 144/83; <EVENT eid="e22" class="OCCURRENCE" comment="e3c:permanence=FINITE">bihotz-maiztasuna</EVENT>, 98 tau/min; <EVENT eid="e23" class="OCCURRENCE" comment="e3c:permanence=FINITE">O2Sat</EVENT>,% 99.&#13;
<EVENT eid="e24" class="OCCURRENCE" comment="e3c:permanence=FINITE">Kontziente</EVENT> dago, <EVENT eid="e25" class="OCCURRENCE" comment="e3c:permanence=FINITE">orientatua</EVENT>, ongi <EVENT eid="e26" class="OCCURRENCE" comment="e3c:permanence=FINITE">hidratatua</EVENT> eta <EVENT eid="e27" class="OCCURRENCE" comment="e3c:permanence=FINITE">perfusio</EVENT> ona du; <EVENT eid="e28" class="OCCURRENCE" comment="e3c:permanence=FINITE">eupneiko</EVENT> dago.&#13;
Burua eta lepoa: <EVENT eid="e29" class="OCCURRENCE" comment="e3c:permanence=FINITE">otoskopia</EVENT> normala<EVENT eid="e30" class="OCCURRENCE" comment="e3c:permanence=FINITE">; orofaringea</EVENT>: eskuineko amigdala erdialdera <EVENT eid="e31" class="OCCURRENCE" comment="e3c:permanence=FINITE">desplazatua</EVENT>, ahosabai biguna eta ubula edematizatua.&#13;
Ez dago <EVENT eid="e32" class="OCCURRENCE" comment="e3c:permanence=FINITE">laringe-masarik</EVENT>, ahots-kordak ondo <EVENT eid="e33" class="OCCURRENCE" comment="e3c:permanence=FINITE">mugitzen</EVENT> dira.&#13;
Biriken <EVENT eid="e34" class="OCCURRENCE" comment="e3c:permanence=FINITE">auskultazioa</EVENT>: <EVENT eid="e35" class="OCCURRENCE" comment="e3c:permanence=FINITE">murmurio</EVENT> normala.&#13;
<EVENT eid="e36" class="OCCURRENCE" comment="e3c:permanence=FINITE">Bihotz-auskultazioa</EVENT>: <EVENT eid="e37" class="OCCURRENCE" comment="e3c:permanence=FINITE">erritmikoa</EVENT>; ez da <EVENT eid="e38" class="OCCURRENCE" comment="e3c:permanence=FINITE">murmuriorik</EVENT> <EVENT eid="e39" class="REPORTING" comment="e3c:permanence=FINITE">entzuten</EVENT>.&#13;
Sabelaldean ez da ezer <EVENT eid="e40" class="OCCURRENCE" comment="e3c:permanence=FINITE">patologikorik</EVENT> <EVENT eid="e41" class="REPORTING" comment="e3c:permanence=FINITE">atzematen</EVENT>.&#13;
Gorputz-adarrak: ez du <EVENT eid="e42" class="REPORTING" comment="e3c:permanence=FINITE">edemarik</EVENT>; <EVENT eid="e43" class="OCCURRENCE" comment="e3c:permanence=FINITE">pultsu</EVENT> periferikoak normalak dira.&#13;
<EVENT eid="e44" class="OCCURRENCE" comment="e3c:permanence=FINITE">PROBA</EVENT> OSAGARRIAK&#13;
<EVENT eid="e45" class="OCCURRENCE" comment="e3c:permanence=FINITE">ANALITIKA</EVENT>: <EVENT eid="e46" class="OCCURRENCE" comment="e3c:permanence=FINITE">LEUKOZITOSI</EVENT> NEUTROFILIKOA.&#13;
<EVENT eid="e47" class="OCCURRENCE" comment="e3c:permanence=FINITE">EBOLUZIOA</EVENT>&#13;
Larrialdietako Zerbitzuan <EVENT eid="e48" class="OCCURRENCE" comment="e3c:permanence=FINITE">anestesia</EVENT> lokalarekin aho bidezko abzesuaren <EVENT eid="e49" class="OCCURRENCE" comment="e3c:permanence=FINITE">drainatze</EVENT> kirurgikoa egin diogu, eta zorne-kantitate handia <EVENT eid="e50" class="OCCURRENCE" comment="e3c:permanence=FINITE">aterata</EVENT>, <EVENT eid="e51" class="OCCURRENCE" comment="e3c:permanence=FINITE">mina</EVENT> <EVENT eid="e52" class="OCCURRENCE" comment="e3c:permanence=FINITE">arindu</EVENT> egin zaio.&#13;
Pazientea <EVENT eid="e53" class="OCCURRENCE" comment="e3c:permanence=FINITE">ospitaleratu</EVENT> egin dugu zain barneko <EVENT eid="e54" class="OCCURRENCE" comment="e3c:permanence=FINITE">tratamendu</EVENT> antibiotikoa egiteko, eta ez du <EVENT eid="e55" class="OCCURRENCE" comment="e3c:permanence=FINITE">konplikaziorik</EVENT> izan <EVENT eid="e56" class="OCCURRENCE" comment="e3c:permanence=FINITE">eboluzioan</EVENT>.</TEXT>
