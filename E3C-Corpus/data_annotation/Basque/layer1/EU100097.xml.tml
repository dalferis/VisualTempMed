  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2015-04-28T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2015-04-28</TIMEX3>
  <TEXT>46 urteko emakumea <TIMEX3 tid="t1" type="TIME" value="2014-04-28TMO" temporalFunction="false">gaur goizetik</TIMEX3> eskuineko betazalaren <EVENT eid="e1" class="OCCURRENCE">ptosia</EVENT> duena.&#13;
<TIMEX3 tid="t2" type="DURATION" value="P5W" temporalFunction="false">Orain dela 5 aste</TIMEX3> eta, batez ere, <EVENT eid="e2" class="OCCURRENCE">jarduera</EVENT> fisikoa egiterakoan <EVENT eid="e3" class="OCCURRENCE">ahultasun</EVENT> nabaria daukala <EVENT eid="e4" class="OCCURRENCE">dio</EVENT> eta <EVENT eid="e5" class="OCCURRENCE">kirola</EVENT> egiteari <EVENT eid="e6" class="ASPECTUAL">utzi</EVENT> behar izan dio. &#13;
Horregatik bere familia-medikuarengana <EVENT eid="e7" class="OCCURRENCE">joan</EVENT> zen <TIMEX3 tid="t3" type="SET" value="X" temporalFunction="true">bitan</TIMEX3>.&#13;
<EVENT eid="e8" class="OCCURRENCE">Galderetan</EVENT> sakonduta, <TIMEX3 tid="t4" type="DURATION" value="P5W" temporalFunction="false">orain dela bost aste</TIMEX3> <EVENT eid="e9" class="OCCURRENCE">hitz</EVENT> egiterakoan batzuetan <EVENT eid="e10" class="OCCURRENCE">zailtasunak</EVENT> zituen (<EVENT eid="e11" class="OCCURRENCE">disfonia</EVENT>), <EVENT eid="e12" class="OCCURRENCE">irakurtzerakoan</EVENT> batzuetan <EVENT eid="e13" class="OCCURRENCE">diplopia</EVENT> eta likidoak irensteko <EVENT eid="e14" class="OCCURRENCE">zailtasuna</EVENT>. &#13;
Guzti hau <TIMEX3 tid="t5" type="SET" value="P1D" temporalFunction="true">egunean zenbait momentutan</TIMEX3> soilik eta orokorrean <TIMEX3 tid="t6" type="DURATION" value="P1D" temporalFunction="false">eguna</TIMEX3> <EVENT eid="e15" class="OCCURRENCE">aurrera</EVENT> joan ahala <EVENT eid="e16" class="OCCURRENCE">okerrera</EVENT> doa.&#13;
<TIMEX3 tid="t7" type="DURATION" value="P1M" temporalFunction="false">Orain dela hilabete bat</TIMEX3> Teterazepam eta Diklofenakorekin <EVENT eid="e17" class="OCCURRENCE">tratatzen</EVENT> <EVENT eid="e18" class="ASPECTUAL">hasi</EVENT> zen <EVENT eid="e19" class="OCCURRENCE">lunbalgia</EVENT> batengatik.&#13;
&#13;
-<EVENT eid="e20" class="OCCURRENCE">Azterketa</EVENT> Fisikoa:&#13;
<EVENT eid="e21" class="OCCURRENCE">PA</EVENT>:134/80mmHg, <EVENT eid="e22" class="OCCURRENCE">Pultsoa</EVENT>:80lm, <EVENT eid="e23" class="OCCURRENCE">SatO2</EVENT>:%99, <EVENT eid="e24" class="OCCURRENCE">Tª</EVENT>:36.5ºC&#13;
<EVENT eid="e25" class="OCCURRENCE">Glasgow</EVENT>: 15. &#13;
<EVENT eid="e26" class="OCCURRENCE">Azterketa</EVENT> Fisiko orokorra: normala.&#13;
<EVENT eid="e27" class="OCCURRENCE">Kontziente</EVENT> eta <EVENT eid="e28" class="OCCURRENCE">orientatua</EVENT>. &#13;
<EVENT eid="e29" class="OCCURRENCE">Hizkera</EVENT> normala.&#13;
Eskuin begiko betazalaren <EVENT eid="e30" class="OCCURRENCE">ptosia</EVENT> <EVENT eid="e31" class="OCCURRENCE">jarduera</EVENT> fiskoarekin <EVENT eid="e32" class="OCCURRENCE">okerrera</EVENT> doana eta <EVENT eid="e33" class="OCCURRENCE">aldebikoa</EVENT>. &#13;
<EVENT eid="e34" class="OCCURRENCE">Disfonia</EVENT> <EVENT eid="e35" class="OCCURRENCE">jarduerarekin</EVENT>. &#13;
<EVENT eid="e36" class="OCCURRENCE">Zailtasunak</EVENT> paladarra <EVENT eid="e37" class="OCCURRENCE">igotzeko</EVENT>, <EVENT eid="e38" class="OCCURRENCE">lateralizaiorik</EVENT> gabe. &#13;
Ez da <EVENT eid="e39" class="REPORTING">sumatzen</EVENT> mugimenaren <EVENT eid="e40" class="OCCURRENCE">galera</EVENT> gehiagorik.&#13;
&#13;
-<EVENT eid="e41" class="OCCURRENCE">Froga</EVENT> Osagarriak:&#13;
<EVENT eid="e42" class="OCCURRENCE">EKG</EVENT>: <EVENT eid="e43" class="OCCURRENCE">RS</EVENT> a 86 lpm&#13;
Bularreko <EVENT eid="e44" class="OCCURRENCE">Rx</EVENT>: Normala.&#13;
<EVENT eid="e45" class="OCCURRENCE">ANALITIKA</EVENT>: Normala.&#13;
<EVENT eid="e46" class="OCCURRENCE">TAK</EVENT> KRANEAL:Normala&#13;
&#13;
-<EVENT eid="e47" class="OCCURRENCE">Epai</EVENT> Klinikoa: <EVENT eid="e48" class="OCCURRENCE">Miastenia</EVENT> Gravis orokortua.&#13;
-<EVENT eid="e49" class="OCCURRENCE">Tratamendua</EVENT>:&#13;
Pazientea Neurologian <EVENT eid="e50" class="OCCURRENCE">sartzen</EVENT> da. &#13;
Bertan <EVENT eid="e51" class="OCCURRENCE">Miastenia</EVENT> Gravisaren diagnostikoa <EVENT eid="e52" class="REPORTING">baieztatzen</EVENT> da. &#13;
<EVENT eid="e53" class="OCCURRENCE">Antiazetilkolina</EVENT> Ag:234, Estimulazio Errepikatutako <EVENT eid="e54" class="OCCURRENCE">Testa</EVENT> eta <EVENT eid="e55" class="OCCURRENCE">Jitter–a</EVENT> patologikoak, Bularreko <EVENT eid="e56" class="OCCURRENCE">TAK-a</EVENT>: <EVENT eid="e57" class="OCCURRENCE">Timoma</EVENT> eta <EVENT eid="e58" class="OCCURRENCE">Anatomopatologia</EVENT>:AB <EVENT eid="e59" class="OCCURRENCE">Timoma</EVENT>, IIa estadioa&#13;
&#13;
<EVENT eid="e60" class="OCCURRENCE">Tratamendua</EVENT>: <EVENT eid="e61" class="OCCURRENCE">Piridostigmina</EVENT> eta <EVENT eid="e62" class="OCCURRENCE">kortikoide</EVENT> oralak&#13;
<EVENT eid="e63" class="OCCURRENCE">Timektomia</EVENT> eta <EVENT eid="e64" class="OCCURRENCE">radioterapia</EVENT>.&#13;
</TEXT>
