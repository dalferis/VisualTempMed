<?xml version="1.0" encoding="UTF-8"?>
<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2008-10-03T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2008-10-03</TIMEX3>
  <TEXT><EVENT eid="e1" class="OCCURRENCE">HARRERAREN</EVENT> MOTIBOA <EVENT eid="e2" class="OCCURRENCE">Sukarra</EVENT> eta arnas aparatuko <EVENT eid="e3" class="OCCURRENCE">sintomak</EVENT> dituen gaixo transplantatua.&#13;
&#13;
<EVENT eid="e4" class="OCCURRENCE">AURREKARIAK</EVENT> 54 urte, <EVENT eid="e5" class="STATE">nefroangioesklerosiak</EVENT> eragindako giltzurrun <EVENT eid="e6" class="OCCURRENCE">gutxiegitasuna</EVENT>, <TIMEX3 tid="t1" type="DURATION" value="P11M" temporalFunction="false">11 hilabetez</TIMEX3> <EVENT eid="e7" class="OCCURRENCE">dialisi</EVENT> peritonealean egon ondoren giltzurrun <EVENT eid="e8" class="OCCURRENCE">transplantea</EVENT> jaso zuena. <EVENT eid="e9" class="OCCURRENCE">Transplantea</EVENT> egin zenean ez zitzaion eman Zitomegalobirusaren aurkako <EVENT eid="e10" class="OCCURRENCE">profilaxirik</EVENT>, birus horren <EVENT eid="e11" class="OCCURRENCE">serologia</EVENT> positiboa zutelako bai emaileak bai hartzaileak. <EVENT eid="e12" class="OCCURRENCE">Alta</EVENT> <TIMEX3 tid="t2" type="DATE" value="XXXX-XX-XX" temporalFunction="true">unean</TIMEX3> <EVENT eid="e13" class="OCCURRENCE">Kreatinina</EVENT> 2,5 mg/dl zen. Errefusaren aurkako <EVENT eid="e14" class="OCCURRENCE">tratamendurako</EVENT> <EVENT eid="e15" class="OCCURRENCE">Takrolimus</EVENT>, <EVENT eid="e16" class="OCCURRENCE">Mikofenolatoa</EVENT> eta <EVENT eid="e17" class="OCCURRENCE">Prednisona</EVENT> jaso zuen.&#13;
&#13;
<EVENT eid="e18" class="OCCURRENCE">BILAKAERA</EVENT> Oraingo <EVENT eid="e19" class="OCCURRENCE">gaixotasuna</EVENT>: <EVENT eid="e20" class="OCCURRENCE">Transplantetik</EVENT> <TIMEX3 tid="t3" type="DURATION" value="P3M" temporalFunction="false">3 hilabete</TIMEX3> <EVENT eid="e21" class="OCCURRENCE">igaro</EVENT> eta gero, <EVENT eid="e22" class="OCCURRENCE">eztula</EVENT> eta <EVENT eid="e23" class="OCCURRENCE">karkaxa</EVENT> zornetsuarekin <EVENT eid="e24" class="ASPECTUAL">hasten</EVENT> da, eta <TIMEX3 tid="t4" type="DURATION" value="P15D" temporalFunction="false">15 egun</TIMEX3> geroago <EVENT eid="e25" class="OCCURRENCE">sukarra</EVENT>, <EVENT eid="e26" class="OCCURRENCE">hotzikarak</EVENT>, <EVENT eid="e27" class="OCCURRENCE">ondoez</EVENT> orokorra eta eskuineko <EVENT eid="e28" class="OCCURRENCE">min</EVENT> pleuritikoa ditu. <EVENT eid="e29" class="OCCURRENCE">Miaketa</EVENT> larria zirudien, 38 graduko <EVENT eid="e30" class="OCCURRENCE">sukarra</EVENT>, <EVENT eid="e31" class="OCCURRENCE">tentsio</EVENT> arteriala 170/100, arnas <EVENT eid="e32" class="OCCURRENCE">maiztasuna</EVENT> 26 minutuko, <EVENT eid="e33" class="OCCURRENCE">roncus</EVENT> eta <EVENT eid="e34" class="OCCURRENCE">txistu-hotsak</EVENT> biriketako <EVENT eid="e35" class="OCCURRENCE">aukultazioan</EVENT> eta 2 larruazalpeko <EVENT eid="e36" class="OCCURRENCE">nodulu</EVENT> mugikor, 1 cm-koak, <EVENT eid="e37" class="OCCURRENCE">bata</EVENT> eskuineko sabelaldeko alboan eta <EVENT eid="e38" class="OCCURRENCE">bestea</EVENT> ezkerrekoan. <EVENT eid="e39" class="OCCURRENCE">Analisian</EVENT> 11600 leukozito/mm3 (%6 <EVENT eid="e40" class="OCCURRENCE">forma</EVENT> gazteak), <EVENT eid="e41" class="OCCURRENCE">Hemoglobina</EVENT> 10,3 gr/dl, <EVENT eid="e42" class="OCCURRENCE">Fibrinogenoa</EVENT> 845 mg/dl, gernuko <EVENT eid="e43" class="OCCURRENCE">sedimentu</EVENT> normala, <EVENT eid="e44" class="OCCURRENCE">Kreatinina</EVENT> 3,3 mg/dl, <EVENT eid="e45" class="OCCURRENCE">Urea</EVENT> 120 mg/dl, <EVENT eid="e46" class="OCCURRENCE">Albumina</EVENT> 2,5 gr/dl, <EVENT eid="e47" class="OCCURRENCE">pH</EVENT> 7,45, <EVENT eid="e48" class="OCCURRENCE">PO2</EVENT> 84 mmHg, <EVENT eid="e49" class="OCCURRENCE">PCO2</EVENT> 27 mmHg, <EVENT eid="e50" class="OCCURRENCE">CO3H</EVENT> 19 mEq/l, oxigeno <EVENT eid="e51" class="OCCURRENCE">asetasuna</EVENT> %97. Toraxeko <EVENT eid="e52" class="OCCURRENCE">X-izpietan</EVENT> 3 <EVENT eid="e53" class="OCCURRENCE">nodulu</EVENT>, haietako bat <EVENT eid="e54" class="OCCURRENCE">hutsune</EVENT> eta <EVENT eid="e55" class="OCCURRENCE">airearekin</EVENT>. <EVENT eid="e56" class="OCCURRENCE">OTAn</EVENT>, 4,5 cm-ko <EVENT eid="e57" class="OCCURRENCE">irudi</EVENT> bat eskuineko ertaineko lobuluan eta beste antzeko <EVENT eid="e58" class="OCCURRENCE">bi</EVENT> beheko eremuetan. Odol, gernu eta gorotz <EVENT eid="e59" class="OCCURRENCE">kultiboak</EVENT> negatiboak ziren. <EVENT eid="e60" class="OCCURRENCE">Bronkoskopia</EVENT> eta bronkio-albeolo <EVENT eid="e61" class="OCCURRENCE">garbiketan</EVENT> eta eskuineko birikako beheko <EVENT eid="e62" class="OCCURRENCE">noduluan</EVENT> egindako <EVENT eid="e63" class="OCCURRENCE">ziztadan</EVENT> Nocardia asteroides eta Pneumocystis carinii <EVENT eid="e64" class="OCCURRENCE">hazi</EVENT> ziren. Abdomeneko <EVENT eid="e65" class="OCCURRENCE">nodulua</EVENT> <EVENT eid="e66" class="OCCURRENCE">drainatzean</EVENT> Nocardia asteroides-a <EVENT eid="e67" class="OCCURRENCE">hazi</EVENT> zen. Odolean Zitomegalobirusaren <EVENT eid="e68" class="OCCURRENCE">antigenoa</EVENT> eta <EVENT eid="e69" class="OCCURRENCE">hazkuntza</EVENT> positiboak izan ziren. <EVENT eid="e70" class="OCCURRENCE">Tratamendurako</EVENT> <EVENT eid="e71" class="OCCURRENCE">Trimetroprim-Sulfametoxazol</EVENT> eta <EVENT eid="e72" class="OCCURRENCE">Ganziklobir</EVENT> erabili ziren. Nahiz eta hasieran <EVENT eid="e73" class="OCCURRENCE">bilakaera</EVENT> <EVENT eid="e74" class="OCCURRENCE">egokia</EVENT> izan, <TIMEX3 tid="t5" type="DURATION" value="P3W" temporalFunction="false">hiru aste</TIMEX3> geroago kateterrak eragindako <EVENT eid="e75" class="OCCURRENCE">septizemia</EVENT> bi (Staphylococcus aureus eta Candida albicans) eta <EVENT eid="e76" class="OCCURRENCE">aholegarrak</EVENT> (Herpesbirus sinplea 1) izan zituen; hori dela eta <EVENT eid="e77" class="OCCURRENCE">Teikoplanina</EVENT>, <EVENT eid="e78" class="OCCURRENCE">Flukonazol</EVENT> eta <EVENT eid="e79" class="OCCURRENCE">Aziklobir</EVENT> <EVENT eid="e80" class="OCCURRENCE">gehitu</EVENT> ziren. Horren ondoren bai <EVENT eid="e81" class="OCCURRENCE">sintomak</EVENT> bai X-izpiko <EVENT eid="e82" class="OCCURRENCE">irudiak</EVENT> <EVENT eid="e83" class="OCCURRENCE">hobetu</EVENT> ziren eta <EVENT eid="e84" class="OCCURRENCE">alta</EVENT> jaso zuen. <EVENT eid="e85" class="OCCURRENCE">Kreatinina</EVENT> 2,8 mg/dl zen eta <EVENT eid="e86" class="OCCURRENCE">tratamenduari</EVENT> <EVENT eid="e87" class="OCCURRENCE">Azatioprina</EVENT> <EVENT eid="e88" class="OCCURRENCE">gehitu</EVENT> zitzaion.</TEXT>
