<?xml version="1.0" encoding="UTF-8"?>
<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2018-02-23T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2018-02-23</TIMEX3>
  <TEXT>KONTSULTARENARRAZOIA:&#13;
37 urteko emakumea, lehen mailako atentziotik <EVENT eid="e1" class="OCCURRENCE">gorakoengatik</EVENT> <EVENT eid="e2" class="OCCURRENCE">bidalia</EVENT>.&#13;
&#13;
<EVENT eid="e3" class="OCCURRENCE">AURREKARI</EVENT> PERTSONALAK:&#13;
-<EVENT eid="e4" class="STATE">Bolibiarra</EVENT>, Espainian <EVENT eid="e5" class="OCCURRENCE">bizitako</EVENT> <TIMEX3 tid="t1" type="DURATION" value="PXD" temporalFunction="true">denbora</TIMEX3> <EVENT eid="e6" class="OCCURRENCE">erregistratu</EVENT> gabe.&#13;
-Ez <EVENT eid="e7" class="OCCURRENCE">aurrekari</EVENT> familiar garrantzitsurik.&#13;
-Ez du medikamentuei aurreko <EVENT eid="e8" class="OCCURRENCE">alergiarik</EVENT>.&#13;
-<EVENT eid="e9" class="OCCURRENCE">HTA</EVENT>, <EVENT eid="e10" class="OCCURRENCE">Dislipemia</EVENT>, <EVENT eid="e11" class="STATE">Hipotiroidismo</EVENT> subklinikoa.&#13;
-Reumatologia eta Nefrologiako zerbitzuek <EVENT eid="e12" class="OCCURRENCE">kontrolatzen</EVENT> duten <EVENT eid="e13" class="STATE">Lupus</EVENT> eritematoso sistemikoa. &#13;
<EVENT eid="e14" class="OCCURRENCE">Tratamendu</EVENT> immunogutxitzaile ezberdinak jarraitu behar izan ditu (<EVENT eid="e15" class="OCCURRENCE">Kortikoideak</EVENT> <TIMEX3 tid="t2" type="DURATION" value="PXD" temporalFunction="true">denbora luzez</TIMEX3>, <EVENT eid="e16" class="OCCURRENCE">Ziklofosfamida</EVENT>, Mofetil <EVENT eid="e17" class="OCCURRENCE">mikofenolatoa</EVENT>, <EVENT eid="e18" class="OCCURRENCE">Azatioprina</EVENT>, <EVENT eid="e19" class="OCCURRENCE">Rituximaba</EVENT> eta <EVENT eid="e20" class="OCCURRENCE">Klorokina</EVENT>).&#13;
-<EVENT eid="e21" class="OCCURRENCE">Glomerulonefritis</EVENT> ugalkor extrakapilarra, 5º estadioko giltzurrun <EVENT eid="e22" class="OCCURRENCE">gutxiegitasun</EVENT> kronikoa. &#13;
<EVENT eid="e23" class="OCCURRENCE">Kontsulta</EVENT> baino <TIMEX3 tid="t3" type="DURATION" value="P3W" temporalFunction="false">3 aste</TIMEX3> lehenago <EVENT eid="e24" class="OCCURRENCE">Dialisian</EVENT> <EVENT eid="e25" class="ASPECTUAL">hasi</EVENT> zen, <TIMEX3 tid="t4" type="SET" value="P1W" temporalFunction="true">astean 3tan</TIMEX3> Dialbilbon. &#13;
<EVENT eid="e26" class="OCCURRENCE">Trasplanteko</EVENT> zerrendan <EVENT eid="e27" class="OCCURRENCE">sartzeko</EVENT> <EVENT eid="e28" class="OCCURRENCE">ikerketen</EVENT> <EVENT eid="e29" class="OCCURRENCE">zain</EVENT>.&#13;
-Ohiko <EVENT eid="e30" class="OCCURRENCE">tratamendua</EVENT>: <EVENT eid="e31" class="OCCURRENCE">Adiro</EVENT> 100 mg (0-1-0), <EVENT eid="e32" class="OCCURRENCE">Atorvastatina</EVENT> 10 mg (0-0-1), <EVENT eid="e33" class="OCCURRENCE">Dacortin</EVENT> 30 mg (1-0-0), <EVENT eid="e34" class="OCCURRENCE">Dolquine</EVENT> 200 mg (1-0-1), <EVENT eid="e35" class="OCCURRENCE">Nevibolol</EVENT> 5 mg (1-0-0), <EVENT eid="e36" class="OCCURRENCE">Pantoprazol</EVENT> 40 mg (1-0-1), <EVENT eid="e37" class="OCCURRENCE">renvela</EVENT> 2,4 g (0-0-1), <EVENT eid="e38" class="OCCURRENCE">Zyloric100</EVENT> mg (0-1-0).&#13;
&#13;
<TIMEX3 tid="t5" type="DATE" value="PRESENT_REF" temporalFunction="true">EGUNGO</TIMEX3> <EVENT eid="e39" class="OCCURRENCE">GAIXOTASUNA</EVENT>:&#13;
<TIMEX3 tid="t6" type="DURATION" value="P2W" temporalFunction="false">Bi astetatik</TIMEX3> <TIMEX3 tid="t7" type="DATE" value="PRESENT_REF" temporalFunction="true">hona</TIMEX3> elikagai eta behazun <EVENT eid="e40" class="OCCURRENCE">gorakoak</EVENT>, noizbehinka <EVENT eid="e41" class="OCCURRENCE">itxura</EVENT> hematikoarekin, eta <EVENT eid="e42" class="OCCURRENCE">gorakoa</EVENT> baino <TIMEX3 tid="t8" type="DURATION" value="PT15M" temporalFunction="false">15 minutu</TIMEX3> lehenagoko sabelaldeko <EVENT eid="e43" class="OCCURRENCE">min</EVENT> orokortua, <EVENT eid="e44" class="OCCURRENCE">botaka</EVENT> egin eta gero <EVENT eid="e45" class="OCCURRENCE">lasaitzen</EVENT> dena. &#13;
<EVENT eid="e46" class="OCCURRENCE">Primperana</EVENT> hartu arren, <EVENT eid="e47" class="OCCURRENCE">elikatzeko</EVENT> <EVENT eid="e48" class="OCCURRENCE">jasanezintasuna</EVENT> eta masa muskular eta pisu <EVENT eid="e49" class="OCCURRENCE">galera</EVENT> aurkeztu ditu. &#13;
<EVENT eid="e50" class="OCCURRENCE">Afektazio</EVENT> orokor nabaria, <EVENT eid="e51" class="OCCURRENCE">ibiltzeko</EVENT> <EVENT eid="e52" class="OCCURRENCE">ezintasunarekin</EVENT>. &#13;
Gorozkien <EVENT eid="e53" class="OCCURRENCE">erritmo</EVENT> normala, <EVENT eid="e54" class="OCCURRENCE">kolore</EVENT> normala eta <EVENT eid="e55" class="OCCURRENCE">produktu</EVENT> patologikorik gabekoak. &#13;
Ez du sabel <EVENT eid="e56" class="OCCURRENCE">distentsiorik</EVENT>.&#13;
&#13;
<EVENT eid="e57" class="OCCURRENCE">MIAKETA</EVENT> FISIKOAK:&#13;
<EVENT eid="e58" class="OCCURRENCE">TA</EVENT> 106/76 mmHg; <EVENT eid="e59" class="OCCURRENCE">BM</EVENT> 87taupada/min; O2 <EVENT eid="e60" class="OCCURRENCE">asetasuna</EVENT> 100%; <EVENT eid="e61" class="OCCURRENCE">Tenp</EVENT> 36.8ºC&#13;
<EVENT eid="e62" class="OCCURRENCE">Egoera</EVENT> orokor txarra. &#13;
<EVENT eid="e63" class="OCCURRENCE">Kordean</EVENT>, lekuko eta denborako <EVENT eid="e64" class="OCCURRENCE">orientazio</EVENT> egokiak.&#13;
<EVENT eid="e65" class="OCCURRENCE">Kolore</EVENT> normaleko larruazal eta mukosak. &#13;
Mukosetako <EVENT eid="e66" class="OCCURRENCE">lehortasuna</EVENT>, <EVENT eid="e67" class="OCCURRENCE">perfusio</EVENT> ona. <EVENT eid="e68" class="OCCURRENCE">Eupneika</EVENT>.&#13;
&#13;
BULARRALDEA:&#13;
Bihotz <EVENT eid="e69" class="OCCURRENCE">auskultazio</EVENT> erritmikoa <EVENT eid="e70" class="OCCURRENCE">murmuriorik</EVENT> gabe. &#13;
Biriketako <EVENT eid="e71" class="OCCURRENCE">auskultazioa</EVENT>: arnas <EVENT eid="e72" class="OCCURRENCE">murmuilo</EVENT> arrunta, <EVENT eid="e73" class="OCCURRENCE">zarata</EVENT> gaineraturik gabe.&#13;
&#13;
SABELALDEA:&#13;
<EVENT eid="e74" class="OCCURRENCE">Biguna</EVENT> eta <EVENT eid="e75" class="OCCURRENCE">deprimigarria</EVENT>, epigastrioan <EVENT eid="e76" class="OCCURRENCE">mingarria</EVENT>, <EVENT eid="e77" class="OCCURRENCE">irritazio</EVENT> peritonalaren <EVENT eid="e78" class="OCCURRENCE">zeinurik</EVENT> gabe. &#13;
Ez du <EVENT eid="e79" class="OCCURRENCE">masa</EVENT> zein <EVENT eid="e80" class="OCCURRENCE">megaliarik</EVENT>. &#13;
<EVENT eid="e81" class="OCCURRENCE">Zarata</EVENT> peristaltiko normalak. &#13;
Hanketan ez <EVENT eid="e82" class="OCCURRENCE">edemarik</EVENT> ezta zain sakonetako <EVENT eid="e83" class="OCCURRENCE">tronbosien</EVENT> <EVENT eid="e84" class="REPORTING">zeinurik</EVENT>.&#13;
&#13;
URGENTZIETAKO <EVENT eid="e85" class="OCCURRENCE">PROBA</EVENT> OSAGARRIAK:&#13;
-Bular eta Sabel <EVENT eid="e86" class="OCCURRENCE">erradiografia</EVENT> normalak.&#13;
-Odol <EVENT eid="e87" class="OCCURRENCE">analisia</EVENT>: <EVENT eid="e88" class="OCCURRENCE">Gasometria</EVENT> benosoa: <EVENT eid="e89" class="OCCURRENCE">PCO2</EVENT> 39.0 mmHg, <EVENT eid="e90" class="OCCURRENCE">pH</EVENT> 7.5, Gehiegizko <EVENT eid="e91" class="OCCURRENCE">baseak</EVENT> 6.5 mmol/L, <EVENT eid="e92" class="OCCURRENCE">HCO3</EVENT> 30.4 mmol/L.&#13;
<EVENT eid="e93" class="OCCURRENCE">Biokimika</EVENT>: <EVENT eid="e94" class="OCCURRENCE">Glukosa</EVENT> 145 mg/dL, <EVENT eid="e95" class="OCCURRENCE">Urea</EVENT> 42 mg/dL, <EVENT eid="e96" class="OCCURRENCE">kreatinina</EVENT> 2.5 mg/dL,, <EVENT eid="e97" class="OCCURRENCE">Albumina</EVENT> 1.91 g/dL, <EVENT eid="e98" class="OCCURRENCE">Bilirrubina</EVENT> totala 0.30 mg/dL, <EVENT eid="e99" class="OCCURRENCE">ALT</EVENT>/GPT 28 U/L, <EVENT eid="e100" class="OCCURRENCE">CK</EVENT> 83 U/L, <EVENT eid="e101" class="OCCURRENCE">LDH</EVENT> 345 U/L, <EVENT eid="e102" class="OCCURRENCE">Amilasa</EVENT> 29 U/L, <EVENT eid="e103" class="OCCURRENCE">Kaltzio</EVENT> totala 7.76 mg/dL, <EVENT eid="e104" class="OCCURRENCE">Sodioa</EVENT> 135 mmol/L, <EVENT eid="e105" class="OCCURRENCE">Potasioa</EVENT> 3.90 mmol/L, <EVENT eid="e106" class="OCCURRENCE">PCR</EVENT> 2.75 mg/dL.&#13;
<EVENT eid="e107" class="OCCURRENCE">Hematimetria</EVENT>: <EVENT eid="e108" class="OCCURRENCE">Hemoglobina</EVENT> 8.1 g/dL, <EVENT eid="e109" class="OCCURRENCE">Hematokritoa</EVENT> 24.6%, <EVENT eid="e110" class="OCCURRENCE">VCM</EVENT> 88.8%, <EVENT eid="e111" class="OCCURRENCE">HCM</EVENT> 29.2 pg, <EVENT eid="e112" class="OCCURRENCE">CHCM</EVENT> 32.9 g/dL, <EVENT eid="e113" class="OCCURRENCE">ADE</EVENT> 13%, <EVENT eid="e114" class="OCCURRENCE">Plaketak</EVENT> 263 10^3/L, <EVENT eid="e115" class="OCCURRENCE">Leukozitoak3.1</EVENT> 10^3/L (<EVENT eid="e116" class="OCCURRENCE">Neutrofiloak</EVENT> 76.2%, <EVENT eid="e117" class="OCCURRENCE">Linfozitoak11.7</EVENT> %). <EVENT eid="e118" class="OCCURRENCE">Koagulazioa</EVENT>: Protronbina <EVENT eid="e119" class="OCCURRENCE">indizea</EVENT> 100%, <EVENT eid="e120" class="OCCURRENCE">I.N.R</EVENT>. 1.00&#13;
-Gernu <EVENT eid="e121" class="OCCURRENCE">analisia</EVENT>: <EVENT eid="e122" class="OCCURRENCE">Dentsitatea</EVENT> 1.012, <EVENT eid="e123" class="OCCURRENCE">pH</EVENT> 7.5, <EVENT eid="e124" class="OCCURRENCE">Proteinak</EVENT> 150 mg/dL, <EVENT eid="e125" class="OCCURRENCE">Glukosa</EVENT> 0 mg/dL, <EVENT eid="e126" class="OCCURRENCE">Gorputz</EVENT> zetonikoak 0 mg/dL, <EVENT eid="e127" class="OCCURRENCE">Hemoglobina</EVENT> 0.06 mg/dL, <EVENT eid="e128" class="OCCURRENCE">Esterasa</EVENT> leukozitarioa 500, <EVENT eid="e129" class="OCCURRENCE">Nitrito</EVENT> Negatiboak, <EVENT eid="e130" class="OCCURRENCE">Bilirrubina</EVENT> 0.0 mg/dL, <EVENT eid="e131" class="OCCURRENCE">Urobilinogenoa</EVENT> 2.0 mg/dL.&#13;
</TEXT>
