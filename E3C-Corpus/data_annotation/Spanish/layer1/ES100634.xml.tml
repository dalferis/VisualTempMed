<?xml version="1.0" encoding="UTF-8"?>
<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2018-12-01T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2018-12-01</TIMEX3>
  <TEXT>Mujer de 28 años que <EVENT eid="e1" class="REPORTING" comment="e3c:permanence=FINITE">refiere</EVENT> <EVENT eid="e2" class="OCCURRENCE" comment="e3c:permanence=FINITE">epigastralgias</EVENT> y <EVENT eid="e3" class="OCCURRENCE" comment="e3c:permanence=FINITE">síndrome</EVENT> constitucional de <TIMEX3 tid="t1" type="DURATION" value="P1M" temporalFunction="false">un mes</TIMEX3> de <EVENT eid="e4" class="OCCURRENCE" comment="e3c:permanence=FINITE">evolución</EVENT>. La <EVENT eid="e5" class="OCCURRENCE" comment="e3c:permanence=FINITE">TC</EVENT> <EVENT eid="e6" class="REPORTING" comment="e3c:permanence=FINITE">mostró</EVENT> una <EVENT eid="e7" class="OCCURRENCE" comment="e3c:permanence=FINITE">masa</EVENT> de 15 x 13 x 7 cm dependiente del colon ascendente con <EVENT eid="e8" class="OCCURRENCE" comment="e3c:permanence=FINITE">metástasis</EVENT> hepáticas bilobares; se realizó una <EVENT eid="e9" class="OCCURRENCE" comment="e3c:permanence=FINITE">hemicolectomía</EVENT> derecha con <EVENT eid="e10" class="OCCURRENCE" comment="e3c:permanence=FINITE">biopsia</EVENT> hepática. La <EVENT eid="e11" class="OCCURRENCE" comment="e3c:permanence=FINITE">anatomía</EVENT> patológica <EVENT eid="e12" class="REPORTING" comment="e3c:permanence=FINITE">mostró</EVENT> un <EVENT eid="e13" class="OCCURRENCE" comment="e3c:permanence=FINITE">tumor</EVENT> formado por células fusiformes con gran <EVENT eid="e14" class="OCCURRENCE" comment="e3c:permanence=FINITE">actividad</EVENT> mitótica que, tras el <EVENT eid="e15" class="OCCURRENCE" comment="e3c:permanence=FINITE">examen</EVENT> ultraestructural e <EVENT eid="e16" class="OCCURRENCE" comment="e3c:permanence=FINITE">IHQ</EVENT> fue diagnóstico de <EVENT eid="e17" class="OCCURRENCE" comment="e3c:permanence=FINITE">GANT</EVENT>. Se realizó <EVENT eid="e18" class="OCCURRENCE" comment="e3c:permanence=FINITE">tratamiento</EVENT> adyuvante con imatinib 400 mg <TIMEX3 tid="t2" type="SET" value="P1D" temporalFunction="true">diarios</TIMEX3> vía oral. En la <EVENT eid="e19" class="OCCURRENCE" comment="e3c:permanence=FINITE">TC</EVENT> de seguimiento a <TIMEX3 tid="t3" type="DURATION" value="P6M" temporalFunction="false">los seis meses</TIMEX3> se <EVENT eid="e20" class="REPORTING" comment="e3c:permanence=FINITE">demostró</EVENT> una <EVENT eid="e21" class="OCCURRENCE" comment="e3c:permanence=FINITE">reducción</EVENT> parcial de las metástasis hepáticas, <TIMEX3 tid="t4" type="DURATION" value="P1Y" temporalFunction="false">al año</TIMEX3> una <EVENT eid="e22" class="OCCURRENCE" comment="e3c:permanence=FINITE">remisión</EVENT> completa y tras <TIMEX3 tid="t5" type="DURATION" value="P3Y" temporalFunction="false">tres años</TIMEX3> no hay datos de <EVENT eid="e23" class="OCCURRENCE" comment="e3c:permanence=FINITE">recidiva</EVENT> local ni a distancia.&#13;
</TEXT>
