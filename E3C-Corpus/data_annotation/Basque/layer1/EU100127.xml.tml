<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2014-01-10T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2014-01-10</TIMEX3>
  <TEXT><EVENT eid="e1" class="OCCURRENCE">AURREKARI</EVENT> PERTSONALAK&#13;
&#13;
Gizonezkoa, 81 urte.&#13;
&#13;
<EVENT eid="e2" class="OCCURRENCE">Hipergluzemia</EVENT>, <TIMEX3 tid="t1" type="DATE" value="2013-11" temporalFunction="false">2013ko azaroan</TIMEX3> <EVENT eid="e3" class="OCCURRENCE">diagnostikatua</EVENT>. &#13;
<EVENT eid="e4" class="OCCURRENCE">Tratamendu</EVENT> dietetikoan. &#13;
<EVENT eid="e5" class="OCCURRENCE">Hiperlipidemia</EVENT>. &#13;
<EVENT eid="e6" class="OCCURRENCE">Hipertentsio</EVENT> arteriala <EVENT eid="e7" class="OCCURRENCE">tratamenduan</EVENT>.&#13;
&#13;
Prostatako minbiziaren IV. <EVENT eid="e8" class="OCCURRENCE">maila</EVENT> egonkorra, <TIMEX3 tid="t2" type="DATE" value="PRESENT_REF" temporalFunction="true">gaur egun</TIMEX3> Onkologia Medikoak <EVENT eid="e9" class="OCCURRENCE">kontrolatua</EVENT>, <EVENT eid="e10" class="OCCURRENCE">tratamendu</EVENT> hormonala LHRH analogoekin.&#13;
&#13;
<TIMEX3 tid="t3" type="DATE" value="2002-02" temporalFunction="false">2002ko otsailean</TIMEX3> <EVENT eid="e11" class="OCCURRENCE">diagnostikatua</EVENT>. &#13;
Neo prostatako <EVENT eid="e12" class="OCCURRENCE">adenopatia</EVENT> zerbikal metastasikoa. &#13;
Urologiara <EVENT eid="e13" class="OCCURRENCE">bideratua</EVENT>. &#13;
Androcur bitartez <EVENT eid="e14" class="OCCURRENCE">tratatua</EVENT> hasieran eta <TIMEX3 tid="t4" type="SET" value="P3M" temporalFunction="true">hiruhileroko</TIMEX3> <EVENT eid="e15" class="OCCURRENCE">injekzio</EVENT> batekin. &#13;
Gerora, Onkologiara <EVENT eid="e16" class="OCCURRENCE">bideratua</EVENT> PSA <EVENT eid="e17" class="OCCURRENCE">handitzeagatik</EVENT>; bertan Zometa bidezko <EVENT eid="e18" class="OCCURRENCE">tratamendua</EVENT> jarri zioten (<TIMEX3 tid="t5" type="DATE" value="2007" temporalFunction="false">2007an</TIMEX3> inguru).&#13;
&#13;
&#13;
&#13;
<TIMEX3 tid="t6" type="DATE" value="PRESENT_REF" temporalFunction="true">ORAINGO</TIMEX3> <EVENT eid="e19" class="OCCURRENCE">GAIXOTASUNA</EVENT> (<TIMEX3 tid="t7" type="DATE" value="2011" temporalFunction="false">2011</TIMEX3>)&#13;
&#13;
<TIMEX3 tid="t8" type="DATE" value="2007-12" temporalFunction="false">2007ko abendua</TIMEX3>, Lehen Mailako <EVENT eid="e20" class="OCCURRENCE">Arreta</EVENT>: Barailako <EVENT eid="e21" class="OCCURRENCE">lesio</EVENT> zorneduna, Dermatologiara <EVENT eid="e22" class="OCCURRENCE">bideratua</EVENT>&#13;
&#13;
<TIMEX3 tid="t9" type="DATE" value="2008-04" temporalFunction="false">2008ko apirila</TIMEX3> AMK: <EVENT eid="e23" class="OCCURRENCE">Exodontzia</EVENT>. &#13;
<EVENT eid="e24" class="OCCURRENCE">Eboluzio</EVENT> nekeza&#13;
&#13;
<TIMEX3 tid="t10" type="DATE" value="2009-07" temporalFunction="false">2009ko uztaila</TIMEX3> Odontologia: 35-37.aren inguruan hezurra <EVENT eid="e25" class="OCCURRENCE">agerian</EVENT>, <TIMEX3 tid="t11" type="DURATION" value="P15M" temporalFunction="false">15 hilabetetik gorako</TIMEX3> <EVENT eid="e26" class="OCCURRENCE">eboluzioarekin</EVENT>, pieza baten <EVENT eid="e27" class="OCCURRENCE">exondontziaren</EVENT> ostean, zerbitzu horretan&#13;
&#13;
<TIMEX3 tid="t12" type="DATE" value="2011-11" temporalFunction="false">2011ko azaroa</TIMEX3> ezkerraldeko barailako <EVENT eid="e28" class="OCCURRENCE">haustura</EVENT> patologikoa&#13;
&#13;
&#13;
&#13;
<EVENT eid="e29" class="OCCURRENCE">PROBA</EVENT> OSAGARRIAK&#13;
&#13;
<TIMEX3 tid="t13" type="DATE" value="2012-02" temporalFunction="false">2012ko otsaila</TIMEX3> <EVENT eid="e30" class="OCCURRENCE">LMA</EVENT>&#13;
&#13;
<EVENT eid="e31" class="OCCURRENCE">Rx</EVENT>: <EVENT eid="e32" class="OCCURRENCE">ORTO</EVENT> eta <EVENT eid="e33" class="OCCURRENCE">OTA</EVENT>&#13;
</TEXT>
