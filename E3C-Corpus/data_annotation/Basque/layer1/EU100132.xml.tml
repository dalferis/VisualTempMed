<?xml version="1.0" encoding="UTF-8"?>
<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2014-10-10T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2014-10-10</TIMEX3>
  <TEXT><EVENT eid="e1" class="OCCURRENCE" comment="e3c:permanence=FINITE">AURREKARI</EVENT> PERTSONALAK&#13;
Gizonezkoa, 71 urte.&#13;
<EVENT eid="e2" class="OCCURRENCE" comment="e3c:permanence=FINITE">Hipertentsio</EVENT> Arteriala.&#13;
<EVENT eid="e3" class="OCCURRENCE" comment="e3c:permanence=FINITE">Kardiopatia</EVENT> erreumatikoa <EVENT eid="e4" class="OCCURRENCE" comment="e3c:permanence=FINITE">fibrilazio</EVENT> aurikular kronikoarekin, <EVENT eid="e5" class="OCCURRENCE" comment="e3c:permanence=FINITE">balbuloplastia</EVENT> mitrala eta <EVENT eid="e6" class="OCCURRENCE" comment="e3c:permanence=FINITE">protesi</EVENT> aortikoa.&#13;
<EVENT eid="e7" class="OCCURRENCE" comment="e3c:permanence=FINITE">Protesi</EVENT> aortiko mekanikoa <EVENT eid="e8" class="OCCURRENCE" comment="e3c:permanence=FINITE">GTE</EVENT> altuekin.&#13;
<EVENT eid="e9" class="OCCURRENCE" comment="e3c:permanence=FINITE">DLM</EVENT>&#13;
<EVENT eid="e10" class="OCCURRENCE" comment="e3c:permanence=FINITE">Disfuntzio</EVENT> sistoliko arina&#13;
Beheko <EVENT eid="e11" class="OCCURRENCE" comment="e3c:permanence=FINITE">nekrosia</EVENT>&#13;
<EVENT eid="e12" class="OCCURRENCE" comment="e3c:permanence=FINITE">BHT</EVENT> (<EVENT eid="e13" class="OCCURRENCE" comment="e3c:permanence=FINITE">htp</EVENT>) larria <TIMEX3 tid="t1" type="DATE" value="2009" temporalFunction="false">2009an</TIMEX3>, ezkerreko giltzurruneko I estadioko (<EVENT eid="e14" class="OCCURRENCE" comment="e3c:permanence=FINITE">erremisioan</EVENT>) adenokartzinoma papilar baten <EVENT eid="e15" class="OCCURRENCE" comment="e3c:permanence=FINITE">ablazioa</EVENT> irrati-maiztasunez.&#13;
<TIMEX3 tid="t2" type="DATE" value="2012" temporalFunction="false">2012an</TIMEX3>, <EVENT eid="e16" class="OCCURRENCE" comment="e3c:permanence=FINITE">sigmoidektomia</EVENT> laparoskopikoa, sigmako maila baxuko II estadioko <EVENT eid="e17" class="OCCURRENCE" comment="e3c:permanence=FINITE">adenokartzinoma</EVENT> (<EVENT eid="e18" class="OCCURRENCE" comment="e3c:permanence=FINITE">erremisioan</EVENT>) dela-eta.&#13;
<EVENT eid="e19" class="STATE" comment="e3c:permanence=PERMANENT">Hepatitis</EVENT> kronikoa C hepatitisaren birusagatik, <TIMEX3 tid="t3" type="SET" value="P6M" temporalFunction="true">6 hilean behingo</TIMEX3> Screening <EVENT eid="e20" class="OCCURRENCE" comment="e3c:permanence=FINITE">ekografiaz</EVENT> kontrolatuta.&#13;
Ohiko <EVENT eid="e21" class="OCCURRENCE" comment="e3c:permanence=FINITE">tratamendua</EVENT>:&#13;
Bisoprolol <EVENT eid="e22" class="OCCURRENCE" comment="e3c:permanence=FINITE">hemifumaratoa</EVENT>, <EVENT eid="e23" class="OCCURRENCE" comment="e3c:permanence=FINITE">Esplerenona</EVENT>, <EVENT eid="e24" class="OCCURRENCE" comment="e3c:permanence=FINITE">Azenokumarola</EVENT>, <EVENT eid="e25" class="OCCURRENCE" comment="e3c:permanence=FINITE">Omeprazola</EVENT> eta <EVENT eid="e26" class="OCCURRENCE" comment="e3c:permanence=FINITE">Lorazepama</EVENT>.&#13;
&#13;
<TIMEX3 tid="t4" type="DATE" value="PRESENT_REF" temporalFunction="true">ORAINGO</TIMEX3> <EVENT eid="e27" class="OCCURRENCE" comment="e3c:permanence=FINITE">GAIXOTASUNA</EVENT>&#13;
CHB-k (vhc) eragindako <EVENT eid="e28" class="STATE" comment="e3c:permanence=PERMANENT">hepatopatia</EVENT> kontrolatzeko <EVENT eid="e29" class="OCCURRENCE" comment="e3c:permanence=FINITE">screening-ekografian</EVENT>, <EVENT eid="e30" class="OCCURRENCE" comment="e3c:permanence=FINITE">lesio</EVENT> fokal hipoekogenikoa <EVENT eid="e31" class="REPORTING" comment="e3c:permanence=FINITE">atzeman</EVENT> da lehen aldiz, VI-VII segmentuan.&#13;
<EVENT eid="e32" class="OCCURRENCE" comment="e3c:permanence=FINITE">Analitika</EVENT>:&#13;
<EVENT eid="e33" class="OCCURRENCE" comment="e3c:permanence=FINITE">AST</EVENT>/GOT:50 U/L&#13;
<EVENT eid="e34" class="OCCURRENCE" comment="e3c:permanence=FINITE">ALT</EVENT>/GPT:54 U/L&#13;
<EVENT eid="e35" class="OCCURRENCE" comment="e3c:permanence=FINITE">GGT</EVENT>:58 U/L&#13;
<EVENT eid="e36" class="OCCURRENCE" comment="e3c:permanence=FINITE">Bb</EVENT> guztira:0,67 mg/dL&#13;
<EVENT eid="e37" class="OCCURRENCE" comment="e3c:permanence=FINITE">Albumina</EVENT>:4,2 g/dL&#13;
<EVENT eid="e38" class="OCCURRENCE" comment="e3c:permanence=FINITE">INR</EVENT>: 2,91&#13;
<EVENT eid="e39" class="OCCURRENCE" comment="e3c:permanence=FINITE">IP</EVENT> %27&#13;
<EVENT eid="e40" class="OCCURRENCE" comment="e3c:permanence=FINITE">AFP</EVENT>:4,9 ng/mL&#13;
&#13;
<EVENT eid="e41" class="OCCURRENCE" comment="e3c:permanence=FINITE">Aurkikuntza</EVENT> horiek direla-kausa, eta <EVENT eid="e42" class="OCCURRENCE" comment="e3c:permanence=FINITE">ekografian</EVENT> identifikatutako <EVENT eid="e43" class="OCCURRENCE" comment="e3c:permanence=FINITE">lesio</EVENT> fokala <EVENT eid="e44" class="OCCURRENCE" comment="e3c:permanence=FINITE">aztertzeko</EVENT>, <EVENT eid="e45" class="OCCURRENCE" comment="e3c:permanence=FINITE">OT</EVENT> abdominopelbikoa egin zaio, bena barneko <EVENT eid="e46" class="OCCURRENCE" comment="e3c:permanence=FINITE">kontrasterik</EVENT> gabe eta <EVENT eid="e47" class="OCCURRENCE" comment="e3c:permanence=FINITE">sartu</EVENT> ondoren, fase arterialean eta benosoan; eta, <EVENT eid="e48" class="OCCURRENCE" comment="e3c:permanence=FINITE">azterketa</EVENT>, <EVENT eid="e49" class="OCCURRENCE" comment="e3c:permanence=FINITE">EM</EVENT> eta <EVENT eid="e50" class="OCCURRENCE" comment="e3c:permanence=FINITE">biopsiarekin</EVENT> osatu da.</TEXT>
