<?xml version="1.0" encoding="UTF-8"?>
<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2014-12-12T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2014-12-12</TIMEX3>
  <TEXT><EVENT eid="e1" class="OCCURRENCE">KONTSULTARAKO</EVENT> ARRAZOIA&#13;
45 urteko gizonezkoa, larrialdietara <EVENT eid="e2" class="OCCURRENCE">jo</EVENT> duena eskuineko begian <EVENT eid="e3" class="OCCURRENCE">ikusmen-zorroztasuna</EVENT> <EVENT eid="e4" class="OCCURRENCE">murriztu</EVENT> zaiolako, <TIMEX3 tid="t1" type="DURATION" value="P1D" temporalFunction="false">egun bateko</TIMEX3> <EVENT eid="e5" class="OCCURRENCE">eboluzioarekin</EVENT>.&#13;
<EVENT eid="e6" class="OCCURRENCE">AURREKARI</EVENT> PERTSONALAK&#13;
-Medikamentuekiko <EVENT eid="e7" class="OCCURRENCE">alergia</EVENT> ezagunik ez.&#13;
-<EVENT eid="e8" class="REPORTING">Adierazidu</EVENT> ez duela <EVENT eid="e9" class="OCCURRENCE">gaixotasun</EVENT> ezagunik izan, eta ez dagoela ohiko <EVENT eid="e10" class="OCCURRENCE">tratamenduren</EVENT> baten pean.&#13;
Aurretik ez dio <EVENT eid="e11" class="OCCURRENCE">kontsultarik</EVENT> egin medikuari.&#13;
-<EVENT eid="e12" class="OCCURRENCE">Obesitatea</EVENT>&#13;
-1 pakete/eguneko <EVENT eid="e13" class="OCCURRENCE">erretzailea</EVENT>. Noizbehinka <EVENT eid="e14" class="OCCURRENCE">edaten</EVENT> du&#13;
-<EVENT eid="e15" class="OCCURRENCE">Informatikaria</EVENT>, <EVENT eid="e16" class="OCCURRENCE">langabezian</EVENT>&#13;
-<EVENT eid="e17" class="OCCURRENCE">Ezkongabea</EVENT>. Seme-alabarik ez.&#13;
FAMILIAKO <EVENT eid="e18" class="OCCURRENCE">AURREKARIAK</EVENT>&#13;
-Amak <EVENT eid="e19" class="OCCURRENCE">DM</EVENT> 2 motakoa.&#13;
-Aita eta anaia <EVENT eid="e20" class="OCCURRENCE">bizirik</EVENT> eta <EVENT eid="e21" class="OCCURRENCE">osasuntsu</EVENT>, nabarmendu beharreko <EVENT eid="e22" class="OCCURRENCE">aurrekaririk</EVENT> gabe.&#13;
<EVENT eid="e23" class="OCCURRENCE">MIAKETA</EVENT> FISIKOA&#13;
-<EVENT eid="e24" class="OCCURRENCE">TA</EVENT> 190/110 mm Hg, <EVENT eid="e25" class="OCCURRENCE">BM</EVENT> 90l.p.m, <EVENT eid="e26" class="OCCURRENCE">Tª</EVENT> 36,5ºC&#13;
-<EVENT eid="e27" class="OCCURRENCE">Pisua</EVENT>: 114 Kg, <EVENT eid="e28" class="OCCURRENCE">Altuera</EVENT> 1,75 cm, <EVENT eid="e29" class="OCCURRENCE">GMI</EVENT>: 37,22 kg/m2&#13;
-<EVENT eid="e30" class="OCCURRENCE">Azterketa</EVENT> oftalmologikoao&#13;
<EVENT eid="e31" class="OCCURRENCE">AVL</EVENT> (urruneko <EVENT eid="e32" class="OCCURRENCE">ikusmen-zorroztasuna</EVENT>)&#13;
OD (eskuineko begia): 0,3 berezkoa, ez da <EVENT eid="e33" class="OCCURRENCE">hobetzen</EVENT> <EVENT eid="e34" class="OCCURRENCE">estenopeikoa</EVENT> erabilita.&#13;
OI (ezkerreko begia): 1 berezkoa&#13;
<EVENT eid="e35" class="OCCURRENCE">BMC</EVENT> AO (<EVENT eid="e36" class="OCCURRENCE">Biomikroskopia</EVENT> edo Begi Biak arrakala-lanparaz <EVENT eid="e37" class="OCCURRENCE">aztertzea</EVENT>): Aurreko poloa, normal&#13;
<EVENT eid="e38" class="OCCURRENCE">PIO</EVENT> (begi barruko <EVENT eid="e39" class="OCCURRENCE">presioa</EVENT>): 15/17 mm Hg Goldmann-en tonometroa&#13;
FO (begi-hondoa) <EVENT eid="e40" class="OCCURRENCE">midriasi</EVENT> farmakologikoz (<EVENT eid="e41" class="OCCURRENCE">tropikamida</EVENT> + <EVENT eid="e42" class="OCCURRENCE">fenilefrina</EVENT>)::&#13;
OD (eskuineko begia): Erretina barruko <EVENT eid="e43" class="OCCURRENCE">odoljarioak</EVENT> suar eran; lau koadranteetan, <EVENT eid="e44" class="OCCURRENCE">exudatu</EVENT> gogor makular eta bigunak/kotoikarak.&#13;
<EVENT eid="e45" class="OCCURRENCE">Bena-dilatazioa</EVENT> eta -<EVENT eid="e46" class="OCCURRENCE">bihurritasuna</EVENT>.&#13;
-<EVENT eid="e47" class="OCCURRENCE">Proba</EVENT> osagarriak:&#13;
<EVENT eid="e48" class="OCCURRENCE">SD-OCT</EVENT> (eremu espektralaren koherentzia optikoaren <EVENT eid="e49" class="OCCURRENCE">tomografia</EVENT>):&#13;
OD:<EVENT eid="e50" class="OCCURRENCE">Edema</EVENT> makular kistikoa erretina barruan.&#13;
<EVENT eid="e51" class="OCCURRENCE">Erretinografia</EVENT>:&#13;
OD: FO ODn azaldutakoa.&#13;
<EVENT eid="e52" class="OCCURRENCE">Angiografia</EVENT>, <EVENT eid="e53" class="OCCURRENCE">fluoreszeina</EVENT> baliatuta:&#13;
OD:<EVENT eid="e54" class="OCCURRENCE">Edema</EVENT> makular zistoidea, <EVENT eid="e55" class="OCCURRENCE">iskemia</EVENT> periferikoekin, <EVENT eid="e56" class="OCCURRENCE">neo-hodirik</EVENT> gabe.&#13;
-<EVENT eid="e57" class="OCCURRENCE">Odol-analisia</EVENT>:&#13;
<EVENT eid="e58" class="OCCURRENCE">Biokimika</EVENT>:<EVENT eid="e59" class="OCCURRENCE">Glukosa</EVENT> 214 mg/dL, <EVENT eid="e60" class="OCCURRENCE">urea</EVENT> 36 mg/dl, <EVENT eid="e61" class="OCCURRENCE">kreatinina</EVENT> 0,67 mg/dl, <EVENT eid="e62" class="OCCURRENCE">azido</EVENT> urikoa 7,22 mg/dl, <EVENT eid="e63" class="OCCURRENCE">kolesterol</EVENT> osoa 181 mg/dl, HDL <EVENT eid="e64" class="OCCURRENCE">kolesterola</EVENT> 26mg/dl, <EVENT eid="e65" class="OCCURRENCE">kolesterol</EVENT> ez-HDL 155 mg/dl, <EVENT eid="e66" class="OCCURRENCE">triglizeridoak</EVENT> 236mg/dl, <EVENT eid="e67" class="OCCURRENCE">Sodioa</EVENT> 134.0 mmol/L.&#13;
<EVENT eid="e68" class="OCCURRENCE">Urea</EVENT>, <EVENT eid="e69" class="OCCURRENCE">Kreatinina</EVENT>, <EVENT eid="e70" class="OCCURRENCE">alb</EVENT>, <EVENT eid="e71" class="OCCURRENCE">Bb</EVENT>, <EVENT eid="e72" class="OCCURRENCE">ALT</EVENT>, <EVENT eid="e73" class="OCCURRENCE">Ca</EVENT>, <EVENT eid="e74" class="OCCURRENCE">K</EVENT> normalak.&#13;
<EVENT eid="e75" class="OCCURRENCE">AST</EVENT>/GOT 20 U/L, <EVENT eid="e76" class="OCCURRENCE">ALT</EVENT>/GPT 29 U/L, <EVENT eid="e77" class="OCCURRENCE">GGT</EVENT> 83&#13;
<EVENT eid="e78" class="OCCURRENCE">Hb</EVENT> A1c (NGSP/DCCT) 11.5%, <EVENT eid="e79" class="OCCURRENCE">Hb</EVENT> A1c (IFCC) 102mmol/mol&#13;
<EVENT eid="e80" class="OCCURRENCE">Hematimetria</EVENT>: <EVENT eid="e81" class="OCCURRENCE">Hematíeak</EVENT> 4,76x106, <EVENT eid="e82" class="OCCURRENCE">hemoglobina</EVENT> 14.4 g/dL, <EVENT eid="e83" class="OCCURRENCE">Plaketak</EVENT> eta <EVENT eid="e84" class="OCCURRENCE">leukozitoak</EVENT>, normalak.&#13;
-<EVENT eid="e85" class="OCCURRENCE">Gernu-analisia</EVENT>: <EVENT eid="e86" class="OCCURRENCE">Dentsitatea</EVENT> 1.034, <EVENT eid="e87" class="OCCURRENCE">Proteinak</EVENT> 200 mg/dL, <EVENT eid="e88" class="OCCURRENCE">Glukosa</EVENT> 1000 mg/dL, <EVENT eid="e89" class="OCCURRENCE">Gorputz</EVENT> zetonikoak 20mg/dL.&#13;
<EVENT eid="e90" class="OCCURRENCE">Gainerakoa</EVENT>, normala.&#13;
-<EVENT eid="e91" class="OCCURRENCE">EKG</EVENT>, toraxeko <EVENT eid="e92" class="OCCURRENCE">Rx</EVENT>, garuneko <EVENT eid="e93" class="OCCURRENCE">OTA</EVENT>: <EVENT eid="e94" class="OCCURRENCE">aurkikuntza</EVENT> esanguratsurik gabe.&#13;
-Abdomeneko <EVENT eid="e95" class="OCCURRENCE">ekografia</EVENT>: gibel koipetsua</TEXT>
