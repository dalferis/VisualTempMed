<?xml version="1.0" encoding="UTF-8"?>
<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2014-12-31T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2014-12-31</TIMEX3>
  <TEXT>LARRIALDIAK&#13;
<EVENT eid="e1" class="OCCURRENCE" comment="e3c:permanence=FINITE">OSPITALERATZEKO</EVENT> ARRAZOIA.&#13;
<EVENT eid="e2" class="OCCURRENCE" comment="e3c:permanence=FINITE">Botaka</EVENT> egiteagatik <EVENT eid="e3" class="OCCURRENCE" comment="e3c:permanence=FINITE">etorri</EVENT> den 63 urteko gizonezkoa.&#13;
AURREKARIAK&#13;
Ez du farmakoekiko <EVENT eid="e4" class="OCCURRENCE" comment="e3c:permanence=FINITE">alergiarik</EVENT>.&#13;
Ez du <EVENT eid="e5" class="OCCURRENCE" comment="e3c:permanence=FINITE">hipertentsiorik</EVENT>, <EVENT eid="e6" class="OCCURRENCE" comment="e3c:permanence=FINITE">diabetesik</EVENT> edo <EVENT eid="e7" class="OCCURRENCE" comment="e3c:permanence=FINITE">dislipemiarik</EVENT>.&#13;
<EVENT eid="e8" class="OCCURRENCE" comment="e3c:permanence=FINITE">Erretzailea</EVENT> da, 2 <EVENT eid="e9" class="OCCURRENCE" comment="e3c:permanence=FINITE">pakete</EVENT> eguneko.&#13;
<TIMEX3 tid="t1" type="DATE" value="2006" temporalFunction="false">2006an</TIMEX3> <EVENT eid="e10" class="OCCURRENCE" comment="e3c:permanence=FINITE">istripu</EVENT> iskemiko iragankorra izan zuen, <EVENT eid="e11" class="OCCURRENCE" comment="e3c:permanence=FINITE">ondoriorik</EVENT> <EVENT eid="e12" class="OCCURRENCE" comment="e3c:permanence=FINITE">utzi</EVENT> ez ziona.&#13;
<TIMEX3 tid="t2" type="DATE" value="2011-08" temporalFunction="false">2011ko abuztuan</TIMEX3> eskuineko giltzurrunean 6,5 cm-ko <EVENT eid="e13" class="OCCURRENCE" comment="e3c:permanence=FINITE">tumore</EVENT> bat <EVENT eid="e14" class="OCCURRENCE" comment="e3c:permanence=FINITE">aurkitu</EVENT> diote, pedikulua <EVENT eid="e15" class="OCCURRENCE" comment="e3c:permanence=FINITE">infiltratzen</EVENT> duena.&#13;
<EVENT eid="e16" class="OCCURRENCE" comment="e3c:permanence=FINITE">Tratamenduan</EVENT> dago: <EVENT eid="e17" class="OCCURRENCE" comment="e3c:permanence=FINITE">Sintrom</EVENT> eta <EVENT eid="e18" class="OCCURRENCE" comment="e3c:permanence=FINITE">metamizola</EVENT>, <EVENT eid="e19" class="OCCURRENCE" comment="e3c:permanence=FINITE">minaren</EVENT> arabera.&#13;
<TIMEX3 tid="t3" type="DATE" value="PRESENT_REF" temporalFunction="true">EGUNGO</TIMEX3> HISTORIA.&#13;
Pazienteak <EVENT eid="e20" class="REPORTING" comment="e3c:permanence=FINITE">dio</EVENT> <TIMEX3 tid="t4" type="DURATION" value="P1M" temporalFunction="false">duela hilabete batetik</TIMEX3> <TIMEX3 tid="t5" type="SET" value="P1D" temporalFunction="true">egunero</TIMEX3> <TIMEX3 tid="t6" type="SET" value="X" temporalFunction="true" comment="e3c:timex3Class=QUANTIFIER; e3c:value=NO_VALUE">hainbat alditan</TIMEX3> egiten duela <EVENT eid="e21" class="OCCURRENCE" comment="e3c:permanence=FINITE">botaka</EVENT>.&#13;
<TIMEX3 tid="t7" type="DATE" value="2014-12-30" temporalFunction="false">Atzotik</TIMEX3> ezin du ezer <EVENT eid="e22" class="OCCURRENCE" comment="e3c:permanence=FINITE">jan</EVENT>, eta jandako guztia <EVENT eid="e23" class="OCCURRENCE" comment="e3c:permanence=FINITE">botatzen</EVENT> du.&#13;
Ez du <EVENT eid="e24" class="OCCURRENCE" comment="e3c:permanence=FINITE">minik</EVENT>, ez <EVENT eid="e25" class="OCCURRENCE" comment="e3c:permanence=FINITE">sukarrik</EVENT>, ez <EVENT eid="e26" class="OCCURRENCE" comment="e3c:permanence=FINITE">zorabiorik</EVENT>, ez bestelako <EVENT eid="e27" class="OCCURRENCE" comment="e3c:permanence=FINITE">sintomarik</EVENT> ere.&#13;
Hesteetako erritmoa ez zaio <EVENT eid="e28" class="OCCURRENCE" comment="e3c:permanence=FINITE">aldatu</EVENT>.&#13;
<EVENT eid="e29" class="OCCURRENCE" comment="e3c:permanence=FINITE">AZTERKETA</EVENT> FISIKOA.&#13;
<EVENT eid="e30" class="OCCURRENCE" comment="e3c:permanence=FINITE">Tentsio</EVENT> arteriala (<EVENT eid="e31" class="OCCURRENCE" comment="e3c:permanence=FINITE">TA</EVENT>), 131/86 mm Hg; <EVENT eid="e32" class="OCCURRENCE" comment="e3c:permanence=FINITE">bihotz-maiztasuna</EVENT> (<EVENT eid="e33" class="OCCURRENCE" comment="e3c:permanence=FINITE">BM</EVENT>), 79 tau/min; arnas <EVENT eid="e34" class="OCCURRENCE" comment="e3c:permanence=FINITE">maiztasuna</EVENT> (<EVENT eid="e35" class="OCCURRENCE" comment="e3c:permanence=FINITE">AM</EVENT>), 20 arnas/min; <EVENT eid="e36" class="OCCURRENCE" comment="e3c:permanence=FINITE">O2Sat</EVENT>,% 97; <EVENT eid="e37" class="OCCURRENCE" comment="e3c:permanence=FINITE">tenperatura</EVENT> (<EVENT eid="e38" class="OCCURRENCE" comment="e3c:permanence=FINITE">T</EVENT>), 36 ºC.&#13;
Pazientea <EVENT eid="e39" class="OCCURRENCE" comment="e3c:permanence=FINITE">kontziente</EVENT> dago, <EVENT eid="e40" class="OCCURRENCE" comment="e3c:permanence=FINITE">orientatua</EVENT>, ondo <EVENT eid="e41" class="OCCURRENCE" comment="e3c:permanence=FINITE">elikatua</EVENT> eta <EVENT eid="e42" class="OCCURRENCE" comment="e3c:permanence=FINITE">hidratatua</EVENT>; eta <EVENT eid="e43" class="OCCURRENCE" comment="e3c:permanence=FINITE">eupneiko</EVENT>.&#13;
Larruazal eta mukosen <EVENT eid="e44" class="OCCURRENCE" comment="e3c:permanence=FINITE">kolorazioa</EVENT> normala da.&#13;
Burua eta lepoa.&#13;
Ez dauka <EVENT eid="e45" class="OCCURRENCE" comment="e3c:permanence=FINITE">ingurgitazio</EVENT> jugularrik, <EVENT eid="e46" class="OCCURRENCE" comment="e3c:permanence=FINITE">adenopatiarik</EVENT> ere ez.&#13;
Ez dauka <EVENT eid="e47" class="OCCURRENCE" comment="e3c:permanence=FINITE">zeinu</EVENT> meningeorik.&#13;
Toraxa.&#13;
Biriken <EVENT eid="e48" class="OCCURRENCE" comment="e3c:permanence=FINITE">auskultazioa</EVENT>: biriketako <EVENT eid="e49" class="OCCURRENCE" comment="e3c:permanence=FINITE">aireztapen</EVENT> normala, ez da <EVENT eid="e50" class="REPORTING" comment="e3c:permanence=FINITE">entzuten</EVENT> ohikoez gaindiko <EVENT eid="e51" class="OCCURRENCE" comment="e3c:permanence=FINITE">hotsik</EVENT>.&#13;
Bihotzaren <EVENT eid="e52" class="OCCURRENCE" comment="e3c:permanence=FINITE">auskultazioa</EVENT>: <EVENT eid="e53" class="OCCURRENCE" comment="e3c:permanence=FINITE">erritmikoa</EVENT>, ez da <EVENT eid="e54" class="OCCURRENCE" comment="e3c:permanence=FINITE">murmuriorik</EVENT> <EVENT eid="e55" class="REPORTING" comment="e3c:permanence=FINITE">entzuten</EVENT>.&#13;
Sabela.&#13;
<EVENT eid="e56" class="OCCURRENCE" comment="e3c:permanence=FINITE">Biguna</EVENT> eta <EVENT eid="e57" class="OCCURRENCE" comment="e3c:permanence=FINITE">zanpagarria</EVENT>.&#13;
<EVENT eid="e58" class="OCCURRENCE" comment="e3c:permanence=FINITE">Min</EVENT> hartzen du eskuineko hipokondrioa eta hobi iliakoa <EVENT eid="e59" class="OCCURRENCE" comment="e3c:permanence=FINITE">ukitzean</EVENT>.&#13;
Ez dauka peritoneoko <EVENT eid="e60" class="OCCURRENCE" comment="e3c:permanence=FINITE">narritadurarik</EVENT>.&#13;
<EVENT eid="e61" class="OCCURRENCE" comment="e3c:permanence=FINITE">Sabel-soinu</EVENT> normalak.&#13;
Ez da organoen <EVENT eid="e62" class="OCCURRENCE" comment="e3c:permanence=FINITE">hanturarik</EVENT> <EVENT eid="e63" class="REPORTING" comment="e3c:permanence=FINITE">nabaritzen</EVENT>, ez eta bestelako <EVENT eid="e64" class="OCCURRENCE" comment="e3c:permanence=FINITE">masarik</EVENT> ere.&#13;
Gorputz-adarrak.&#13;
<EVENT eid="e65" class="OCCURRENCE" comment="e3c:permanence=FINITE">Edemarik</EVENT> ez; ez dago bena sakonetako <EVENT eid="e66" class="OCCURRENCE" comment="e3c:permanence=FINITE">tronbosi-zeinurik</EVENT>.&#13;
<EVENT eid="e67" class="OCCURRENCE" comment="e3c:permanence=FINITE">PROBA</EVENT> OSAGARRIEN LABURPENA&#13;
<EVENT eid="e68" class="OCCURRENCE" comment="e3c:permanence=FINITE">BIOKIMIKA</EVENT>, <EVENT eid="e69" class="OCCURRENCE" comment="e3c:permanence=FINITE">HEMOGRAMA</EVENT> ETA <EVENT eid="e70" class="OCCURRENCE" comment="e3c:permanence=FINITE">KOAGULAZIOA</EVENT>.&#13;
Ez dago neurriz kanpoko <EVENT eid="e71" class="OCCURRENCE" comment="e3c:permanence=FINITE">baliorik</EVENT>.&#13;
ABDOMENEKO <EVENT eid="e72" class="OCCURRENCE" comment="e3c:permanence=FINITE">ERRADIOGRAFIA</EVENT>.&#13;
Heste meharreko zatien <EVENT eid="e73" class="OCCURRENCE" comment="e3c:permanence=FINITE">zabalkuntza</EVENT>, zutikako <EVENT eid="e74" class="OCCURRENCE" comment="e3c:permanence=FINITE">erradiografian</EVENT> <EVENT eid="e75" class="OCCURRENCE" comment="e3c:permanence=FINITE">maila</EVENT> hidroaereoak dituena.&#13;
Ez da marko kolikoan <EVENT eid="e76" class="OCCURRENCE" comment="e3c:permanence=FINITE">airerik</EVENT> <EVENT eid="e77" class="REPORTING" comment="e3c:permanence=FINITE">ikusten</EVENT>.&#13;
<EVENT eid="e78" class="OCCURRENCE" comment="e3c:permanence=FINITE">Hori</EVENT> guztia heste meharreko <EVENT eid="e79" class="REPORTING" comment="e3c:permanence=FINITE">suboklusioarekin</EVENT> bateragarria da.&#13;
<EVENT eid="e80" class="OCCURRENCE" comment="e3c:permanence=FINITE">EBOLUZIOA</EVENT> ETA <EVENT eid="e81" class="OCCURRENCE" comment="e3c:permanence=FINITE">IRUZKINAK</EVENT>.&#13;
<EVENT eid="e82" class="OCCURRENCE" comment="e3c:permanence=FINITE">DIAGNOSTIKO</EVENT> NAGUSIA.&#13;
Heste meharreko <EVENT eid="e83" class="OCCURRENCE" comment="e3c:permanence=FINITE">suboklusioa</EVENT>.&#13;
BESTE <EVENT eid="e84" class="OCCURRENCE" comment="e3c:permanence=FINITE">DIAGNOSTIKO</EVENT> BATZUK.&#13;
Giltzurruneko <EVENT eid="e85" class="OCCURRENCE" comment="e3c:permanence=FINITE">neoplasia</EVENT>.&#13;
<EVENT eid="e86" class="OCCURRENCE" comment="e3c:permanence=FINITE">TRATAMENDUA</EVENT>.&#13;
<EVENT eid="e87" class="OCCURRENCE" comment="e3c:permanence=FINITE">Metoklopramida</EVENT> behar du; anpulu bat zain barnetik.</TEXT>
