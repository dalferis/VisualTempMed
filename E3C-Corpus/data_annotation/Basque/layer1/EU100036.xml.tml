<?xml version="1.0" encoding="UTF-8"?>
<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2014-12-31T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2014-12-31</TIMEX3>
  <TEXT>ANESTESIOLOGIA ETA BERPIZTEA&#13;
<EVENT eid="e1" class="OCCURRENCE" comment="e3c:permanence=FINITE">OSPITALERATZEKO</EVENT>/<EVENT eid="e2" class="OCCURRENCE" comment="e3c:permanence=FINITE">KONTSULTARAKO</EVENT> ARRAZOIA.&#13;
Tenporalaren eta masailezurraren arteko <EVENT eid="e3" class="OCCURRENCE" comment="e3c:permanence=FINITE">artroplastia</EVENT> egin ondoren, <EVENT eid="e4" class="OCCURRENCE" comment="e3c:permanence=FINITE">lekualdaturiko</EVENT> 67 urteko gizonezkoa.&#13;
<EVENT eid="e5" class="OCCURRENCE" comment="e3c:permanence=FINITE">ALTAREN</EVENT> ARRAZOIA.&#13;
Ahoko eta Aurpegi-masailetako Kirurgiako Zerbitzura <EVENT eid="e6" class="OCCURRENCE" comment="e3c:permanence=FINITE">lekualdatzea</EVENT>.&#13;
AURREKARIAK.&#13;
<EVENT eid="e7" class="OCCURRENCE" comment="e3c:permanence=FINITE">Alergia</EVENT> die penizilinari, pobidona iododunari eta Anisakisari; <EVENT eid="e8" class="OCCURRENCE" comment="e3c:permanence=FINITE">erretzaile</EVENT> ohia da, <EVENT eid="e9" class="OCCURRENCE" comment="e3c:permanence=FINITE">hipertentsio</EVENT> arteriala du eta giltzurruneko <EVENT eid="e10" class="OCCURRENCE" comment="e3c:permanence=FINITE">gutxiegitasun</EVENT> arina; <EVENT eid="e11" class="OCCURRENCE" comment="e3c:permanence=FINITE">litotriziaren</EVENT> bidez <EVENT eid="e12" class="OCCURRENCE" comment="e3c:permanence=FINITE">tratatutako</EVENT> giltzurruneko <EVENT eid="e13" class="OCCURRENCE" comment="e3c:permanence=FINITE">litiasia</EVENT>, <TIMEX3 tid="t1" type="DATE" value="1997" temporalFunction="false">1997an</TIMEX3>; ezkerreko zangoko zain sakoneko <EVENT eid="e14" class="OCCURRENCE" comment="e3c:permanence=FINITE">tronbosia</EVENT>, <TIMEX3 tid="t2" type="DATE" value="2003-01" temporalFunction="false">2003ko urtarril</TIMEX3> eta <TIMEX3 tid="t3" type="DATE" value="2003-05" temporalFunction="false">maiatzean</TIMEX3>; <EVENT eid="e15" class="OCCURRENCE" comment="e3c:permanence=FINITE">hezueria</EVENT> bi oinetan; sorbaldetako <EVENT eid="e16" class="OCCURRENCE" comment="e3c:permanence=FINITE">tendinitisa</EVENT> eta <EVENT eid="e17" class="OCCURRENCE" comment="e3c:permanence=FINITE">pneumonia</EVENT>, <TIMEX3 tid="t4" type="DATE" value="2012-02" temporalFunction="false">2012ko otsailean</TIMEX3>.&#13;
<EVENT eid="e18" class="OCCURRENCE" comment="e3c:permanence=FINITE">Ebakuntzak</EVENT>: ezkerreko aldakaren eta matrailaren <EVENT eid="e19" class="OCCURRENCE" comment="e3c:permanence=FINITE">hausturak</EVENT>, <EVENT eid="e20" class="OCCURRENCE" comment="e3c:permanence=FINITE">trafiko-istripu</EVENT> batean, <TIMEX3 tid="t5" type="DATE" value="1974" temporalFunction="false">1974an</TIMEX3>; <EVENT eid="e21" class="OCCURRENCE" comment="e3c:permanence=FINITE">disko-hernia</EVENT> eta <EVENT eid="e22" class="OCCURRENCE" comment="e3c:permanence=FINITE">odoluzkiak</EVENT>.&#13;
Ohiko <EVENT eid="e23" class="OCCURRENCE" comment="e3c:permanence=FINITE">tratamendua</EVENT>: <EVENT eid="e24" class="OCCURRENCE" comment="e3c:permanence=FINITE">Valsartan</EVENT> ®, 160 mg-ko 1 pilula egunean; <EVENT eid="e25" class="OCCURRENCE" comment="e3c:permanence=FINITE">alopurinola</EVENT>, 300 mg-ko 1 pilula egunean; <EVENT eid="e26" class="OCCURRENCE" comment="e3c:permanence=FINITE">Sintrom</EVENT> ®, Hematologiako Zerbitzuak <EVENT eid="e27" class="OCCURRENCE" comment="e3c:permanence=FINITE">zehaztutako</EVENT> dosian.&#13;
<TIMEX3 tid="t6" type="DATE" value="PRESENT_REF" temporalFunction="true">EGUNGO</TIMEX3> <EVENT eid="e28" class="OCCURRENCE" comment="e3c:permanence=FINITE">GAIXOTASUNA</EVENT>.&#13;
Aspaldiko <EVENT eid="e29" class="OCCURRENCE" comment="e3c:permanence=FINITE">traumatismoaren</EVENT> ondorioz, pazienteak masailezurraren eta tenporalaren arteko <EVENT eid="e30" class="OCCURRENCE" comment="e3c:permanence=FINITE">ankilosia</EVENT> zuen. &#13;
<TIMEX3 tid="t7" type="DATE" value="2013-11-27" temporalFunction="false">2013ko azaroaren 27an</TIMEX3>, programatutako <EVENT eid="e31" class="OCCURRENCE" comment="e3c:permanence=FINITE">ebakuntza</EVENT> egin zaio.&#13;
Ankilosaturiko eremu osoa blokean <EVENT eid="e32" class="OCCURRENCE" comment="e3c:permanence=FINITE">erauzi</EVENT> eta aldez aurretik <EVENT eid="e33" class="OCCURRENCE" comment="e3c:permanence=FINITE">prestaturiko</EVENT> plaka bat <EVENT eid="e34" class="OCCURRENCE" comment="e3c:permanence=FINITE">kokatu</EVENT> da hobi mandibularrean.&#13;
<EVENT eid="e35" class="OCCURRENCE" comment="e3c:permanence=FINITE">Erauzketa</EVENT> egitean, kanpoko entzunbideko mintz tinpanikoa <EVENT eid="e36" class="OCCURRENCE" comment="e3c:permanence=FINITE">hautsi</EVENT> da.&#13;
Otorrinolaringologoak <EVENT eid="e37" class="OCCURRENCE" comment="e3c:permanence=FINITE">haustura</EVENT> <EVENT eid="e38" class="REPORTING" comment="e3c:permanence=FINITE">baieztatu</EVENT> du eta <EVENT eid="e39" class="OCCURRENCE" comment="e3c:permanence=FINITE">neurri</EVENT> kontserbatzaileak eta <EVENT eid="e40" class="OCCURRENCE" comment="e3c:permanence=FINITE">jarraipen</EVENT> klinikoa <EVENT eid="e41" class="OCCURRENCE" comment="e3c:permanence=FINITE">aholkatu</EVENT> ditu, <EVENT eid="e42" class="OCCURRENCE" comment="e3c:permanence=FINITE">miringoplastia</EVENT> <EVENT eid="e43" class="OCCURRENCE" comment="e3c:permanence=FINITE">baztertuz</EVENT>.&#13;
<EVENT eid="e44" class="OCCURRENCE" comment="e3c:permanence=FINITE">Ebakuntza</EVENT> <EVENT eid="e45" class="OCCURRENCE" comment="e3c:permanence=FINITE">anestesia</EVENT> orokor balantzatuaren bidez egin da.&#13;
Pazienteak ahoa <EVENT eid="e46" class="OCCURRENCE" comment="e3c:permanence=FINITE">zabaltzeko</EVENT> duen <EVENT eid="e47" class="OCCURRENCE" comment="e3c:permanence=FINITE">gaitasun</EVENT> txikia dela-eta, <EVENT eid="e48" class="OCCURRENCE" comment="e3c:permanence=FINITE">intubazio</EVENT> orotrakeala egin da fibroskopioaren bidez.&#13;
<EVENT eid="e49" class="OCCURRENCE" comment="e3c:permanence=FINITE">Desintubazioa</EVENT> ebakuntza-gelan egin da <EVENT eid="e50" class="OCCURRENCE" comment="e3c:permanence=FINITE">konplikaziorik</EVENT> gabe.&#13;
<EVENT eid="e51" class="OCCURRENCE" comment="e3c:permanence=FINITE">EBOLUZIOA</EVENT> BIZKORKETARAKO GELAN.&#13;
<EVENT eid="e52" class="OCCURRENCE" comment="e3c:permanence=FINITE">Kontziente</EVENT> dago, arnas <EVENT eid="e53" class="OCCURRENCE" comment="e3c:permanence=FINITE">autonomia</EVENT> du eta hemodinamikoki <EVENT eid="e54" class="OCCURRENCE" comment="e3c:permanence=FINITE">egonkor</EVENT> dago.&#13;
<EVENT eid="e55" class="OCCURRENCE" comment="e3c:permanence=FINITE">ALTA</EVENT> EMATERAKOAN.&#13;
<EVENT eid="e56" class="OCCURRENCE" comment="e3c:permanence=FINITE">Tentsio</EVENT> arteriala, 100/50 mm Hg.&#13;
<EVENT eid="e57" class="OCCURRENCE" comment="e3c:permanence=FINITE">Tratamendu</EVENT> basoaktiborik gabe.&#13;
<EVENT eid="e58" class="OCCURRENCE" comment="e3c:permanence=FINITE">Bihotz-maiztasuna</EVENT>, 54 tau/min; arnas <EVENT eid="e59" class="OCCURRENCE" comment="e3c:permanence=FINITE">maiztasuna</EVENT>, 18 arnas/min; <EVENT eid="e60" class="OCCURRENCE" comment="e3c:permanence=FINITE">O2Sat</EVENT>,% 98.&#13;
<EVENT eid="e61" class="OCCURRENCE" comment="e3c:permanence=FINITE">Kontziente</EVENT> eta <EVENT eid="e62" class="OCCURRENCE" comment="e3c:permanence=FINITE">orientatua</EVENT> dago <EVENT eid="e63" class="OCCURRENCE" comment="e3c:permanence=FINITE">perfusio</EVENT> onarekin.&#13;
<EVENT eid="e64" class="OCCURRENCE" comment="e3c:permanence=FINITE">Aho-irekitze</EVENT> murriztua du.&#13;
BIHOTZAREN <EVENT eid="e65" class="OCCURRENCE" comment="e3c:permanence=FINITE">AUSKULTAZIOA</EVENT>.&#13;
<EVENT eid="e66" class="OCCURRENCE" comment="e3c:permanence=FINITE">Murmurio</EVENT> erritmikoak.&#13;
BIRIKEN <EVENT eid="e67" class="OCCURRENCE" comment="e3c:permanence=FINITE">AUSKULTAZIOA</EVENT>.&#13;
Arnas <EVENT eid="e68" class="OCCURRENCE" comment="e3c:permanence=FINITE">murmurioa</EVENT> <EVENT eid="e69" class="REPORTING" comment="e3c:permanence=FINITE">entzuten</EVENT> da.&#13;
Eskuin-birikaren behealdea <EVENT eid="e70" class="OCCURRENCE" comment="e3c:permanence=FINITE">hipofonetiko</EVENT> dago eta ahoko <EVENT eid="e71" class="OCCURRENCE" comment="e3c:permanence=FINITE">bibrazioak</EVENT> <EVENT eid="e72" class="OCCURRENCE" comment="e3c:permanence=FINITE">ezabatuta</EVENT> daude.&#13;
SABELALDEA.&#13;
<EVENT eid="e73" class="OCCURRENCE" comment="e3c:permanence=FINITE">Biguna</EVENT> eta <EVENT eid="e74" class="OCCURRENCE" comment="e3c:permanence=FINITE">zanpagarria</EVENT>; <EVENT eid="e75" class="REPORTING" comment="e3c:permanence=FINITE">haztatzean</EVENT> <EVENT eid="e76" class="OCCURRENCE" comment="e3c:permanence=FINITE">mina</EVENT> <EVENT eid="e77" class="REPORTING" comment="e3c:permanence=FINITE">sentitzen</EVENT> du hipogastrioan; ez dauka peritoneoko <EVENT eid="e78" class="OCCURRENCE" comment="e3c:permanence=FINITE">narritadurarik</EVENT>, <EVENT eid="e79" class="OCCURRENCE" comment="e3c:permanence=FINITE">sabel-soinu</EVENT> normalak.&#13;
GILTZURRUNAK.&#13;
<EVENT eid="e80" class="OCCURRENCE" comment="e3c:permanence=FINITE">Diuresi</EVENT> egokia, <EVENT eid="e81" class="OCCURRENCE" comment="e3c:permanence=FINITE">medikaziorik</EVENT> gabe.&#13;
<EVENT eid="e82" class="OCCURRENCE" comment="e3c:permanence=FINITE">PROBA</EVENT> OSAGARRIAK.&#13;
<EVENT eid="e83" class="OCCURRENCE" comment="e3c:permanence=FINITE">BIOKIMIKA</EVENT>.&#13;
<EVENT eid="e84" class="OCCURRENCE" comment="e3c:permanence=FINITE">Kreatinina</EVENT>, 1,41 mg/dl.&#13;
<EVENT eid="e85" class="OCCURRENCE" comment="e3c:permanence=FINITE">HEMOGRAMA</EVENT>.&#13;
<EVENT eid="e86" class="OCCURRENCE" comment="e3c:permanence=FINITE">Hemoglobina</EVENT>, 12,3 g/dl; <EVENT eid="e87" class="OCCURRENCE" comment="e3c:permanence=FINITE">plaketak</EVENT>, 280.000; <EVENT eid="e88" class="OCCURRENCE" comment="e3c:permanence=FINITE">leukozitoak</EVENT>, 8.300.&#13;
<EVENT eid="e89" class="OCCURRENCE" comment="e3c:permanence=FINITE">KOAGULAZIOA</EVENT>.&#13;
Nazioarteko <EVENT eid="e90" class="OCCURRENCE" comment="e3c:permanence=FINITE">ratio</EVENT> normalizatua (<EVENT eid="e91" class="OCCURRENCE" comment="e3c:permanence=FINITE">INR</EVENT>), 1,1.&#13;
<EVENT eid="e92" class="OCCURRENCE" comment="e3c:permanence=FINITE">DIAGNOSTIKOA</EVENT>.&#13;
TENPORALAREN ETA MATRAILEZURRAREN ARTEKO <EVENT eid="e93" class="OCCURRENCE" comment="e3c:permanence=FINITE">ARTROPLASTIA</EVENT>.&#13;
TENPORALAREN ETA MATRAILEZURRAREN ARTEKO <EVENT eid="e94" class="OCCURRENCE" comment="e3c:permanence=FINITE">ANKILOSIA</EVENT>.&#13;
BESTE <EVENT eid="e95" class="OCCURRENCE" comment="e3c:permanence=FINITE">AURREKARIAK</EVENT>.&#13;
<EVENT eid="e96" class="OCCURRENCE" comment="e3c:permanence=FINITE">TRATAMENDUA</EVENT> ETA <EVENT eid="e97" class="OCCURRENCE" comment="e3c:permanence=FINITE">GOMENDIOAK</EVENT>.&#13;
Anestesiako Zerbitzuaren aldetik ez du <EVENT eid="e98" class="OCCURRENCE" comment="e3c:permanence=FINITE">tratamendu</EVENT> edo <EVENT eid="e99" class="OCCURRENCE" comment="e3c:permanence=FINITE">jarraipen</EVENT> berezirik behar.&#13;
<EVENT eid="e100" class="OCCURRENCE" comment="e3c:permanence=FINITE">Tratamendua</EVENT>, Ahoko eta Aurpegi-masailetako Kirurgiako medikuaren <EVENT eid="e101" class="OCCURRENCE" comment="e3c:permanence=FINITE">irizpidearen</EVENT> arabera.&#13;
</TEXT>
