<?xml version="1.0" encoding="UTF-8"?>
<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2017-03-31T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2017-03-31</TIMEX3>
  <TEXT>44 urteko gizona, <EVENT eid="e1" class="OCCURRENCE" comment="e3c:permanence=FINITE">txertatu</EVENT> gabea. <EVENT eid="e2" class="OCCURRENCE" comment="e3c:permanence=FINITE">Lesio</EVENT> gorri inflamatua zuen izterraren aurreko aldean, zorne <EVENT eid="e3" class="OCCURRENCE" comment="e3c:permanence=FINITE">jarioarekin</EVENT>. <EVENT eid="e4" class="OCCURRENCE" comment="e3c:permanence=FINITE">Zelulitisa</EVENT> <EVENT eid="e5" class="OCCURRENCE" comment="e3c:permanence=FINITE">susmatu</EVENT> eta amoxizilina-klabulaniko orala eta mupirozina topikoarekin <EVENT eid="e6" class="OCCURRENCE" comment="e3c:permanence=FINITE">tratatu</EVENT> zen.&#13;
Kontsultara <EVENT eid="e7" class="OCCURRENCE" comment="e3c:permanence=FINITE">itzuli</EVENT> zen <EVENT eid="e8" class="OCCURRENCE" comment="e3c:permanence=FINITE">ondoezik</EVENT>. <EVENT eid="e9" class="OCCURRENCE" comment="e3c:permanence=FINITE">Adenopatia</EVENT> inginala <EVENT eid="e10" class="REPORTING" comment="e3c:permanence=FINITE">antzeman</EVENT> genuen. Animaliekin <EVENT eid="e11" class="OCCURRENCE" comment="e3c:permanence=FINITE">lan</EVENT> egiten zuela historian <EVENT eid="e12" class="OCCURRENCE" comment="e3c:permanence=FINITE">azpimarratu</EVENT> eta ospitalera <EVENT eid="e13" class="OCCURRENCE" comment="e3c:permanence=FINITE">igorri</EVENT> genuen. <EVENT eid="e14" class="OCCURRENCE" comment="e3c:permanence=FINITE">Zelulitisa</EVENT> <EVENT eid="e15" class="OCCURRENCE" comment="e3c:permanence=FINITE">diagnostikatu</EVENT> eta <EVENT eid="e16" class="OCCURRENCE" comment="e3c:permanence=FINITE">tratamendua</EVENT> mantendu zuten. <TIMEX3 tid="t1" type="DURATION" value="P1W" temporalFunction="false">Aste baten</TIMEX3> buruan <EVENT eid="e17" class="OCCURRENCE" comment="e3c:permanence=FINITE">itzuli</EVENT> zen <EVENT eid="e18" class="OCCURRENCE" comment="e3c:permanence=FINITE">hobekuntzarik</EVENT> gabe eta <EVENT eid="e19" class="OCCURRENCE" comment="e3c:permanence=FINITE">legena</EVENT> izan zitekeenez <EVENT eid="e20" class="OCCURRENCE" comment="e3c:permanence=FINITE">galdezka</EVENT>. Bi medikuk <EVENT eid="e21" class="OCCURRENCE" comment="e3c:permanence=FINITE">artatu</EVENT> eta <EVENT eid="e22" class="OCCURRENCE" comment="e3c:permanence=FINITE">tiña</EVENT> corporis bovina izan zitekeelakoan bifonazol <EVENT eid="e23" class="OCCURRENCE" comment="e3c:permanence=FINITE">kremarekin</EVENT> <EVENT eid="e24" class="ASPECTUAL" comment="e3c:permanence=FINITE">hasi</EVENT> eta <TIMEX3 tid="t2" type="DURATION" value="PT72H" temporalFunction="false">72h</TIMEX3> tan <EVENT eid="e25" class="OCCURRENCE" comment="e3c:permanence=FINITE">hitzordua</EVENT> egin genuen.&#13;
<EVENT eid="e26" class="OCCURRENCE" comment="e3c:permanence=FINITE">Hitzorduaren</EVENT> aurretik <EVENT eid="e27" class="OCCURRENCE" comment="e3c:permanence=FINITE">heldu</EVENT> zen <EVENT eid="e28" class="OCCURRENCE" comment="e3c:permanence=FINITE">sukarrarekin</EVENT>. <EVENT eid="e29" class="OCCURRENCE" comment="e3c:permanence=FINITE">Antrax</EVENT> zelakoan <EVENT eid="e30" class="OCCURRENCE" comment="e3c:permanence=FINITE">isolatuta</EVENT> <EVENT eid="e31" class="OCCURRENCE" comment="e3c:permanence=FINITE">ingresatu</EVENT> zuten <EVENT eid="e32" class="OCCURRENCE" comment="e3c:permanence=FINITE">E.Coli</EVENT> <EVENT eid="e33" class="OCCURRENCE" comment="e3c:permanence=FINITE">kultiboan</EVENT> <EVENT eid="e34" class="REPORTING" comment="e3c:permanence=FINITE">ikusita</EVENT>.&#13;
Antibiotikoen <EVENT eid="e35" class="OCCURRENCE" comment="e3c:permanence=FINITE">eraginez</EVENT>, <EVENT eid="e36" class="OCCURRENCE" comment="e3c:permanence=FINITE">enteritisa</EVENT> garatu zuen Clostridium Difficilengatik. Azkenik, dermatologoek <EVENT eid="e37" class="OCCURRENCE" comment="e3c:permanence=FINITE">artatu</EVENT> eta <EVENT eid="e38" class="OCCURRENCE" comment="e3c:permanence=FINITE">tiña</EVENT> corporis inflamatorioa zela <EVENT eid="e39" class="REPORTING" comment="e3c:permanence=FINITE">konfirmatu</EVENT> eta ahozko terbinafinarekin (250mg egunean) <EVENT eid="e40" class="OCCURRENCE" comment="e3c:permanence=FINITE">tratatzen</EVENT> <EVENT eid="e41" class="ASPECTUAL" comment="e3c:permanence=FINITE">hasi</EVENT> eta <EVENT eid="e42" class="OCCURRENCE" comment="e3c:permanence=FINITE">alta</EVENT> eman zioten.&#13;
&#13;
<TIMEX3 tid="t3" type="DURATION" value="PXD" temporalFunction="true">Hurrengo egunetan</TIMEX3> <EVENT eid="e43" class="OCCURRENCE" comment="e3c:permanence=FINITE">hobera</EVENT> egin zuen eta <TIMEX3 tid="t4" type="DURATION" value="X" temporalFunction="true">40 egunen</TIMEX3> buruan azaleko <EVENT eid="e44" class="OCCURRENCE" comment="e3c:permanence=FINITE">lesioa</EVENT> <EVENT eid="e45" class="OCCURRENCE" comment="e3c:permanence=FINITE">sendatu</EVENT> zen.</TEXT>
