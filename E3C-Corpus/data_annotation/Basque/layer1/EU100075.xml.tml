<?xml version="1.0" encoding="UTF-8"?>
<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2008-10-03T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2008-10-03</TIMEX3>
  <TEXT>14 urteko ume baten kasua <EVENT eid="e1" class="OCCURRENCE" comment="e3c:permanence=FINITE">aurkezten</EVENT> dugu. 
<TIMEX3 tid="t1" type="DURATION" value="P3W" temporalFunction="false">3 astetan</TIMEX3> zehar <EVENT eid="e2" class="OCCURRENCE" comment="e3c:permanence=FINITE">gorakoak</EVENT>, <EVENT eid="e3" class="OCCURRENCE" comment="e3c:permanence=FINITE">astenia</EVENT> eta 7 kg-ko pisu <EVENT eid="e4" class="OCCURRENCE" comment="e3c:permanence=FINITE">galera</EVENT> izan duena. 
<TIMEX3 tid="t2" type="DURATION" value="PXD" temporalFunction="true">Lehendabiziko egunetan</TIMEX3> <EVENT eid="e5" class="OCCURRENCE" comment="e3c:permanence=FINITE">sukarra</EVENT> ere izan zuen. 
<EVENT eid="e6" class="OCCURRENCE" comment="e3c:permanence=FINITE">Azterketa</EVENT> fisikoan <EVENT eid="e7" class="OCCURRENCE" comment="e3c:permanence=FINITE">egoera</EVENT> orokor egokia eta <EVENT eid="e8" class="OCCURRENCE" comment="e3c:permanence=FINITE">sukarrik</EVENT> gabe zegoen; hala ere, garondo <EVENT eid="e9" class="OCCURRENCE" comment="e3c:permanence=FINITE">zurruntasuna</EVENT> eta ezker begiko <EVENT eid="e10" class="OCCURRENCE" comment="e3c:permanence=FINITE">estrabismo</EVENT> konbergentea <EVENT eid="e11" class="REPORTING" comment="e3c:permanence=FINITE">nabaritzen</EVENT> zitzaion, bestelako <EVENT eid="e12" class="OCCURRENCE" comment="e3c:permanence=FINITE">klinika</EVENT> neurologikorik gabe. 
<EVENT eid="e13" class="OCCURRENCE" comment="e3c:permanence=FINITE">Proba</EVENT> osagarrien artean garuneko <EVENT eid="e14" class="OCCURRENCE" comment="e3c:permanence=FINITE">OTAk</EVENT> (ordenagailu bidezko <EVENT eid="e15" class="OCCURRENCE" comment="e3c:permanence=FINITE">tomografia</EVENT> axialak) ezkerreko lobulo frontalean eraztun kontraste kaptaziozko 5x5 zm-ko <EVENT eid="e16" class="OCCURRENCE" comment="e3c:permanence=FINITE">lesio</EVENT> hipodentsoa <EVENT eid="e17" class="REPORTING" comment="e3c:permanence=FINITE">agerian</EVENT> utzi zuen, <EVENT eid="e18" class="OCCURRENCE" comment="e3c:permanence=FINITE">edema</EVENT> perilesionala eta erdiko marrako <EVENT eid="e19" class="OCCURRENCE" comment="e3c:permanence=FINITE">desplazamendua</EVENT> eraginez. 
Sinu esfenoidalarekin <EVENT eid="e20" class="OCCURRENCE" comment="e3c:permanence=FINITE">komunikazio</EVENT> infundibularra ere agertuz. 
Sudur mukosan egindako <EVENT eid="e21" class="OCCURRENCE" comment="e3c:permanence=FINITE">azterketa</EVENT> mikrobiologikoetan S. Aureus metizilin erresistentea <EVENT eid="e22" class="OCCURRENCE" comment="e3c:permanence=FINITE">isolatu</EVENT> zen. 
Metronidazol, Bankomizina eta linezolid <EVENT eid="e23" class="OCCURRENCE" comment="e3c:permanence=FINITE">tratamendu</EVENT> antibiotikoa <EVENT eid="e24" class="ASPECTUAL" comment="e3c:permanence=FINITE">hasi</EVENT> zen. 
Hala ere, S. Aureus metizilin erresistentea <EVENT eid="e25" class="OCCURRENCE" comment="e3c:permanence=FINITE">isolatu</EVENT> eta gero, <EVENT eid="e26" class="OCCURRENCE" comment="e3c:permanence=FINITE">metronidazola</EVENT> <EVENT eid="e27" class="OCCURRENCE" comment="e3c:permanence=FINITE">kendu</EVENT> eta gainontzeko <EVENT eid="e28" class="OCCURRENCE" comment="e3c:permanence=FINITE">terapia</EVENT> antibiotikoa <TIMEX3 tid="t3" type="DURATION" value="P4W" temporalFunction="false">4 astetan</TIMEX3> zehar <EVENT eid="e29" class="ASPECTUAL" comment="e3c:permanence=FINITE">jarraitu</EVENT> zen. 
Baita ere <EVENT eid="e30" class="OCCURRENCE" comment="e3c:permanence=FINITE">kraniektomia</EVENT> frontala burutu, <EVENT eid="e31" class="OCCURRENCE" comment="e3c:permanence=FINITE">abzesua</EVENT> <EVENT eid="e32" class="OCCURRENCE" comment="e3c:permanence=FINITE">drainatu</EVENT> eta <EVENT eid="e33" class="OCCURRENCE" comment="e3c:permanence=FINITE">partxe</EVENT> periostikoa jarri ziren. 
Bai garuneko laginan bai sudurrekoan egindako <EVENT eid="e34" class="OCCURRENCE" comment="e3c:permanence=FINITE">kultiboek</EVENT> <EVENT eid="e35" class="REPORTING" comment="e3c:permanence=FINITE">baieztatu</EVENT> zuten S. Aureus metizilin erresistentearen <EVENT eid="e36" class="OCCURRENCE" comment="e3c:permanence=FINITE">andui</EVENT> berbera zela. 
<EVENT eid="e37" class="OCCURRENCE" comment="e3c:permanence=FINITE">Ospitalizazioan</EVENT> zehar, pazientearen <EVENT eid="e38" class="OCCURRENCE" comment="e3c:permanence=FINITE">eboluzio</EVENT> klinikoa <EVENT eid="e39" class="OCCURRENCE" comment="e3c:permanence=FINITE">egokia</EVENT> izan zenez, <EVENT eid="e40" class="OCCURRENCE" comment="e3c:permanence=FINITE">alta</EVENT> eman zioten. 
Familiarren artean, eramaileen <EVENT eid="e41" class="OCCURRENCE" comment="e3c:permanence=FINITE">azterketa</EVENT> diagnostikoak burutu eta <EVENT eid="e42" class="OCCURRENCE" comment="e3c:permanence=FINITE">erradikaziorako</EVENT> <EVENT eid="e43" class="OCCURRENCE" comment="e3c:permanence=FINITE">pauta</EVENT> antibiotikoa ezarri zieten. 
Umeari <TIMEX3 tid="t4" type="DURATION" value="P1M" temporalFunction="false">hilabete bat</TIMEX3> geroago egindako <EVENT eid="e44" class="OCCURRENCE" comment="e3c:permanence=FINITE">azterketak</EVENT> sintomarik gabeko <EVENT eid="e45" class="OCCURRENCE" comment="e3c:permanence=FINITE">egoera</EVENT> <EVENT eid="e46" class="REPORTING" comment="e3c:permanence=FINITE">baieztatu</EVENT> zuen eta kontrolezko garuneko <EVENT eid="e47" class="OCCURRENCE" comment="e3c:permanence=FINITE">OTAn</EVENT> <EVENT eid="e48" class="OCCURRENCE" comment="e3c:permanence=FINITE">hondar-lesio</EVENT> minimoa <EVENT eid="e49" class="REPORTING" comment="e3c:permanence=FINITE">antzeman</EVENT> zen.
</TEXT>
