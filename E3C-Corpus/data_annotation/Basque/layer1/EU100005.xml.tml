<?xml version="1.0" encoding="UTF-8"?>
<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2014-12-31T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2014-12-31</TIMEX3>
  <TEXT>DERMATOLOGIA&#13;
<EVENT eid="e1" class="OCCURRENCE" comment="e3c:permanence=FINITE">OSPITALERATZEKO</EVENT>/<EVENT eid="e2" class="OCCURRENCE" comment="e3c:permanence=FINITE">KONTSULTARAKO</EVENT> ARRAZOIA&#13;
Larruazaleko <EVENT eid="e3" class="OCCURRENCE" comment="e3c:permanence=FINITE">lesioak</EVENT> dituen 61 urteko gizonezkoa.&#13;
AURREKARIAK&#13;
Ez du farmakoekiko <EVENT eid="e4" class="OCCURRENCE" comment="e3c:permanence=FINITE">alergiarik</EVENT>.&#13;
<EVENT eid="e5" class="OCCURRENCE" comment="e3c:permanence=FINITE">HTA</EVENT>.&#13;
<EVENT eid="e6" class="STATE" comment="e3c:permanence=PERMANENT">Diabetesa</EVENT>.&#13;
<EVENT eid="e7" class="OCCURRENCE" comment="e3c:permanence=FINITE">Psoriasia</EVENT>&#13;
Ohiko medikamentuak: <EVENT eid="e8" class="OCCURRENCE" comment="e3c:permanence=FINITE">enalaprila</EVENT>, <EVENT eid="e9" class="OCCURRENCE" comment="e3c:permanence=FINITE">intsulina</EVENT>.&#13;
<TIMEX3 tid="t1" type="DATE" value="PRESENT_REF" temporalFunction="true">EGUNGO</TIMEX3> HISTORIA&#13;
<TIMEX3 tid="t2" type="DURATION" value="P5D" temporalFunction="false">Duela 5 egun</TIMEX3> <EVENT eid="e10" class="OCCURRENCE" comment="e3c:permanence=FINITE">sukarra</EVENT> eta zangoetako <EVENT eid="e11" class="OCCURRENCE" comment="e3c:permanence=FINITE">gorritasun</EVENT> mingarria izaten <EVENT eid="e12" class="ASPECTUAL" comment="e3c:permanence=FINITE">hasi</EVENT> zen.&#13;
Zangoetako zainetako <EVENT eid="e13" class="OCCURRENCE" comment="e3c:permanence=FINITE">gutxiegitasun</EVENT> kronikoa zuen <TIMEX3 tid="t3" type="DATE" value="PAST_REF" temporalFunction="true">lehenagotik</TIMEX3>.&#13;
<EVENT eid="e14" class="OCCURRENCE" comment="e3c:permanence=FINITE">AZTERKETA</EVENT> FISIKOA&#13;
<EVENT eid="e15" class="OCCURRENCE" comment="e3c:permanence=FINITE">Tenperatura</EVENT>: 38,5 °C.&#13;
Gaizki mugatutako <EVENT eid="e16" class="OCCURRENCE" comment="e3c:permanence=FINITE">ertzak</EVENT> dituen <EVENT eid="e17" class="OCCURRENCE" comment="e3c:permanence=FINITE">eritema-plaka</EVENT> eskuineko zangoan eta inguruko ehunetako <EVENT eid="e18" class="OCCURRENCE" comment="e3c:permanence=FINITE">edema</EVENT> ditu.&#13;
Ukondo eta belaunetan <EVENT eid="e19" class="OCCURRENCE" comment="e3c:permanence=FINITE">plaka</EVENT> gorrixkak ditu, ezkata zuriz <EVENT eid="e20" class="OCCURRENCE" comment="e3c:permanence=FINITE">estaliak</EVENT>.&#13;
Azazkaletan <EVENT eid="e21" class="OCCURRENCE" comment="e3c:permanence=FINITE">onikolisia</EVENT> eta <EVENT eid="e22" class="OCCURRENCE" comment="e3c:permanence=FINITE">edema</EVENT> fobearekin.&#13;
<EVENT eid="e23" class="OCCURRENCE" comment="e3c:permanence=FINITE">PROBA</EVENT> OSAGARRIEN LABURPENA.&#13;
AZALEKO <EVENT eid="e24" class="OCCURRENCE" comment="e3c:permanence=FINITE">KULTIBOA</EVENT>. positiboa, Staphylococcus aureusa <EVENT eid="e25" class="OCCURRENCE" comment="e3c:permanence=FINITE">hazten</EVENT> da.&#13;
<EVENT eid="e26" class="OCCURRENCE" comment="e3c:permanence=FINITE">ANALITIKA</EVENT>. 18.000 <EVENT eid="e27" class="OCCURRENCE" comment="e3c:permanence=FINITE">leukozito</EVENT>; <EVENT eid="e28" class="OCCURRENCE" comment="e3c:permanence=FINITE">neutrofiloak</EVENT>,% 85.&#13;
<EVENT eid="e29" class="OCCURRENCE" comment="e3c:permanence=FINITE">DIAGNOSTIKO</EVENT> NAGUSIA&#13;
<EVENT eid="e30" class="OCCURRENCE" comment="e3c:permanence=FINITE">Zelulitisa</EVENT>, <EVENT eid="e31" class="OCCURRENCE" comment="e3c:permanence=FINITE">psoriasia</EVENT>.&#13;
<EVENT eid="e32" class="OCCURRENCE" comment="e3c:permanence=FINITE">TRATAMENDUA</EVENT>.&#13;
<EVENT eid="e33" class="OCCURRENCE" comment="e3c:permanence=FINITE">Amoxizilina-klabulanikoa</EVENT>, 875/125 mg/8 orduz behin, ahotik, <TIMEX3 tid="t4" type="DURATION" value="P7M" temporalFunction="false">7 egunetan</TIMEX3>.&#13;
<EVENT eid="e34" class="OCCURRENCE" comment="e3c:permanence=FINITE">Parazetamola</EVENT>, 1 g/8 orduz behin, ahotik.&#13;
Psoriasiko <EVENT eid="e35" class="OCCURRENCE" comment="e3c:permanence=FINITE">lesioetan</EVENT>, <EVENT eid="e36" class="OCCURRENCE" comment="e3c:permanence=FINITE">Daivonex</EVENT> ® krema, <TIMEX3 tid="t5" type="SET" value="PT12H" temporalFunction="true">12 orduz behin</TIMEX3>.&#13;
BESTE <EVENT eid="e37" class="OCCURRENCE" comment="e3c:permanence=FINITE">GOMENDIO</EVENT> BATZUK&#13;
Ez egin <EVENT eid="e38" class="OCCURRENCE" comment="e3c:permanence=FINITE">hazka</EVENT> <EVENT eid="e39" class="OCCURRENCE" comment="e3c:permanence=FINITE">lesioetan</EVENT>, <EVENT eid="e40" class="OCCURRENCE" comment="e3c:permanence=FINITE">infekzioa</EVENT> <EVENT eid="e41" class="OCCURRENCE" comment="e3c:permanence=FINITE">zabaltzeko</EVENT> arriskua dagoelako.</TEXT>
