<?xml version="1.0" encoding="UTF-8"?>
<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2008-10-03T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2008-10-03</TIMEX3>
  <TEXT>60 urtetako gizona, <EVENT eid="e1" class="OCCURRENCE">aurrekaririk</EVENT> eta <EVENT eid="e2" class="OCCURRENCE">ohitura</EVENT> toxikorik gabekoa eta berak <EVENT eid="e3" class="REPORTING">esanda</EVENT> ez <EVENT eid="e4" class="OCCURRENCE">homosexuala</EVENT> edo <EVENT eid="e5" class="OCCURRENCE">bisexuala</EVENT>. <EVENT eid="e6" class="OCCURRENCE">Ospitaleratzeko</EVENT> arrazoia: <TIMEX3 tid="t1" type="DURATION" value="P1Y" temporalFunction="false">Urte bateko</TIMEX3> <EVENT eid="e7" class="OCCURRENCE">luzapena</EVENT> duen <EVENT eid="e8" class="OCCURRENCE">odol</EVENT>, <EVENT eid="e9" class="OCCURRENCE">muki</EVENT> eta <EVENT eid="e10" class="OCCURRENCE">zornerik</EVENT> gabeko <EVENT eid="e11" class="OCCURRENCE">diarrea</EVENT>, <EVENT eid="e12" class="OCCURRENCE">astenia</EVENT> eta pisu <EVENT eid="e13" class="OCCURRENCE">galtzea</EVENT> (25 kilo <TIMEX3 tid="t2" type="DURATION" value="P2Y" temporalFunction="false">bi urtetan</TIMEX3>). <EVENT eid="e14" class="OCCURRENCE">Explorazio</EVENT> orokorra: <EVENT eid="e15" class="OCCURRENCE">Febrikula</EVENT>, <EVENT eid="e16" class="OCCURRENCE">tentsio</EVENT> baxua, <EVENT eid="e17" class="OCCURRENCE">kakexia</EVENT>, beste <EVENT eid="e18" class="OCCURRENCE">guztia</EVENT> normala. <EVENT eid="e19" class="OCCURRENCE">Adenopatiarik</EVENT> ez. <EVENT eid="e20" class="OCCURRENCE">Analisia</EVENT>: <EVENT eid="e21" class="OCCURRENCE">Biokimika</EVENT> eta gibeleko <EVENT eid="e22" class="OCCURRENCE">entzimak</EVENT> normalak,4800 <EVENT eid="e23" class="OCCURRENCE">leukozito</EVENT> (20 linfozito <EVENT eid="e24" class="OCCURRENCE">CD4</EVENT>, 520 linfozito <EVENT eid="e25" class="OCCURRENCE">CD8</EVENT>). ZMBaren <EVENT eid="e26" class="OCCURRENCE">antigenemia</EVENT> positiboa. Elisa eta Western-Blot serologia <EVENT eid="e27" class="OCCURRENCE">probak</EVENT> HIVrentzako positiboak. <EVENT eid="e28" class="OCCURRENCE">Koprokultiboa</EVENT>: Negatiboa. <EVENT eid="e29" class="OCCURRENCE">Esofagogastroskopia</EVENT>: <EVENT eid="e30" class="OCCURRENCE">Ultzera</EVENT> urdailean. <EVENT eid="e31" class="OCCURRENCE">Kolonoskopia</EVENT>: errektotik erdizkako heste lodiraino <EVENT eid="e32" class="OCCURRENCE">ultzerak</EVENT>. Bi endoskopien <EVENT eid="e33" class="OCCURRENCE">biopsietan</EVENT>: <EVENT eid="e34" class="OCCURRENCE">Zitomegalobirusa</EVENT> <EVENT eid="e35" class="REPORTING">ageri</EVENT> zen. Sabeleko TAC <EVENT eid="e36" class="OCCURRENCE">proban</EVENT>: 2 <EVENT eid="e37" class="OCCURRENCE">adenopatia</EVENT> txiki eta heste lodiko pareta orokorki <EVENT eid="e38" class="OCCURRENCE">loditua</EVENT>. Begien <EVENT eid="e39" class="OCCURRENCE">azterketa</EVENT> oftalmoskopikoa: normala. <EVENT eid="e40" class="OCCURRENCE">Diagnosia</EVENT>: <EVENT eid="e41" class="OCCURRENCE">Zitomegalobiriasia</EVENT> urdaila eta heste lodiaren <EVENT eid="e42" class="OCCURRENCE">kaltearekin</EVENT>, <EVENT eid="e43" class="OCCURRENCE">HIESA</EVENT>. <EVENT eid="e44" class="OCCURRENCE">Tratamendua</EVENT>: <EVENT eid="e45" class="OCCURRENCE">Ganziklobirra</EVENT> zainetatik. <EVENT eid="e46" class="OCCURRENCE">Bilakaera</EVENT>: <TIMEX3 tid="t3" type="DURATION" value="P2M" temporalFunction="false">Bi hilabetetara</TIMEX3> <EVENT eid="e47" class="OCCURRENCE">antiretrobiralekin</EVENT> <EVENT eid="e48" class="ASPECTUAL">hasi</EVENT> zen. <TIMEX3 tid="t4" type="DURATION" value="P6M" temporalFunction="false">Sei hilabetetara</TIMEX3> ZMBak eragindako <EVENT eid="e49" class="OCCURRENCE">erretinitisa</EVENT>. <TIMEX3 tid="t5" type="DURATION" value="P3Y" temporalFunction="false">Hiru urtera</TIMEX3>, gibeleko <EVENT eid="e50" class="OCCURRENCE">ezintasunarengatik</EVENT> <EVENT eid="e51" class="OCCURRENCE">hil</EVENT> zen.</TEXT>
