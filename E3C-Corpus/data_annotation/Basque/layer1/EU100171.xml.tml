<TimeML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="TimeML_1.2.1.xsd">
  <DOCID>begona</DOCID>
  <TIMEX3 tid="t0" type="DATE" value="2017-10-06T00:00:00" functionInDocument="CREATION_TIME" temporalFunction="false">2017-10-06</TIMEX3>
  <TEXT><EVENT eid="e1" class="OCCURRENCE" comment="e3c:permanence=FINITE">AURREKARI</EVENT> PERTSONALAK&#13;
-Gizonezkoa, 30 urte. Ez du <EVENT eid="e2" class="OCCURRENCE" comment="e3c:permanence=FINITE">alergiarirk</EVENT>.&#13;
-<EVENT eid="e3" class="OCCURRENCE" comment="e3c:permanence=FINITE">Dermatitis</EVENT> atopikoa.&#13;
-Ez du <EVENT eid="e4" class="OCCURRENCE" comment="e3c:permanence=FINITE">ebakuntzarik</EVENT> izan.&#13;
-<EVENT eid="e5" class="OCCURRENCE" comment="e3c:permanence=FINITE">Tratamendua</EVENT>: noizbehinka, <EVENT eid="e6" class="OCCURRENCE" comment="e3c:permanence=FINITE">diprogenta</EVENT> topikoa&#13;
&#13;
<TIMEX3 tid="t1" type="DATE" value="PRESENT_REF" temporalFunction="true">EGUNGO</TIMEX3> <EVENT eid="e7" class="OCCURRENCE" comment="e3c:permanence=FINITE">GAIXOTASUNA</EVENT>&#13;
<TIMEX3 tid="t2" type="DURATION" value="P3D" temporalFunction="false">Azken 3 egunetan</TIMEX3> <EVENT eid="e8" class="OCCURRENCE" comment="e3c:permanence=FINITE">gaizki</EVENT> <EVENT eid="e9" class="REPORTING" comment="e3c:permanence=FINITE">sentitzen</EVENT> da, <EVENT eid="e10" class="OCCURRENCE" comment="e3c:permanence=FINITE">sukarra</EVENT> (38,2ºC arte) eta <EVENT eid="e11" class="OCCURRENCE" comment="e3c:permanence=FINITE">izerditzarekin</EVENT> dago eta <EVENT eid="e12" class="OCCURRENCE" comment="e3c:permanence=FINITE">odinofagia</EVENT> eta <EVENT eid="e13" class="OCCURRENCE" comment="e3c:permanence=FINITE">eztul</EVENT> sikua (toraxeko <EVENT eid="e14" class="OCCURRENCE" comment="e3c:permanence=FINITE">min</EVENT> gabe eta <EVENT eid="e15" class="OCCURRENCE" comment="e3c:permanence=FINITE">disnearik</EVENT> gabe) <EVENT eid="e16" class="REPORTING" comment="e3c:permanence=FINITE">nabaritu</EVENT> ditu.&#13;
<TIMEX3 tid="t3" type="DURATION" value="P4D" temporalFunction="false">Lau egun</TIMEX3> lehenago Taliandiatik <EVENT eid="e17" class="OCCURRENCE" comment="e3c:permanence=FINITE">bueltatu</EVENT> zen, han <TIMEX3 tid="t4" type="DURATION" value="P20D" temporalFunction="false">20 egunetan</TIMEX3> <EVENT eid="e18" class="OCCURRENCE" comment="e3c:permanence=FINITE">egon</EVENT> eta gero (hirietan eta hondartzan <EVENT eid="e19" class="OCCURRENCE" comment="e3c:permanence=FINITE">ibilitakoa</EVENT>, ibai baten <EVENT eid="e20" class="OCCURRENCE" comment="e3c:permanence=FINITE">bainua</EVENT> hartuta eta <EVENT eid="e21" class="OCCURRENCE" comment="e3c:permanence=FINITE">urpekaritza</EVENT> eginda). &#13;
Ez du artropodoen <EVENT eid="e22" class="OCCURRENCE" comment="e3c:permanence=FINITE">ziztadarik</EVENT> <EVENT eid="e23" class="REPORTING" comment="e3c:permanence=FINITE">gogoratzen</EVENT>. &#13;
<EVENT eid="e24" class="OCCURRENCE" comment="e3c:permanence=FINITE">Bidaia</EVENT> baino lehenago <EVENT eid="e25" class="OCCURRENCE" comment="e3c:permanence=FINITE">Vivotif-a</EVENT> (Salmonella <EVENT eid="e26" class="OCCURRENCE" comment="e3c:permanence=FINITE">typhi-txertoa</EVENT>) hartu zuen ahotik <EVENT eid="e27" class="OCCURRENCE" comment="e3c:permanence=FINITE">profilaxi</EVENT> moduan.&#13;
&#13;
<EVENT eid="e28" class="OCCURRENCE" comment="e3c:permanence=FINITE">AZTERKETA</EVENT> FISIKOA LARRIALDIAN:&#13;
<EVENT eid="e29" class="OCCURRENCE" comment="e3c:permanence=FINITE">TA</EVENT> 126/78, <EVENT eid="e30" class="OCCURRENCE" comment="e3c:permanence=FINITE">BM</EVENT> 105, <EVENT eid="e31" class="OCCURRENCE" comment="e3c:permanence=FINITE">AM</EVENT> 20, <EVENT eid="e32" class="OCCURRENCE" comment="e3c:permanence=FINITE">Tª</EVENT> 38,5ºC, 02 <EVENT eid="e33" class="OCCURRENCE" comment="e3c:permanence=FINITE">saturazioa</EVENT> (basala) 100%&#13;
<EVENT eid="e34" class="OCCURRENCE" comment="e3c:permanence=FINITE">Egoera</EVENT> orokorra ona. &#13;
<EVENT eid="e35" class="OCCURRENCE" comment="e3c:permanence=FINITE">Kontziente</EVENT>, ondo <EVENT eid="e36" class="OCCURRENCE" comment="e3c:permanence=FINITE">orientatua</EVENT>, <EVENT eid="e37" class="OCCURRENCE" comment="e3c:permanence=FINITE">eupneikoa</EVENT>. &#13;
Azal eta mukosen <EVENT eid="e38" class="OCCURRENCE" comment="e3c:permanence=FINITE">kolorazio</EVENT> normala. &#13;
<EVENT eid="e39" class="OCCURRENCE" comment="e3c:permanence=FINITE">Izerdita</EVENT> dago.&#13;
Buru eta lepoa: <EVENT eid="e40" class="OCCURRENCE" comment="e3c:permanence=FINITE">adenopatiarik</EVENT> ez, <EVENT eid="e41" class="REPORTING" comment="e3c:permanence=FINITE">zeinu</EVENT> meningeorik ez.&#13;
Toraxa: Bihotz <EVENT eid="e42" class="OCCURRENCE" comment="e3c:permanence=FINITE">A</EVENT>.: <EVENT eid="e43" class="OCCURRENCE" comment="e3c:permanence=FINITE">erritmikoa</EVENT>, <EVENT eid="e44" class="OCCURRENCE" comment="e3c:permanence=FINITE">murmuriorik</EVENT> ez. &#13;
Birika <EVENT eid="e45" class="OCCURRENCE" comment="e3c:permanence=FINITE">A</EVENT>.: <EVENT eid="e46" class="OCCURRENCE" comment="e3c:permanence=FINITE">besikula-murmurio</EVENT> mantendua. &#13;
Sabela: <EVENT eid="e47" class="OCCURRENCE" comment="e3c:permanence=FINITE">biguna</EVENT>, ez da <EVENT eid="e48" class="OCCURRENCE" comment="e3c:permanence=FINITE">mingarria</EVENT> <EVENT eid="e49" class="OCCURRENCE" comment="e3c:permanence=FINITE">haztapenean</EVENT>. &#13;
Ez du <EVENT eid="e50" class="OCCURRENCE" comment="e3c:permanence=FINITE">peritoneo-narritadurarik</EVENT>. &#13;
<EVENT eid="e51" class="OCCURRENCE" comment="e3c:permanence=FINITE">Heste-hots</EVENT> normalak.&#13;
Gorputz-adarrak: <EVENT eid="e52" class="OCCURRENCE" comment="e3c:permanence=FINITE">edemarik</EVENT> ez, <EVENT eid="e53" class="OCCURRENCE" comment="e3c:permanence=FINITE">tronbosi</EVENT> sakonaren <EVENT eid="e54" class="REPORTING" comment="e3c:permanence=FINITE">zeinurik</EVENT> ez.&#13;
Azalean ez da <EVENT eid="e55" class="OCCURRENCE" comment="e3c:permanence=FINITE">lesiorik</EVENT> <EVENT eid="e56" class="REPORTING" comment="e3c:permanence=FINITE">ikusten</EVENT>.&#13;
&#13;
<EVENT eid="e57" class="OCCURRENCE" comment="e3c:permanence=FINITE">PROBA</EVENT> OSOGARRIAK&#13;
-<EVENT eid="e58" class="OCCURRENCE" comment="e3c:permanence=FINITE">Analitika</EVENT> Larrialdian: <EVENT eid="e59" class="OCCURRENCE" comment="e3c:permanence=FINITE">Biokimika</EVENT>: <EVENT eid="e60" class="OCCURRENCE" comment="e3c:permanence=FINITE">glukosa</EVENT>, <EVENT eid="e61" class="OCCURRENCE" comment="e3c:permanence=FINITE">U</EVENT>/Kr, <EVENT eid="e62" class="OCCURRENCE" comment="e3c:permanence=FINITE">albumina</EVENT>, <EVENT eid="e63" class="OCCURRENCE" comment="e3c:permanence=FINITE">BRT</EVENT>, <EVENT eid="e64" class="OCCURRENCE" comment="e3c:permanence=FINITE">GPT</EVENT>, <EVENT eid="e65" class="OCCURRENCE" comment="e3c:permanence=FINITE">LDH</EVENT>, <EVENT eid="e66" class="OCCURRENCE" comment="e3c:permanence=FINITE">Na</EVENT> eta <EVENT eid="e67" class="OCCURRENCE" comment="e3c:permanence=FINITE">K</EVENT> normalak. &#13;
<EVENT eid="e68" class="OCCURRENCE" comment="e3c:permanence=FINITE">PCE</EVENT> (<EVENT eid="e69" class="OCCURRENCE" comment="e3c:permanence=FINITE">Proteina</EVENT> C erreaktiboa) 33,07 mg/dl (330 mg/L), <EVENT eid="e70" class="OCCURRENCE" comment="e3c:permanence=FINITE">prokaltzitonina</EVENT> 0,65 ng/ml. &#13;
<EVENT eid="e71" class="OCCURRENCE" comment="e3c:permanence=FINITE">Hematimetria</EVENT>: <EVENT eid="e72" class="OCCURRENCE" comment="e3c:permanence=FINITE">Hb</EVENT> 13,7, <EVENT eid="e73" class="OCCURRENCE" comment="e3c:permanence=FINITE">leukozitoak</EVENT> eta <EVENT eid="e74" class="OCCURRENCE" comment="e3c:permanence=FINITE">formula</EVENT> eta <EVENT eid="e75" class="OCCURRENCE" comment="e3c:permanence=FINITE">plaketak</EVENT> normalak.&#13;
-Torax <EVENT eid="e76" class="OCCURRENCE" comment="e3c:permanence=FINITE">erradiografia</EVENT>: sinu kostofrenikoak libreak eta <EVENT eid="e77" class="OCCURRENCE" comment="e3c:permanence=FINITE">kondentsazio-irudirik</EVENT> ez.&#13;
-<EVENT eid="e78" class="OCCURRENCE" comment="e3c:permanence=FINITE">Hemokultiboak</EVENT> eta beste <EVENT eid="e79" class="OCCURRENCE" comment="e3c:permanence=FINITE">Mikrobiologia-probak</EVENT> batzuk ateratzen dira.&#13;
&#13;
<EVENT eid="e80" class="OCCURRENCE" comment="e3c:permanence=FINITE">EBOLUZIOA</EVENT>&#13;
<EVENT eid="e81" class="OCCURRENCE" comment="e3c:permanence=FINITE">Hemokultiboak</EVENT> atera eta gero, bena-barnetik <EVENT eid="e82" class="OCCURRENCE" comment="e3c:permanence=FINITE">Zeftriaxona</EVENT> ematen zaio. &#13;
Gaixotasun Infekziosoetako solairura <EVENT eid="e83" class="OCCURRENCE" comment="e3c:permanence=FINITE">eramaten</EVENT> da.&#13;
<EVENT eid="e84" class="OCCURRENCE" comment="e3c:permanence=FINITE">Ingresatu</EVENT> eta <TIMEX3 tid="t5" type="DURATION" value="PTXH" temporalFunction="true">ordu gutxitara</TIMEX3> <EVENT eid="e85" class="OCCURRENCE" comment="e3c:permanence=FINITE">hipotentsiorako</EVENT> joera azaltzen du (<EVENT eid="e86" class="OCCURRENCE" comment="e3c:permanence=FINITE">TAS</EVENT> 70-80 mmHg), <EVENT eid="e87" class="OCCURRENCE" comment="e3c:permanence=FINITE">oligoanuriarekin</EVENT>. &#13;
<EVENT eid="e88" class="OCCURRENCE" comment="e3c:permanence=FINITE">Analitika</EVENT> berri bat ateratzen zaio: <EVENT eid="e89" class="OCCURRENCE" comment="e3c:permanence=FINITE">Biokimikan</EVENT>, <EVENT eid="e90" class="OCCURRENCE" comment="e3c:permanence=FINITE">U</EVENT>/Kr 51/3,01 mg/dl, glomeruluen <EVENT eid="e91" class="OCCURRENCE" comment="e3c:permanence=FINITE">filtrazioa</EVENT> 27ml/min, <EVENT eid="e92" class="OCCURRENCE" comment="e3c:permanence=FINITE">proteinak</EVENT> 5,7, <EVENT eid="e93" class="OCCURRENCE" comment="e3c:permanence=FINITE">BRT</EVENT> 1,8mg/dl, <EVENT eid="e94" class="OCCURRENCE" comment="e3c:permanence=FINITE">BR</EVENT> zuzena 1,75mg/dl, <EVENT eid="e95" class="OCCURRENCE" comment="e3c:permanence=FINITE">GOT</EVENT> 44, <EVENT eid="e96" class="OCCURRENCE" comment="e3c:permanence=FINITE">GPT</EVENT> 28,<EVENT eid="e97" class="OCCURRENCE" comment="e3c:permanence=FINITE">GGT</EVENT> 90, <EVENT eid="e98" class="OCCURRENCE" comment="e3c:permanence=FINITE">PCE</EVENT> 33,69 mg/dl (336 mg/L), <EVENT eid="e99" class="OCCURRENCE" comment="e3c:permanence=FINITE">prokaltzitonina</EVENT> 67,2. &#13;
<EVENT eid="e100" class="OCCURRENCE" comment="e3c:permanence=FINITE">Hematimetrian</EVENT>, <EVENT eid="e101" class="OCCURRENCE" comment="e3c:permanence=FINITE">Hb</EVENT> 12,6, <EVENT eid="e102" class="OCCURRENCE" comment="e3c:permanence=FINITE">plaketak</EVENT> 220.000, <EVENT eid="e103" class="OCCURRENCE" comment="e3c:permanence=FINITE">leukozitoak</EVENT> 9200 (<EVENT eid="e104" class="OCCURRENCE" comment="e3c:permanence=FINITE">PMN</EVENT> %92,7). &#13;
<EVENT eid="e105" class="OCCURRENCE" comment="e3c:permanence=FINITE">VSG</EVENT> 59.&#13;
Bizkortze Zerbitzuko <EVENT eid="e106" class="OCCURRENCE" comment="e3c:permanence=FINITE">balorazioa</EVENT> <EVENT eid="e107" class="OCCURRENCE" comment="e3c:permanence=FINITE">eskatzen</EVENT> da eta haien Zerbitzura <EVENT eid="e108" class="OCCURRENCE" comment="e3c:permanence=FINITE">eramaten</EVENT> da gaixoa.&#13;
</TEXT>
